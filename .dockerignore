# See https://docs.docker.com/engine/reference/builder/#dockerignore-file for more about ignoring files.

# Ignore git directory.
/.git/
/.gitignore

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all default key files.
/config/master.key
/config/credentials/*.key

# Ignore credentials that .gitignore also keeps out of git: Google service-account
# keys, and Kamal secrets (the hosted edition keeps saas/ in the image).
/config/*.json
**/*.json.key
/saas/.kamal/secrets*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/*.log

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Ignore assets.
/node_modules/
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets

# Ignore CI service files.
/.github

# Ignore Kamal files.
/config/deploy*.yml
/.kamal

# Ignore development files
/.devcontainer

# Ignore private working documents. They are git-ignored, not public.
/tasks
/notes
/docs/ideas
/CONTEXT.md
/saas/DEPLOY.md
/script/hermes-review
/scratch

# Ignore local debugging and test artifacts that can hold session data.
/cookies.txt
/test_output.txt
/playwright-report
/test-results
/tmp/screenshots

# Ignore agent worktrees, which hold full copies of the repository.
/.claude
/.worktrees

# Ignore Docker-related files
/.dockerignore
/Dockerfile*
