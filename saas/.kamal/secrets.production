# Secrets for bin/kamal -d production. This file is committed, so it holds no
# values: each line reads a deployer variable named FAMILYPLATES_PRODUCTION_*,
# and nothing else. No .env file is loaded for it. To read them from a password
# manager instead, see `kamal secrets fetch`.
#
# STRIPE_PRIVATE_KEY is a live key (sk_live_ or rk_live_) and
# STRIPE_SIGNING_SECRET belongs to the live-mode webhook endpoint for
# https://familyplates.org/pay/webhooks/stripe. The app refuses to boot otherwise.

SECRET_KEY_BASE=$FAMILYPLATES_PRODUCTION_SECRET_KEY_BASE
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=$FAMILYPLATES_PRODUCTION_ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=$FAMILYPLATES_PRODUCTION_ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT
SMTP_USERNAME=$FAMILYPLATES_PRODUCTION_SMTP_USERNAME
SMTP_PASSWORD=$FAMILYPLATES_PRODUCTION_SMTP_PASSWORD
STRIPE_PRIVATE_KEY=$FAMILYPLATES_PRODUCTION_STRIPE_PRIVATE_KEY
STRIPE_SIGNING_SECRET=$FAMILYPLATES_PRODUCTION_STRIPE_SIGNING_SECRET
