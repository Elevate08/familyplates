# Secrets for the hosted deploy, read by saas/config/deploy.yml. This file is
# committed, so it holds no values: each line takes the secret from the
# deployer's environment (or .env.hosted, which is gitignored). To read them
# from a password manager instead, see `kamal secrets fetch`, e.g.
#   SECRETS=$(kamal secrets fetch --adapter 1password --account ... --from Vault/FamilyPlates SECRET_KEY_BASE ...)
#   SECRET_KEY_BASE=$(kamal secrets extract SECRET_KEY_BASE $SECRETS)

SECRET_KEY_BASE=$SECRET_KEY_BASE
