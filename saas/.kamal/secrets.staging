# Secrets for bin/kamal -d staging. This file is committed, so it holds no
# values: each line reads a deployer variable named FAMILYPLATES_STAGING_*,
# and nothing else. No .env file is loaded for it. To read them from a password
# manager instead, see `kamal secrets fetch`.
#
# STRIPE_PRIVATE_KEY is a sandbox key (sk_test_ or rk_test_) and
# STRIPE_SIGNING_SECRET belongs to the sandbox webhook endpoint for
# https://dev.familyplates.org/pay/webhooks/stripe, not production's. The app
# refuses to boot with a live key. STAGING_ACCESS_* is the sign-in that keeps
# everything but that webhook and /up closed.

SECRET_KEY_BASE=$FAMILYPLATES_STAGING_SECRET_KEY_BASE
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=$FAMILYPLATES_STAGING_ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=$FAMILYPLATES_STAGING_ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT
SMTP_USERNAME=$FAMILYPLATES_STAGING_SMTP_USERNAME
SMTP_PASSWORD=$FAMILYPLATES_STAGING_SMTP_PASSWORD
STRIPE_PRIVATE_KEY=$FAMILYPLATES_STAGING_STRIPE_PRIVATE_KEY
STRIPE_SIGNING_SECRET=$FAMILYPLATES_STAGING_STRIPE_SIGNING_SECRET
STAGING_ACCESS_USERNAME=$FAMILYPLATES_STAGING_ACCESS_USERNAME
STAGING_ACCESS_PASSWORD=$FAMILYPLATES_STAGING_ACCESS_PASSWORD
