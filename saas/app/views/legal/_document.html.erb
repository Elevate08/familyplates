<%# The shared frame for a legal page: title, effective date, readable body. %>
<article class="mx-auto max-w-3xl py-6 sm:py-10">
  <header class="mb-8 border-b border-slate-200 dark:border-slate-800 pb-6">
    <p class="text-xs font-bold uppercase tracking-wider text-primary-600 dark:text-primary-400">FamilyPlates</p>
    <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white"><%= title %></h1>
    <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">Effective <%= Legal.effective_date %></p>
  </header>

  <div class="text-sm leading-7 text-slate-700 dark:text-slate-300
              [&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:text-lg [&_h2]:font-bold [&_h2]:text-slate-900 dark:[&_h2]:text-white
              [&_p]:mt-3 [&_ul]:mt-3 [&_ul]:list-disc [&_ul]:pl-6 [&_li]:mt-1.5
              [&_a]:font-semibold [&_a]:text-primary-600 dark:[&_a]:text-primary-400 [&_a:hover]:underline
              [&_strong]:text-slate-900 dark:[&_strong]:text-white">
    <%= yield %>
  </div>

  <footer class="mt-12 border-t border-slate-200 dark:border-slate-800 pt-6 text-xs text-slate-500 dark:text-slate-400">
    See also:
    <%= link_to "Terms of Service", terms_path %> ·
    <%= link_to "Privacy Policy", privacy_path %>
  </footer>
</article>
