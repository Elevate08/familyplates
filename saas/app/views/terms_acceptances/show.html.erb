<% content_for :title, "Terms of Service | FamilyPlates" %>
<% enforcement_at = TermsNotice.enforcement_at_for(current_user) %>
<% changed = TermsAssent.pending_change?(current_user) %>

<%= render layout: "shared/centered_page" do %>
  <%= render layout: "shared/auth_card" do %>
    <h1 class="text-2xl font-extrabold text-slate-900 dark:text-white tracking-tight">
      <%= changed ? "The Terms of Service have changed" : "Accept the Terms of Service" %>
    </h1>

    <div class="mt-3 space-y-2 text-sm text-slate-600 dark:text-slate-400" data-testid="terms-acceptance-status">
      <% if changed %>
        <p>You agreed to version <%= current_user.terms_version %>. The current version is <%= TermsAssent.current_version %>.</p>
        <% if enforcement_at && enforcement_at > Time.current %>
          <p>You can keep using FamilyPlates until <%= enforcement_at.utc.to_formatted_s(:long) %> UTC. After that you will need to accept the new version.</p>
        <% else %>
          <p>Please accept the new version to keep using your household.</p>
        <% end %>
      <% else %>
        <p>Before using a household, please accept the Terms of Service for yourself. Signing in does not accept them.</p>
      <% end %>
    </div>

    <% if Current.session&.kiosk? %>
      <p class="mt-5 text-sm font-semibold text-slate-700 dark:text-slate-300"><%= TermsAcceptancesController::KIOSK_NOTICE %></p>
    <% else %>
      <%= form_with url: terms_acceptance_path, method: :post, local: true, class: "mt-5 space-y-4" do |f| %>
        <%= hidden_field_tag :terms_version, TermsAssent.current_version, id: nil %>
        <label class="flex items-start gap-2.5 text-xs leading-5 text-slate-600 dark:text-slate-400 cursor-pointer">
          <%= check_box_tag :accept_terms, "1", false, required: true,
                class: "mt-0.5 h-4 w-4 shrink-0 rounded border-slate-300 dark:border-slate-600 accent-primary-600" %>
          <span>
            I am 18 or older, live in the United States, and agree to the
            <%= link_to "Terms of Service", terms_path, target: "_blank", class: "font-semibold text-primary-600 dark:text-primary-400 hover:underline" %>.
            I have read the
            <%= link_to "Privacy Policy", privacy_path, target: "_blank", class: "font-semibold text-primary-600 dark:text-primary-400 hover:underline" %>.
          </span>
        </label>
        <%= f.submit "Accept and continue",
              class: "w-full py-3 rounded-xl bg-primary-600 hover:bg-primary-500 text-white font-bold text-sm shadow-md transition-all cursor-pointer" %>
      <% end %>
    <% end %>

    <% if changed && !Current.session&.kiosk? %>
      <%# Declining is not cancelling or deleting: each is a separate request. Only
          the billing owner can be refunded. Draft wording: not reviewed by an attorney. %>
      <section aria-label="If you decline" data-testid="terms-decline" class="mt-5 text-xs leading-5 text-slate-600 dark:text-slate-400">
        <% support = mail_to(BillingOffer::SUPPORT_EMAIL, class: "font-semibold text-primary-600 dark:text-primary-400 hover:underline") %>
        <% if household_billing_owner_session? %>
          <p>If you decline the updated Terms, you can email <%= support %> to request an adjusted refund for unused prepaid service.</p>
          <p class="mt-1">
            You can also <%= link_to "cancel your subscription", subscription_path, class: "font-semibold text-primary-600 dark:text-primary-400 hover:underline" %>
            yourself, or email us to ask for your account to be deleted.
          </p>
        <% else %>
          <p>If you decline the updated Terms, you can email <%= support %> to ask for your account to be deleted.</p>
        <% end %>
      </section>
    <% end %>

    <nav class="mt-6 flex flex-wrap justify-center gap-x-4 gap-y-2 text-xs font-medium text-slate-500 dark:text-slate-400" aria-label="Without accepting">
      <%= link_to "Terms of Service", terms_path, class: "hover:underline" %>
      <%= link_to "Privacy Policy", privacy_path, class: "hover:underline" %>
      <% if current_family_member %>
        <%= link_to "Contact support", support_threads_path, class: "hover:underline" %>
        <%= link_to "Subscription & cancellation", subscription_path, class: "hover:underline" %>
      <% end %>
      <%= button_to "Sign out", session_path, method: :delete, form_class: "inline", class: "hover:underline cursor-pointer" %>
    </nav>
  <% end %>
<% end %>
