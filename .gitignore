# Ignore bundler config.
/.bundle

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage
/storage/*
!/storage/.keep
/public/assets

# Ignore master key for decrypting credentials and more.
config/master.key
config/google_service_account.json
config/*.json
*.json.key

# Ignore local environment files with secrets
.env
.env.*
!.env.example

# Ignore SQLite databases.
/db/*.sqlite3
/db/*.sqlite3-journal
/db/*.sqlite3-shm
/db/*.sqlite3-wal

# Ignore yarn / node_modules
/node_modules
/public/packs
/public/packs-test

# Ignore local scratchpads and raw notes
/notes/*
!/notes/.keep
/scratch/*
!/scratch/.keep
.notes/

# Ignore local debugging and test artifacts that can hold session data.
# A curl cookie jar will hold a live session cookie if the request that wrote it
# had one. The jar a reviewer found world-readable in a working copy turned out
# to be empty - three header lines and nothing else - but the next one need not
# be, and it was not ignored on the branch it sat on.
/cookies.txt
/test_output.txt
/*.log

# System test failure screenshots
tmp/screenshots/

# Ignore system artifacts
.DS_Store
*.swp
*~
.claude/
