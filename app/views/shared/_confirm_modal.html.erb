<div id="app-confirm-modal" class="hidden fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4 min-h-screen overflow-y-auto">
  <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-6 sm:p-8 max-w-sm w-full shadow-2xl animate-in fade-in zoom-in-95 my-auto text-center text-slate-900 dark:text-slate-100">
    <div class="text-center mb-5">
      <div id="app-confirm-icon-badge" class="w-14 h-14 rounded-2xl flex items-center justify-center text-white text-2xl font-extrabold shadow-md mx-auto mb-3 transition-colors"
           style="background-color: var(--user-accent, #ea580c); box-shadow: 0 4px 14px color-mix(in srgb, var(--user-accent, #ea580c) 40%, transparent);">
        <span id="app-confirm-icon">⚠️</span>
      </div>
      <h3 class="text-lg font-extrabold text-slate-900 dark:text-white" id="app-confirm-title">Are You Sure?</h3>
      <p class="text-xs text-slate-600 dark:text-slate-400 mt-1.5 leading-relaxed" id="app-confirm-message">Are you sure you want to proceed with this action?</p>
    </div>

    <div class="flex items-center gap-3">
      <button type="button" id="app-confirm-cancel" class="w-1/2 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 text-xs font-bold text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 cursor-pointer transition-colors">
        Cancel
      </button>
      <button type="button" id="app-confirm-submit" class="w-1/2 py-2.5 rounded-xl text-white text-xs font-bold shadow-md cursor-pointer transition-all hover:brightness-110"
              style="background-color: var(--user-accent, #ea580c); box-shadow: 0 4px 14px color-mix(in srgb, var(--user-accent, #ea580c) 40%, transparent);">
        Confirm
      </button>
    </div>
  </div>
</div>
