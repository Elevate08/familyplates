const CACHE_NAME = "familyplates-v3";

// Only these pages work offline: the grocery list, recipes and the meal plan.
// Nothing else is kept (no operator console, account data, billing, support,
// preferences, sign-in, pairing or devices pages), because a cached page is
// shown to whoever opens this browser next. Forms (/recipes/new, .../edit) stay out too.
const OFFLINE_PAGES = [
  /^\/grocery_list(\/(\d+|current))?$/,
  /^\/recipes(\/\d+(\/cook)?)?$/,
  /^\/meal_plans(\/\d+(\/print)?)?$/
];

// Static files that carry no household data.
const STATIC_PATHS = ["/icon.png", "/icon.svg", "/favicon.ico", "/manifest.json"];
const PRECACHE_URLS = ["/icon.png", "/icon.svg", "/favicon.ico"];

function isOfflinePage(pathname) {
  return OFFLINE_PAGES.some((pattern) => pattern.test(pathname));
}

function isStaticAsset(pathname) {
  return pathname.startsWith("/assets/") || STATIC_PATHS.includes(pathname);
}

// Shown when a page that is not available offline is opened without a connection.
function offlineResponse() {
  const body = "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\">" +
    "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">" +
    "<title>Offline - FamilyPlates</title></head>" +
    "<body style=\"font-family: system-ui, sans-serif; max-width: 32rem; margin: 3rem auto; padding: 0 1rem;\">" +
    "<h1>You are offline</h1>" +
    "<p>This page is not available offline. Only these pages work without a connection:</p>" +
    "<ul><li><a href=\"/grocery_list\">Grocery list</a></li>" +
    "<li><a href=\"/recipes\">Recipes</a></li>" +
    "<li><a href=\"/meal_plans\">Meal plan</a></li></ul>" +
    "<p>Pages you have not opened yet are not saved on this device.</p>" +
    "</body></html>";
  return new Response(body, {
    status: 503,
    headers: { "Content-Type": "text/html; charset=utf-8", "Cache-Control": "no-store" }
  });
}

// Install: Cache the icons only; offline pages are saved as they are visited
self.addEventListener("install", (event) => {
  event.waitUntil(
    caches.open(CACHE_NAME).then((cache) => {
      return cache.addAll(PRECACHE_URLS).catch((err) => {
        console.warn("ServiceWorker pre-caching partial failure", err);
      });
    }).then(() => self.skipWaiting())
  );
});

// Activate: Clean up older cache versions
self.addEventListener("activate", (event) => {
  event.waitUntil(
    caches.keys().then((keys) => {
      return Promise.all(
        keys.map((key) => {
          if (key !== CACHE_NAME) {
            return caches.delete(key);
          }
        })
      );
    }).then(() => self.clients.claim())
  );
});

// Fetch: Network-First with Cache Fallback for the offline pages, Stale-While-Revalidate for static assets,
// and straight to the network (never cached) for everything else
self.addEventListener("fetch", (event) => {
  const request = event.request;

  // Only intercept GET requests
  if (request.method !== "GET") return;

  const url = new URL(request.url);

  // Only intercept same-origin requests (allow browser to handle external images/CDNs natively)
  if (url.origin !== self.location.origin) return;

  // For HTML page navigations
  if (request.mode === "navigate" || request.headers.get("accept")?.includes("text/html")) {
    if (isOfflinePage(url.pathname)) {
      // Network-first, fallback to cache
      event.respondWith(
        fetch(request)
          .then((response) => {
            // A redirect (for example to sign-in) is somebody else's page, not this one
            if (response.status === 200 && !response.redirected) {
              const keep = [[request, response.clone()]];
              // /meal_plans only redirects to the plan, so the plan seen last also answers it offline
              if (/^\/meal_plans\/\d+$/.test(url.pathname)) keep.push(["/meal_plans", response.clone()]);
              caches.open(CACHE_NAME).then((cache) => keep.forEach(([key, copy]) => cache.put(key, copy)));
            }
            return response;
          })
          .catch(async () => {
            const cached = await caches.match(request, { ignoreVary: true });
            return cached || offlineResponse();
          })
      );
    } else {
      // Not an offline page: never cache it, and never answer with another cached page
      event.respondWith(fetch(request).catch(() => offlineResponse()));
    }
    return;
  }

  // Anything else that is not a static asset (exports, calendar feeds, uploaded files): leave it to the network
  if (!isStaticAsset(url.pathname)) return;

  // For same-origin static assets (CSS, JS, icons): Stale-While-Revalidate
  event.respondWith(
    caches.match(request).then((cachedResponse) => {
      const networkFetch = fetch(request).then((networkResponse) => {
        if (networkResponse.status === 200) {
          const copy = networkResponse.clone();
          caches.open(CACHE_NAME).then((cache) => cache.put(request, copy));
        }
        return networkResponse;
      });

      if (cachedResponse) {
        networkFetch.catch(() => {});
        return cachedResponse;
      }

      return networkFetch;
    })
  );
});
