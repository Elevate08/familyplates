<% household = current_household || @meal_plan&.household %>
<% if household.present? %>
  <% all_feed_url = calendar_feed_url(token: household.calendar_feed_token, format: :ics) %>
  <% all_webcal_url = all_feed_url.sub(/\Ahttps?:\/\//, "webcal://") %>
  <% all_gcal_url = "https://calendar.google.com/calendar/r?cid=#{CGI.escape(all_webcal_url)}" %>

  <% if current_family_member.present? %>
    <% member_feed_url = calendar_member_feed_url(token: household.calendar_feed_token, member_id: current_family_member.id, format: :ics) %>
    <% member_webcal_url = member_feed_url.sub(/\Ahttps?:\/\//, "webcal://") %>
    <% member_gcal_url = "https://calendar.google.com/calendar/r?cid=#{CGI.escape(member_webcal_url)}" %>
  <% end %>

  <% instance_id = SecureRandom.hex(4) %>

  <div data-controller="modal calendar-subscribe" data-action="keydown.esc@window->modal#handleKeydown">
    <!-- Trigger Button (Desktop & Mobile) -->
    <button type="button" 
            data-action="click->modal#open"
            class="px-3 py-2 sm:px-3.5 sm:py-2.5 rounded-2xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white border border-slate-200/80 dark:border-slate-700 shadow-2xs transition-all flex items-center gap-1.5 cursor-pointer group"
            title="Subscribe to Calendar (Apple, Google, Outlook)"
            aria-label="Subscribe to Calendar">
      <%= icon_tag("calendar", css_class: "w-4 h-4 text-primary-600 dark:text-primary-400 group-hover:scale-105 transition-transform") %>
      <span class="text-xs font-bold hidden sm:inline">Sync Calendar</span>
    </button>

    <!-- Modal Dialog Backdrop -->
    <div data-modal-target="dialog" class="hidden fixed inset-0 z-50 items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs animate-in fade-in duration-150 overflow-y-auto">
      <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 sm:p-8 max-w-lg w-full shadow-2xl border border-slate-100 dark:border-slate-800 text-left animate-in zoom-in-95 duration-150 space-y-6 my-8">
        
        <!-- Modal Header -->
        <div class="flex items-start justify-between gap-4">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-2xl bg-primary-50 dark:bg-primary-950/60 text-primary-600 dark:text-primary-400 flex items-center justify-center shadow-xs shrink-0">
              <%= icon_tag("calendar", css_class: "w-6 h-6") %>
            </div>
            <div>
              <h3 class="text-lg sm:text-xl font-extrabold text-slate-900 dark:text-white">Subscribe to Calendar</h3>
              <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Live meal schedule synced to your phone or computer</p>
            </div>
          </div>
          <button type="button" data-action="click->modal#close" class="p-2 rounded-xl text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>

        <% if current_family_member.present? %>
          <!-- Feed Scope Selector Tabs -->
          <div class="flex items-center bg-slate-100 dark:bg-slate-800 p-1 rounded-2xl border border-slate-200/80 dark:border-slate-700">
            <button type="button"
                    data-calendar-subscribe-target="tabAll"
                    data-action="click->calendar-subscribe#showAll"
                    class="flex-1 py-1.5 px-3 rounded-xl text-xs font-bold transition-all bg-white dark:bg-slate-700 text-primary-600 dark:text-primary-400 shadow-xs cursor-pointer">
              🍽️ All Household Meals
            </button>
            <button type="button"
                    data-calendar-subscribe-target="tabMember"
                    data-action="click->calendar-subscribe#showMember"
                    class="flex-1 py-1.5 px-3 rounded-xl text-xs font-bold transition-all text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white cursor-pointer">
              👨‍🍳 <%= current_family_member.name %>'s Cooking
            </button>
          </div>
        <% end %>

        <!-- PANEL 1: ALL HOUSEHOLD MEALS -->
        <div data-calendar-subscribe-target="panelAll" class="space-y-5">
          <!-- 1-Click Platform Buttons -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <a href="<%= all_webcal_url %>" 
               class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/80 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200/70 dark:border-slate-700 flex items-center gap-3 transition-all hover:scale-[1.02] shadow-2xs group">
              <div class="w-10 h-10 rounded-xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 flex items-center justify-center font-bold text-lg shrink-0">
                
              </div>
              <div class="min-w-0">
                <span class="block text-xs font-bold text-slate-900 dark:text-white">Apple Calendar</span>
                <span class="block text-[11px] text-slate-500 dark:text-slate-400">1-Tap Subscribe</span>
              </div>
            </a>

            <a href="<%= all_gcal_url %>" target="_blank" rel="noopener noreferrer"
               class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/80 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200/70 dark:border-slate-700 flex items-center gap-3 transition-all hover:scale-[1.02] shadow-2xs group">
              <div class="w-10 h-10 rounded-xl bg-blue-600 text-white flex items-center justify-center font-bold text-base shrink-0">
                G
              </div>
              <div class="min-w-0">
                <span class="block text-xs font-bold text-slate-900 dark:text-white">Google Calendar</span>
                <span class="block text-[11px] text-slate-500 dark:text-slate-400">Add via Web</span>
              </div>
            </a>
          </div>

          <!-- Feed URL Copy Box -->
          <div data-controller="clipboard" class="space-y-1.5">
            <label for="all_feed_url_<%= instance_id %>" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
              Universal Feed URL (.ics)
            </label>
            <div class="flex items-center gap-2">
              <input type="text" readonly
                     id="all_feed_url_<%= instance_id %>"
                     name="all_feed_url_<%= instance_id %>"
                     data-clipboard-target="source"
                     value="<%= all_feed_url %>"
                     class="w-full text-xs font-mono px-3 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-200 select-all focus:outline-none focus:ring-2 focus:ring-primary-500">
              <button type="button" data-action="click->clipboard#copy"
                      class="px-4 py-2.5 rounded-xl bg-primary-600 hover:bg-primary-500 text-white text-xs font-bold transition-colors cursor-pointer shrink-0 shadow-xs flex items-center gap-1.5">
                <%= icon_tag("copy", css_class: "w-3.5 h-3.5") %>
                <span data-clipboard-target="feedback">Copy</span>
              </button>
            </div>
            <p class="text-[11px] text-slate-400 dark:text-slate-500">
              Compatible with Microsoft Outlook, Thunderbird, Fastmail, or any calendar reader.
            </p>
          </div>

          <!-- Mobile Scan QR Code -->
          <div class="p-3 bg-slate-50 dark:bg-slate-800/50 rounded-2xl border border-slate-200/60 dark:border-slate-700 flex items-center gap-3.5">
            <div class="bg-white p-1.5 rounded-xl shrink-0 shadow-2xs">
              <%= qr_code_svg(all_webcal_url, size: 2) %>
            </div>
            <div class="min-w-0">
              <span class="block text-xs font-bold text-slate-800 dark:text-slate-200">Scan to Subscribe on Mobile</span>
              <span class="block text-[11px] text-slate-500 dark:text-slate-400">Open your phone camera to subscribe directly in your mobile calendar.</span>
            </div>
          </div>
        </div>

        <% if current_family_member.present? %>
          <!-- PANEL 2: MEMBER-FILTERED MEALS -->
          <div data-calendar-subscribe-target="panelMember" class="hidden space-y-5">
            <!-- 1-Click Platform Buttons -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <a href="<%= member_webcal_url %>" 
                 class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/80 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200/70 dark:border-slate-700 flex items-center gap-3 transition-all hover:scale-[1.02] shadow-2xs group">
                <div class="w-10 h-10 rounded-xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 flex items-center justify-center font-bold text-lg shrink-0">
                  
                </div>
                <div class="min-w-0">
                  <span class="block text-xs font-bold text-slate-900 dark:text-white">Apple Calendar</span>
                  <span class="block text-[11px] text-slate-500 dark:text-slate-400">My Cooking Nights Only</span>
                </div>
              </a>

              <a href="<%= member_gcal_url %>" target="_blank" rel="noopener noreferrer"
                 class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/80 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200/70 dark:border-slate-700 flex items-center gap-3 transition-all hover:scale-[1.02] shadow-2xs group">
                <div class="w-10 h-10 rounded-xl bg-blue-600 text-white flex items-center justify-center font-bold text-base shrink-0">
                  G
                </div>
                <div class="min-w-0">
                  <span class="block text-xs font-bold text-slate-900 dark:text-white">Google Calendar</span>
                  <span class="block text-[11px] text-slate-500 dark:text-slate-400">My Cooking Nights Only</span>
                </div>
              </a>
            </div>

            <!-- Feed URL Copy Box -->
            <div data-controller="clipboard" class="space-y-1.5">
              <label for="member_feed_url_<%= instance_id %>" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                Personalized Feed URL (.ics)
              </label>
              <div class="flex items-center gap-2">
                <input type="text" readonly
                       id="member_feed_url_<%= instance_id %>"
                       name="member_feed_url_<%= instance_id %>"
                       data-clipboard-target="source"
                       value="<%= member_feed_url %>"
                       class="w-full text-xs font-mono px-3 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-200 select-all focus:outline-none focus:ring-2 focus:ring-primary-500">
                <button type="button" data-action="click->clipboard#copy"
                        class="px-4 py-2.5 rounded-xl bg-primary-600 hover:bg-primary-500 text-white text-xs font-bold transition-colors cursor-pointer shrink-0 shadow-xs flex items-center gap-1.5">
                  <%= icon_tag("copy", css_class: "w-3.5 h-3.5") %>
                  <span data-clipboard-target="feedback">Copy</span>
                </button>
              </div>
              <p class="text-[11px] text-slate-400 dark:text-slate-500">
                Only includes dinners, lunches, and breakfasts where <%= current_family_member.name %> is the assigned cook.
              </p>
            </div>

            <!-- Mobile Scan QR Code -->
            <div class="p-3 bg-slate-50 dark:bg-slate-800/50 rounded-2xl border border-slate-200/60 dark:border-slate-700 flex items-center gap-3.5">
              <div class="bg-white p-1.5 rounded-xl shrink-0 shadow-2xs">
                <%= qr_code_svg(member_webcal_url, size: 2) %>
              </div>
              <div class="min-w-0">
                <span class="block text-xs font-bold text-slate-800 dark:text-slate-200">Scan <%= current_family_member.name %>'s Schedule</span>
                <span class="block text-[11px] text-slate-500 dark:text-slate-400">Scan to subscribe to your personal cooking assignments.</span>
              </div>
            </div>
          </div>
        <% end %>

        <!-- Modal Footer -->
        <div class="flex items-center justify-between pt-2 border-t border-slate-100 dark:border-slate-800">
          <% if current_family_member&.admin? %>
            <%= link_to edit_admin_calendar_path, class: "text-xs font-semibold text-primary-600 dark:text-primary-400 hover:underline" do %>
              ⚙️ Calendar Settings
            <% end %>
          <% else %>
            <span></span>
          <% end %>

          <button type="button" data-action="click->modal#close" 
                  class="px-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 text-xs font-bold transition-colors cursor-pointer">
            Done
          </button>
        </div>

      </div>
    </div>
  </div>
<% end %>
