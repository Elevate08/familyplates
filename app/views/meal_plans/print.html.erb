<style>
  @media print {
    @page {
      size: letter landscape;
      margin: 0.3in;
    }
    body {
      background: white !important;
      color: #0f172a !important;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
      padding: 0 !important;
      margin: 0 !important;
    }
    .no-print {
      display: none !important;
    }
    .print-page-container {
      border: 3px solid #0f172a !important;
      border-radius: 1rem !important;
      padding: 0.6rem 0.8rem !important;
      box-shadow: none !important;
      width: 100% !important;
      height: auto !important;
      max-height: 100% !important;
      page-break-inside: avoid !important;
      page-break-after: avoid !important;
      display: flex !important;
      flex-direction: column !important;
      justify-content: flex-start !important;
    }
  }
</style>

<!-- Non-print action bar -->
<div class="no-print mb-6 flex flex-col sm:flex-row items-center justify-between gap-4 p-4 bg-primary-50 border border-primary-200 rounded-2xl shadow-xs">
  <div class="flex items-center gap-3">
    <span class="text-primary-600"><%= icon_tag("printer", css_class: "w-6 h-6") %></span>
    <div>
      <h3 class="font-bold text-slate-900 text-sm">Fridge Print Preview (<%= @view == "month" ? "Monthly Landscape Calendar" : "Weekly Landscape Table" %>)</h3>
      <p class="text-xs text-slate-500">Optimized for standard 8.5x11 landscape refrigerator sheet.</p>
    </div>
  </div>

  <div class="flex items-center gap-2.5">
    <!-- View switcher in print preview -->
    <div class="flex items-center bg-white p-1 rounded-xl border border-slate-200">
      <%= link_to "Weekly Table", print_meal_plan_path(@meal_plan, view: "week"), 
            class: "px-3 py-1 rounded-lg text-xs font-bold transition-colors #{@view == 'week' ? 'bg-slate-900 text-white' : 'text-slate-600 hover:text-slate-900'}" %>
      <%= link_to "Monthly Calendar", print_meal_plan_path(@meal_plan, view: "month", month: params[:month]), 
            class: "px-3 py-1 rounded-lg text-xs font-bold transition-colors #{@view == 'month' ? 'bg-slate-900 text-white' : 'text-slate-600 hover:text-slate-900'}" %>
    </div>

    <%= link_to "← Back to Planner", meal_plan_path(@meal_plan, view: @view, month: params[:month]), class: "px-3.5 py-1.5 rounded-xl bg-white border border-slate-200 text-xs font-semibold text-slate-700 hover:bg-slate-50" %>
    <button onclick="window.print()" class="px-5 py-2 rounded-xl bg-primary-600 hover:bg-primary-500 text-white font-bold text-xs shadow-sm cursor-pointer transition-all flex items-center gap-1.5">
      <%= icon_tag("printer", css_class: "w-4 h-4") %>
      <span>Print Refrigerator Sheet</span>
    </button>
  </div>
</div>

<% if @view == "month" %>
  <!-- FULL MONTH FRIDGE CALENDAR (Landscape 1-Page Matrix) -->
  <div class="print-page-container border-4 border-slate-900 rounded-3xl p-5 bg-white flex flex-col justify-start h-full">
    <!-- Centered Month/Year Header (Clean & space-maximized) -->
    <div class="border-b-2 border-slate-900 pb-2 mb-2 text-center">
      <h1 class="text-3xl font-black text-slate-900 tracking-tight uppercase">
        <%= @month_date.strftime("%B %Y") %>
      </h1>
    </div>

    <!-- Day Headers -->
    <div class="grid grid-cols-7 gap-1.5 pb-1 text-center border-b border-slate-300 mb-1">
      <% %w[Monday Tuesday Wednesday Thursday Friday Saturday Sunday].each do |dname| %>
        <div class="text-[11px] font-black uppercase tracking-wider text-slate-800"><%= dname %></div>
      <% end %>
    </div>

    <!-- Month Grid Rows -->
    <div class="grid grid-cols-7 gap-1.5 flex-1 my-auto">
      <% @leading_blank_days.to_i.times do %>
        <div class="border-2 border-dashed border-slate-200 rounded-xl p-1 bg-slate-50/20 min-h-[74px]"></div>
      <% end %>

      <% @month_days.each do |day| %>
        <% is_today = (day == Date.current) %>
        <% b_slot = @month_slots_by_date[[day, "breakfast"]]&.first %>
        <% l_slot = @month_slots_by_date[[day, "lunch"]]&.first %>
        <% d_slot = @month_slots_by_date[[day, "dinner"]]&.first %>

        <div class="border-2 border-slate-900 bg-white rounded-xl p-1.5 flex flex-col justify-between min-h-[74px]">
          <!-- Date Number -->
          <div class="flex items-center justify-between pb-0.5">
            <span class="text-xs font-black text-slate-900"><%= day.strftime("%-d") %></span>
          </div>

          <!-- Spelled out Meals (Breakfast, Lunch, Dinner with light grey divider bars) -->
          <div class="space-y-1 flex-1 justify-between flex flex-col py-0.5">
            <!-- Breakfast -->
            <div class="text-[9.5px] leading-tight break-words text-center <%= b_slot ? 'text-slate-900' : 'text-slate-300' %>">
              <div class="font-black text-slate-900 uppercase text-[9px] tracking-wider text-center">Breakfast</div>
              <% if b_slot&.display_title.present? && b_slot.display_title != "No Meal Planned" %>
                <div class="font-bold text-slate-900 mt-0.5 text-center"><%= b_slot.display_title %></div>
                <% if b_slot.family_member || (b_slot.recipe && b_slot.recipe.total_time.to_i > 0) %>
                  <div class="text-[8.5px] text-slate-600 font-medium flex items-center justify-center flex-wrap gap-x-1.5 mt-0.5">
                    <% if b_slot.family_member %>
                      <span><span class="text-blue-700 font-extrabold">Cook:</span> <strong class="text-slate-900"><%= b_slot.family_member.name %></strong></span>
                    <% end %>
                    <% if b_slot.recipe && b_slot.recipe.total_time.to_i > 0 %>
                      <span><span class="text-amber-700 font-extrabold">Time:</span> <strong class="text-slate-900"><%= b_slot.recipe.total_time %> mins</strong></span>
                    <% end %>
                  </div>
                <% end %>
              <% else %>
                <div class="text-slate-300 italic mt-0.5 text-center">—</div>
              <% end %>
            </div>

            <!-- Light Grey Separator Bar -->
            <hr class="border-t border-slate-300 my-0.5 w-full shrink-0 block" />

            <!-- Lunch -->
            <div class="text-[9.5px] leading-tight break-words text-center <%= l_slot ? 'text-slate-900' : 'text-slate-300' %>">
              <div class="font-black text-slate-900 uppercase text-[9px] tracking-wider text-center">Lunch</div>
              <% if l_slot&.display_title.present? && l_slot.display_title != "No Meal Planned" %>
                <div class="font-bold text-slate-900 mt-0.5 text-center"><%= l_slot.display_title %></div>
                <% if l_slot.family_member || (l_slot.recipe && l_slot.recipe.total_time.to_i > 0) %>
                  <div class="text-[8.5px] text-slate-600 font-medium flex items-center justify-center flex-wrap gap-x-1.5 mt-0.5">
                    <% if l_slot.family_member %>
                      <span><span class="text-blue-700 font-extrabold">Cook:</span> <strong class="text-slate-900"><%= l_slot.family_member.name %></strong></span>
                    <% end %>
                    <% if l_slot.recipe && l_slot.recipe.total_time.to_i > 0 %>
                      <span><span class="text-amber-700 font-extrabold">Time:</span> <strong class="text-slate-900"><%= l_slot.recipe.total_time %> mins</strong></span>
                    <% end %>
                  </div>
                <% end %>
              <% else %>
                <div class="text-slate-300 italic mt-0.5 text-center">—</div>
              <% end %>
            </div>

            <!-- Light Grey Separator Bar -->
            <hr class="border-t border-slate-300 my-0.5 w-full shrink-0 block" />

            <!-- Dinner -->
            <div class="text-[9.5px] leading-tight break-words text-center <%= d_slot ? 'text-slate-900' : 'text-slate-300' %>">
              <div class="font-black text-slate-900 uppercase text-[9px] tracking-wider text-center">Dinner</div>
              <% if d_slot&.display_title.present? && d_slot.display_title != "No Meal Planned" %>
                <div class="font-bold text-slate-900 mt-0.5 text-center"><%= d_slot.display_title %></div>
                <% if d_slot.family_member || (d_slot.recipe && d_slot.recipe.total_time.to_i > 0) %>
                  <div class="text-[8.5px] text-slate-600 font-medium flex items-center justify-center flex-wrap gap-x-1.5 mt-0.5">
                    <% if d_slot.family_member %>
                      <span><span class="text-blue-700 font-extrabold">Cook:</span> <strong class="text-slate-900"><%= d_slot.family_member.name %></strong></span>
                    <% end %>
                    <% if d_slot.recipe && d_slot.recipe.total_time.to_i > 0 %>
                      <span><span class="text-amber-700 font-extrabold">Time:</span> <strong class="text-slate-900"><%= d_slot.recipe.total_time %> mins</strong></span>
                    <% end %>
                  </div>
                <% end %>
              <% else %>
                <div class="text-slate-300 italic mt-0.5 text-center">—</div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

<% else %>
  <!-- 7-DAY WEEKLY FRIDGE TABLE (Flipped: Days as Columns, Meals as Rows - Shifted to Top for Clean Cutting) -->
  <div class="print-page-container border-4 border-slate-900 rounded-3xl p-5 bg-white flex flex-col justify-start">
    <!-- Centered Week Header (Clean & space-maximized) -->
    <div class="border-b-2 border-slate-900 pb-2 mb-3 text-center">
      <h1 class="text-3xl font-black text-slate-900 tracking-tight uppercase">
        <%= @meal_plan.week_label %>
      </h1>
    </div>

    <!-- Flipped Matrix Table with Rounded Corners -->
    <div class="rounded-2xl overflow-hidden border-2 border-slate-900 bg-white">
      <table class="w-full border-collapse table-fixed bg-white">
        <thead>
          <tr class="border-b-2 border-slate-900 bg-white">
            <th class="w-24 p-2 text-left text-xs font-black uppercase tracking-wider text-slate-500 border-r-2 border-slate-900">
              Meal
            </th>
            <% @meal_plan.days.each do |day| %>
              <th class="p-2 text-center border-r-2 border-slate-900 last:border-r-0">
                <div class="text-xs font-black uppercase tracking-wider text-slate-900"><%= day.strftime("%a") %></div>
                <div class="text-[11px] font-bold text-slate-500 mt-0.5"><%= day.strftime("%b %-d") %></div>
              </th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% %w[breakfast lunch dinner].each do |meal_type| %>
            <tr class="border-b-2 border-slate-900 last:border-b-0">
              <th class="p-2.5 text-left border-r-2 border-slate-900 bg-white font-black uppercase text-xs tracking-wider text-slate-900 align-middle">
                <%= meal_type.capitalize %>
              </th>
              <% @meal_plan.days.each do |day| %>
                <% slot = @meal_plan.slot_for(day, meal_type) %>
                <td class="p-2 border-r-2 border-slate-900 last:border-r-0 align-top bg-white">
                  <% if slot&.display_title.present? && slot.display_title != "No Meal Planned" %>
                    <div class="flex flex-col justify-between h-full min-h-[75px]">
                      <div class="font-extrabold text-slate-900 text-xs sm:text-sm leading-snug break-words">
                        <%= slot.display_title %>
                      </div>
                      <% if slot.family_member || (slot.recipe && slot.recipe.total_time.to_i > 0) || slot.notes.present? %>
                        <div class="mt-2 pt-1 border-t border-slate-200 text-[9.5px] text-slate-600 font-medium flex flex-col gap-0.5">
                          <% if slot.family_member %>
                            <div><span class="text-blue-700 font-extrabold">Cook:</span> <strong class="text-slate-900"><%= slot.family_member.name %></strong></div>
                          <% end %>
                          <% if slot.recipe && slot.recipe.total_time.to_i > 0 %>
                            <div><span class="text-amber-700 font-extrabold">Time:</span> <strong class="text-slate-900"><%= slot.recipe.total_time %> mins</strong></div>
                          <% end %>
                          <% if slot.notes.present? %>
                            <div class="italic text-slate-500">(<%= slot.notes %>)</div>
                          <% end %>
                        </div>
                      <% end %>
                    </div>
                  <% else %>
                    <div class="h-full min-h-[75px] flex items-center justify-center text-[10px] text-slate-300 italic">
                      —
                    </div>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
