<!-- Non-print action bar -->
<div class="no-print mb-6 flex items-center justify-between p-4 bg-orange-50 border border-orange-200 rounded-2xl">
  <div class="flex items-center gap-3">
    <span class="text-orange-600"><%= icon_tag("printer", css_class: "w-6 h-6") %></span>
    <div>
      <h3 class="font-bold text-slate-900 text-sm">Fridge Print Preview (<%= @view == "month" ? "Monthly Calendar" : "Weekly Schedule" %>)</h3>
      <p class="text-xs text-slate-500">Formatted to fit on a single 8.5x11 sheet of paper.</p>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <%= link_to "← Back to Planner", meal_plan_path(@meal_plan, view: @view, month: params[:month]), class: "px-4 py-2 rounded-xl bg-white border border-slate-200 text-xs font-semibold text-slate-700 hover:bg-slate-50" %>
    <button onclick="window.print()" class="px-5 py-2 rounded-xl bg-orange-600 hover:bg-orange-500 text-white font-bold text-xs shadow-sm cursor-pointer transition-all">
      Print Refrigerator Sheet 🖨️
    </button>
  </div>
</div>

<% if @view == "month" %>
  <!-- FULL MONTH FRIDGE CALENDAR (1-Page) -->
  <div class="border-4 border-slate-900 rounded-3xl p-6 bg-white flex flex-col justify-between h-full">
    <!-- Header -->
    <div class="flex items-center justify-between border-b-2 border-slate-900 pb-3 mb-3">
      <div>
        <div class="text-[10px] font-black uppercase tracking-widest text-slate-500">Monthly Kitchen Calendar</div>
        <h1 class="text-2xl font-black text-slate-900 tracking-tight">
          <%= @meal_plan.household.name %>
        </h1>
      </div>

      <div class="text-right">
        <div class="text-lg font-black text-slate-900">
          <%= @month_date.strftime("%B %Y") %>
        </div>
        <div class="text-[10px] font-semibold text-slate-500">
          TableCraft Family Plan
        </div>
      </div>
    </div>

    <!-- Day Headers -->
    <div class="grid grid-cols-7 gap-1 pb-1 text-center border-b border-slate-300 mb-1.5">
      <% %w[Mon Tue Wed Thu Fri Sat Sun].each do |dname| %>
        <div class="text-[11px] font-black uppercase tracking-wider text-slate-700"><%= dname %></div>
      <% end %>
    </div>

    <!-- Month Grid Rows -->
    <div class="grid grid-cols-7 gap-1.5 flex-1 my-auto">
      <% @month_days.each do |day| %>
        <% in_current_month = (day.month == @month_date.month) %>
        <% b_slot = @month_slots_by_date[[day, "breakfast"]]&.first %>
        <% l_slot = @month_slots_by_date[[day, "lunch"]]&.first %>
        <% d_slot = @month_slots_by_date[[day, "dinner"]]&.first %>

        <div class="border-2 border-slate-900 rounded-xl p-1.5 flex flex-col justify-between min-h-[72px] <%= in_current_month ? 'bg-white' : 'bg-slate-100/50 opacity-40' %>">
          <div class="flex items-center justify-between">
            <span class="text-xs font-black <%= in_current_month ? 'text-slate-900' : 'text-slate-400' %>"><%= day.strftime("%-d") %></span>
          </div>

          <div class="my-auto space-y-0.5">
            <% if d_slot %>
              <div class="text-[10px] font-black leading-tight text-slate-900 truncate">
                <%= d_slot.display_title %>
              </div>
              <% if d_slot.family_member %>
                <div class="text-[9px] font-bold text-slate-600 truncate">
                  👨‍🍳 <%= d_slot.family_member.name %>
                </div>
              <% end %>
            <% elsif l_slot %>
              <div class="text-[9px] font-semibold text-slate-600 truncate">
                L: <%= l_slot.display_title %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Sheet Footer -->
    <div class="mt-3 pt-2 border-t-2 border-slate-900 flex items-center justify-between text-[11px] text-slate-600">
      <div><strong>Kitchen Menu:</strong> Hang on refrigerator for easy family reference.</div>
      <div class="font-mono text-[9px] text-slate-400">Printed <%= Time.current.strftime("%b %-d, %Y") %> • TableCraft</div>
    </div>
  </div>

<% else %>
  <!-- 7-DAY WEEKLY FRIDGE SHEET (1-Page) -->
  <div class="border-4 border-slate-900 rounded-3xl p-6 bg-white flex flex-col justify-between h-full">
    <!-- Sheet Header -->
    <div class="flex items-center justify-between border-b-2 border-slate-900 pb-4 mb-4">
      <div>
        <div class="text-[11px] font-black uppercase tracking-widest text-slate-500">Weekly Kitchen Menu</div>
        <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
          <%= @meal_plan.household.name %>
        </h1>
      </div>

      <div class="text-right">
        <div class="text-sm font-extrabold text-slate-900">
          <%= @meal_plan.week_label %>
        </div>
        <div class="text-[11px] font-semibold text-slate-500">
          TableCraft Family Schedule
        </div>
      </div>
    </div>

    <!-- 7-Day Menu Rows -->
    <div class="space-y-2 my-auto">
      <% @meal_plan.days.each do |day| %>
        <% b_slot = @meal_plan.slot_for(day, "breakfast") %>
        <% l_slot = @meal_plan.slot_for(day, "lunch") %>
        <% d_slot = @meal_plan.slot_for(day, "dinner") %>

        <div class="flex items-stretch border-2 border-slate-900 rounded-2xl overflow-hidden min-h-[58px]">
          <!-- Day Badge Column -->
          <div class="w-24 bg-slate-900 text-white p-2 flex flex-col justify-center items-center text-center shrink-0">
            <span class="text-xs font-black uppercase tracking-wider"><%= day.strftime("%A") %></span>
            <span class="text-[11px] font-semibold text-slate-300"><%= day.strftime("%b %-d") %></span>
          </div>

          <!-- Meal Content Column -->
          <div class="flex-1 p-2 px-4 bg-white flex items-center justify-between gap-4">
            <!-- Dinner Info -->
            <div class="flex-1">
              <div class="flex items-center gap-2">
                <span class="text-[10px] font-black uppercase tracking-wider px-1.5 py-0.5 rounded bg-slate-100 text-slate-800 border border-slate-300">
                  Dinner
                </span>
                <span class="text-sm font-extrabold text-slate-900">
                  <%= d_slot&.display_title || "—" %>
                </span>
              </div>

              <!-- Breakfast & Lunch Secondary info -->
              <div class="flex items-center gap-3 text-[10px] text-slate-600 mt-0.5">
                <% if b_slot&.display_title.present? && b_slot.display_title != "No Meal Planned" %>
                  <span><strong>Breakfast:</strong> <%= b_slot.display_title %></span>
                <% end %>
                <% if l_slot&.display_title.present? && l_slot.display_title != "No Meal Planned" %>
                  <span><strong>Lunch:</strong> <%= l_slot.display_title %></span>
                <% end %>
              </div>
            </div>

            <!-- Cook Badge & Meta -->
            <div class="text-right shrink-0">
              <% if d_slot&.family_member %>
                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full border border-slate-900 bg-slate-50 text-xs font-bold text-slate-900">
                  <span>👨‍🍳</span>
                  <span><%= d_slot.family_member.name %></span>
                </span>
              <% elsif d_slot&.recipe %>
                <span class="text-xs text-slate-500 font-medium">⏱️ <%= d_slot.recipe.total_time %>m</span>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Sheet Footer -->
    <div class="mt-3 pt-2 border-t-2 border-slate-900 flex items-center justify-between text-xs text-slate-600">
      <div class="flex items-center gap-2">
        <span class="font-bold">Notes:</span>
        <span class="italic text-slate-500">Check mobile grocery list before weekend prep!</span>
      </div>
      <div class="font-mono text-[10px] text-slate-400">
        Printed <%= Time.current.strftime("%b %-d, %Y") %> • TableCraft
      </div>
    </div>
  </div>
<% end %>
