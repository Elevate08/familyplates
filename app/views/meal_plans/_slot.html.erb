<% slot = meal_plan.slot_for(date, meal_type) %>
<% frame_id = "slot_#{date.to_s}_#{meal_type}" %>

<% badge_colors = {
     "breakfast" => "bg-amber-100/90 text-amber-800 border-amber-200",
     "lunch" => "bg-teal-100/90 text-teal-800 border-teal-200",
     "dinner" => "bg-primary-100/90 text-primary-800 border-primary-200"
   } %>

<% type_icons = {
     "breakfast" => "☀️",
     "lunch" => "🥪",
     "dinner" => "🍽️"
   } %>

<%= turbo_frame_tag frame_id do %>
  <div class="relative group/slot rounded-2xl p-3 transition-all min-h-[95px] flex flex-col justify-between <%= slot&.recipe.present? || slot&.custom_title.present? ? 'bg-primary-50/40 border-2 border-primary-200 hover:border-primary-300 shadow-2xs' : 'bg-slate-50/70 border-2 border-dashed border-slate-200 hover:border-primary-300 hover:bg-primary-50/10' %>">
    
    <% if slot&.recipe.present? || slot&.custom_title.present? %>
      <div>
        <div class="flex items-start justify-between gap-1.5 mb-1">
          <span class="text-[10px] font-extrabold uppercase tracking-wider px-1.5 py-0.5 rounded-md border <%= badge_colors[meal_type] %>">
            <%= type_icons[meal_type] %> <%= meal_type.capitalize %>
          </span>

          <!-- Delete Slot Button -->
          <%= button_to meal_plan_meal_plan_slot_path(meal_plan, slot), method: :delete,
                class: "text-slate-300 hover:text-rose-600 opacity-0 group-hover/slot:opacity-100 transition-opacity p-0.5 cursor-pointer" do %>
            <%= icon_tag("trash", css_class: "w-3.5 h-3.5") %>
          <% end %>
        </div>

        <% if slot.recipe %>
          <%= link_to recipe_path(slot.recipe), target: "_top", class: "block font-bold text-xs text-slate-900 hover:text-primary-600 transition-colors line-clamp-2 leading-snug mt-1" do %>
            <%= slot.recipe.title %>
          <% end %>
        <% else %>
          <div class="font-bold text-xs text-slate-900 line-clamp-2 leading-snug mt-1">
            <%= slot.custom_title %>
          </div>
        <% end %>

        <% if slot.notes.present? %>
          <p class="text-[11px] text-slate-500 line-clamp-1 mt-0.5 italic">
            <%= slot.notes %>
          </p>
        <% end %>
      </div>

      <!-- Cook Badge & Time -->
      <div class="mt-2 pt-1.5 border-t border-primary-100 flex items-center justify-between">
        <% if slot.family_member %>
          <div class="flex items-center gap-1.5" title="Assigned Cook: <%= slot.family_member.name %>">
            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full text-[10px] font-bold text-white shadow-2xs"
                  style="background-color: <%= slot.family_member.avatar_color %>">
              <%= slot.family_member.initial %>
            </span>
            <span class="text-[11px] font-semibold text-slate-700 truncate max-w-[80px]"><%= slot.family_member.name %></span>
          </div>
        <% else %>
          <span class="text-[10px] text-slate-400">Unassigned</span>
        <% end %>

        <% if slot.recipe %>
          <span class="text-[10px] text-slate-400">⏱️ <%= slot.recipe.total_time %>m</span>
        <% end %>
      </div>

    <% else %>
      <!-- Empty Slot -->
      <div class="flex flex-col items-center justify-center h-full py-2.5 text-center">
        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1">
          <%= type_icons[meal_type] %> <%= meal_type.capitalize %>
        </span>

        <!-- Quick Slot Trigger Form / Dropdown -->
        <div class="relative w-full" data-controller="dropdown">
          <button type="button" 
                  data-action="click->dropdown#toggle click@window->dropdown#hide"
                  class="inline-flex items-center justify-center gap-1 w-full py-1 px-2 rounded-xl text-xs font-semibold text-primary-600 bg-white border border-slate-200 hover:border-primary-300 shadow-2xs transition-colors cursor-pointer">
            <%= icon_tag("plus", css_class: "w-3 h-3") %>
            <span>Plan</span>
          </button>

          <div data-dropdown-target="menu" 
               class="hidden absolute left-0 right-0 sm:left-auto sm:right-auto sm:w-80 mt-1 bg-white rounded-3xl shadow-2xl border border-slate-200 p-4 z-50 text-left animate-in fade-in zoom-in-95">
            <div class="flex items-center justify-between pb-2 border-b border-slate-100 mb-3">
              <span class="text-xs font-extrabold text-slate-900">
                Plan <%= meal_type.capitalize %> (<%= date.strftime("%a, %b %-d") %>)
              </span>
            </div>

            <%= form_with url: meal_plan_meal_plan_slots_path(meal_plan), method: :post, class: "space-y-3" do |f| %>
              <%= f.hidden_field "meal_plan_slot[date]", value: date %>
              <%= f.hidden_field "meal_plan_slot[meal_type]", value: meal_type %>

              <div>
                <%= f.label "meal_plan_slot[recipe_id]", "Pick from Vault", class: "block text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1" %>
                <%= f.collection_select "meal_plan_slot[recipe_id]", meal_plan.household.recipes.for_meal_type(meal_type).alphabetical, :id, :title, { prompt: "-- Or enter custom dish below --" },
                      class: "w-full px-3 py-2 rounded-xl border border-slate-200 text-xs bg-white text-slate-800 focus:ring-2 focus:ring-primary-500 focus:outline-none" %>
              </div>

              <div>
                <%= f.label "meal_plan_slot[custom_title]", "Custom Meal Name", class: "block text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1" %>
                <%= f.text_field "meal_plan_slot[custom_title]", placeholder: "e.g. Scrambled Eggs & Toast, Leftovers, Dining Out",
                      class: "w-full px-3 py-2 rounded-xl border border-slate-200 text-xs text-slate-800 focus:ring-2 focus:ring-primary-500 focus:outline-none" %>
              </div>

              <div class="grid grid-cols-2 gap-2">
                <div>
                  <%= f.label "meal_plan_slot[family_member_id]", "Chef", class: "block text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1" %>
                  <%= f.collection_select "meal_plan_slot[family_member_id]", meal_plan.household.family_members.order(:name), :id, :name, { prompt: "-- Anyone --" },
                        class: "w-full px-2.5 py-2 rounded-xl border border-slate-200 text-xs bg-white text-slate-800 focus:ring-2 focus:ring-primary-500 focus:outline-none" %>
                </div>
                <div>
                  <%= f.label "meal_plan_slot[notes]", "Note", class: "block text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1" %>
                  <%= f.text_field "meal_plan_slot[notes]", placeholder: "e.g. 6:30 PM",
                        class: "w-full px-2.5 py-2 rounded-xl border border-slate-200 text-xs text-slate-800 focus:ring-2 focus:ring-primary-500 focus:outline-none" %>
                </div>
              </div>

              <div class="pt-1">
                <%= f.submit "Schedule Meal", class: "w-full py-2.5 rounded-xl bg-primary-600 hover:bg-primary-500 text-white font-bold text-xs cursor-pointer transition-colors shadow-sm" %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

  </div>
<% end %>
