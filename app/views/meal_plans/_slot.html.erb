<% slot = meal_plan.slot_for(date, meal_type) %>
<% frame_id = "slot_#{date.to_s}_#{meal_type}" %>
<% is_admin = current_family_member&.admin? %>

<% badge_colors = {
     "breakfast" => "bg-amber-100/90 dark:bg-amber-950/60 text-amber-800 dark:text-amber-300 border-amber-200 dark:border-amber-800",
     "lunch" => "bg-teal-100/90 dark:bg-teal-950/60 text-teal-800 dark:text-teal-300 border-teal-200 dark:border-teal-800",
     "dinner" => "bg-primary-100/90 dark:bg-primary-950/60 text-primary-800 dark:text-primary-300 border-primary-200 dark:border-primary-800"
   } %>

<% type_icons = {
     "breakfast" => "☀️",
     "lunch" => "🥪",
     "dinner" => "🍽️"
   } %>

<% default_time = case meal_type
                  when "breakfast" then meal_plan.household.breakfast_time.presence || "08:00"
                  when "lunch"     then meal_plan.household.lunch_time.presence || "12:30"
                  else                  meal_plan.household.dinner_time.presence || "18:00"
                  end %>

<% current_time = slot&.scheduled_time.presence || default_time %>

<% recipes = meal_plan.household.recipes.alphabetical %>
<% recipes_map = recipes.each_with_object({}) do |r, hash|
     hash[r.id] = {
       title: r.title,
       image_url: r.display_image_url,
       tags: r.tag_list,
       total_time: r.total_time
     }
   end %>

<% leftover_candidates = meal_plan.available_leftovers_for(date, meal_type, current_slot: slot) %>

<%= turbo_frame_tag frame_id do %>
  <% if is_admin %>
    <div data-controller="slot-modal"
         data-slot-modal-breakfast-time-value="<%= meal_plan.household.breakfast_time.presence || '08:00' %>"
         data-slot-modal-lunch-time-value="<%= meal_plan.household.lunch_time.presence || '12:30' %>"
         data-slot-modal-dinner-time-value="<%= meal_plan.household.dinner_time.presence || '18:00' %>"
         data-slot-modal-recipes-value="<%= recipes_map.to_json %>"
         data-action="click@window->slot-modal#closeRecipeDropdownOnOutside"
         class="h-full">

      <!-- Admin Card Trigger (Click anywhere on card to open modal) -->
      <div data-action="click->slot-modal#open"
           class="relative group/slot rounded-2xl p-3 transition-all min-h-[105px] flex flex-col justify-between cursor-pointer <%= slot&.recipe.present? || slot&.custom_title.present? ? (slot.is_leftover? ? 'bg-purple-50/30 dark:bg-purple-950/30 hover:bg-purple-50/60 dark:hover:bg-purple-950/50 border-2 border-purple-200 dark:border-purple-800 hover:border-purple-400 dark:hover:border-purple-600 hover:shadow-md' : 'bg-white dark:bg-slate-800 hover:bg-primary-50/20 dark:hover:bg-primary-950/30 border-2 border-primary-200 dark:border-primary-800/80 hover:border-primary-400 dark:hover:border-primary-600 hover:shadow-md') : 'bg-slate-50/70 dark:bg-slate-900/60 border-2 border-dashed border-slate-200 dark:border-slate-800 hover:border-primary-300 dark:hover:border-primary-600 hover:bg-primary-50/10 dark:hover:bg-primary-950/20' %>">
        
        <% if slot&.recipe.present? || slot&.custom_title.present? %>
          <div>
            <!-- Header: Meal Badge + Leftover Badge + Time Badge + Delete Button -->
            <div class="flex items-start justify-between gap-1.5 mb-2">
              <div class="flex items-center gap-1.5 flex-wrap">
                <span class="text-[10px] font-extrabold uppercase tracking-wider px-1.5 py-0.5 rounded-md border <%= badge_colors[meal_type] %>">
                  <%= type_icons[meal_type] %> <%= meal_type.capitalize %>
                </span>
                <% if slot.is_leftover? %>
                  <span class="text-[10px] font-extrabold uppercase tracking-wider px-1.5 py-0.5 rounded-md border bg-purple-100 dark:bg-purple-950/60 text-purple-800 dark:text-purple-300 border-purple-200 dark:border-purple-800 flex items-center gap-1"
                        title="<%= slot.leftover_source_slot ? "Leftover from #{slot.leftover_source_slot.date.strftime('%a')} #{slot.leftover_source_slot.meal_type.capitalize}" : "Leftover meal" %>">
                    <span>🍱</span> <span>Leftover</span>
                  </span>
                <% end %>
                <% if slot.scheduled_time.present? %>
                  <span class="text-[10px] font-mono font-semibold text-slate-500 dark:text-slate-400 bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded-md border border-slate-200 dark:border-slate-700">
                    ⏰ <%= slot.scheduled_time %>
                  </span>
                <% end %>
              </div>

              <!-- Delete Slot Button (Stop propagation so click doesn't open modal) -->
              <%= button_to meal_plan_meal_plan_slot_path(meal_plan, slot), method: :delete,
                    title: "Remove from Plan",
                    class: "text-slate-300 dark:text-slate-600 hover:text-rose-600 dark:hover:text-rose-400 opacity-0 group-hover/slot:opacity-100 transition-opacity p-0.5 cursor-pointer rounded hover:bg-rose-50 dark:hover:bg-rose-950/50" do %>
                <%= icon_tag("trash", css_class: "w-3.5 h-3.5") %>
              <% end %>
            </div>

            <!-- Recipe / Meal Title -->
            <div class="mt-1 font-extrabold text-xs text-slate-900 dark:text-white line-clamp-2 leading-snug group-hover/slot:text-primary-700 dark:group-hover/slot:text-primary-400 transition-colors">
              <%= slot.display_title %>
            </div>

            <% if slot.notes.present? %>
              <p class="text-[10.5px] text-slate-500 dark:text-slate-400 line-clamp-1 mt-1 italic">
                💬 <%= slot.notes %>
              </p>
            <% end %>
          </div>

          <!-- Footer: Cook Badge & Total Duration -->
          <div class="mt-2.5 pt-1.5 border-t border-slate-100 dark:border-slate-700/80 flex items-center justify-between">
            <% if slot.family_member %>
              <div class="flex items-center gap-1.5" title="Assigned Cook: <%= slot.family_member.name %>">
                <span class="inline-flex items-center justify-center w-5 h-5 rounded-full text-white shadow-2xs"
                      style="background-color: <%= slot.family_member.avatar_color %>">
                  <%= icon_tag(slot.family_member.avatar_icon.presence || "chef-hat", css_class: "w-3 h-3") %>
                </span>
                <span class="text-[11px] font-semibold text-slate-700 dark:text-slate-300 truncate max-w-[85px]"><%= slot.family_member.name %></span>
              </div>
            <% else %>
              <span class="text-[10px] text-slate-400 dark:text-slate-500">
                <% if slot.is_leftover? %>
                  <%= slot.leftover_source_slot ? "🍱 From #{slot.leftover_source_slot.date.strftime('%a')} #{slot.leftover_source_slot.meal_type.capitalize}" : "🍱 Ready to heat" %>
                <% else %>
                  👤 Unassigned
                <% end %>
              </span>
            <% end %>

            <% if slot.recipe %>
              <span class="text-[10px] font-semibold text-slate-500 dark:text-slate-400">⏱️ <%= slot.recipe.total_time %>m</span>
            <% end %>
          </div>

        <% else %>
          <!-- Empty Slot State (Admin can plan) -->
          <div class="flex flex-col items-center justify-center h-full py-3 text-center">
            <span class="text-[10px] font-extrabold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-1.5">
              <%= type_icons[meal_type] %> <%= meal_type.capitalize %>
            </span>

            <div class="inline-flex items-center justify-center gap-1 py-1.5 px-3 rounded-xl text-xs font-bold text-primary-600 dark:text-primary-400 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 group-hover/slot:border-primary-400 dark:group-hover/slot:border-primary-500 group-hover/slot:bg-primary-50/50 dark:group-hover/slot:bg-primary-950/40 shadow-2xs transition-all">
              <%= icon_tag("plus", css_class: "w-3.5 h-3.5") %>
              <span>Plan <%= meal_type.capitalize %></span>
            </div>

            <!-- 1-Tap Leftovers Rollover Actions -->
            <% if leftover_candidates.any? %>
              <div class="mt-2.5 w-full flex flex-col items-stretch gap-1.5">
                <% leftover_candidates.first(2).each do |cand| %>
                  <%= button_to meal_plan_meal_plan_slots_path(meal_plan), method: :post,
                        params: {
                          meal_plan_slot: {
                            date: date,
                            meal_type: meal_type,
                            recipe_id: cand[:recipe].id,
                            is_leftover: true
                          }
                        },
                        data: { controller: "stop-propagation", action: "click->stop-propagation#stop" },
                        title: "Use leftovers from #{cand[:source_label]}: #{cand[:recipe].title}",
                        class: "w-full flex flex-col items-center justify-center p-2 rounded-xl text-purple-700 dark:text-purple-300 bg-purple-50 dark:bg-purple-950/60 hover:bg-purple-100 dark:hover:bg-purple-900/60 border border-purple-200/80 dark:border-purple-800 transition-all cursor-pointer shadow-2xs group/leftover text-center" do %>
                    <div class="w-full text-center">
                      <span class="text-[11px] font-extrabold leading-tight text-purple-900 dark:text-purple-200 break-words line-clamp-2"><%= cand[:recipe].title %></span>
                    </div>
                    <span class="text-[9px] font-semibold text-purple-600 dark:text-purple-400 mt-0.5">(<%= cand[:source_label] %>)</span>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>

      <!-- Centered Responsive Modal Dialog -->
      <div data-slot-modal-target="modal"
           data-action="click->slot-modal#closeBackground"
           class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-xs p-4 overflow-y-auto themed-scrollbar animate-in fade-in duration-150">
        
        <div class="relative w-full max-w-lg bg-white dark:bg-slate-800 rounded-3xl shadow-2xl border border-slate-200 dark:border-slate-700 p-6 sm:p-7 max-h-[90vh] overflow-y-auto overflow-x-hidden themed-scrollbar space-y-5 animate-in zoom-in-95 duration-150 text-left text-slate-900 dark:text-slate-100">
          
          <!-- Modal Header -->
          <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-700 pb-3">
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-2xl bg-primary-50 dark:bg-primary-950/60 text-primary-600 dark:text-primary-400 flex items-center justify-center font-bold text-sm">
                <%= slot ? "✏️" : "📅" %>
              </div>
              <div>
                <h3 class="text-base font-extrabold text-slate-900 dark:text-white">
                  <%= slot ? "Modify Planned Meal" : "Schedule Meal" %>
                </h3>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                  <%= date.strftime("%A, %B %-d") %> • <%= meal_type.capitalize %>
                </p>
              </div>
            </div>

            <button type="button" 
                    data-action="click->slot-modal#close"
                    class="w-8 h-8 rounded-full bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-white flex items-center justify-center transition-colors cursor-pointer text-sm font-bold">
              ✕
            </button>
          </div>

          <!-- Form (Handles Create or Update) -->
          <% form_url = slot ? meal_plan_meal_plan_slot_path(meal_plan, slot) : meal_plan_meal_plan_slots_path(meal_plan) %>
          <% form_method = slot ? :patch : :post %>

          <%= form_with url: form_url, method: form_method, class: "space-y-4" do |f| %>
            <% unless slot %>
              <%= f.hidden_field "meal_plan_slot[date]", id: "#{frame_id}_hidden_date", value: date %>
              <%= f.hidden_field "meal_plan_slot[meal_type]", id: "#{frame_id}_hidden_meal_type", value: meal_type %>
            <% end %>

            <!-- Hidden Recipe ID Input -->
            <input type="hidden"
                   name="meal_plan_slot[recipe_id]"
                   value="<%= slot&.recipe_id %>"
                   data-slot-modal-target="recipeInput">

            <!-- Hidden Leftover Source Slot ID Input -->
            <input type="hidden"
                   name="meal_plan_slot[leftover_source_slot_id]"
                   value="<%= slot&.leftover_source_slot_id %>"
                   data-slot-modal-target="leftoverSourceInput">

            <!-- Available Leftovers Quick Selector Bar (if any prior meals exist) -->
            <% if leftover_candidates.any? %>
              <div class="p-3.5 rounded-2xl bg-purple-50/70 dark:bg-purple-950/40 border border-purple-200/80 dark:border-purple-800 space-y-2">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-bold text-purple-900 dark:text-purple-300 flex items-center gap-1.5">
                    <span>🍱</span>
                    <span>Available Leftovers this week (<%= leftover_candidates.count %> <%= 'option'.pluralize(leftover_candidates.count) %>):</span>
                  </span>
                  <span class="text-[10px] text-purple-600 dark:text-purple-400 font-semibold">1-tap quick pick</span>
                </div>
                <div class="flex flex-wrap gap-2">
                  <% leftover_candidates.each do |cand| %>
                    <% cap = cand[:remaining_capacity] %>
                    <% cap_text = cap == 1 ? "Last one!" : "#{cap} left" %>
                    <% days_text = cand[:days_remaining] == 0 ? "Expires today" : "#{pluralize(cand[:days_remaining], 'day')} fresh" %>
                    <button type="button"
                            data-action="click->slot-modal#selectLeftover"
                            data-recipe-id="<%= cand[:recipe].id %>"
                            data-source-slot-id="<%= cand[:source_slot_id] %>"
                            class="flex flex-col items-start px-3 py-2 rounded-xl bg-white dark:bg-slate-800 hover:bg-purple-100 dark:hover:bg-purple-900/60 border border-purple-200 dark:border-purple-700 text-purple-900 dark:text-purple-300 transition-all shadow-2xs cursor-pointer group/cand text-left">
                      <div class="flex items-center gap-2 w-full justify-between">
                        <span class="text-xs font-extrabold group-hover/cand:text-purple-700 dark:group-hover/cand:text-purple-200 truncate max-w-[130px]"><%= cand[:recipe].title %></span>
                        <span class="text-[9px] font-black px-1.5 py-0.5 rounded <%= cap == 1 ? 'bg-amber-100 dark:bg-amber-900/60 text-amber-800 dark:text-amber-300' : 'bg-purple-100 dark:bg-purple-900/50 text-purple-700 dark:text-purple-300' %>">
                          <%= cap_text %>
                        </span>
                      </div>
                      <div class="flex items-center gap-1 text-[9.5px] text-purple-500 dark:text-purple-400 font-semibold mt-0.5">
                        <span><%= cand[:source_label] %></span>
                        <span>•</span>
                        <span><%= days_text %></span>
                      </div>
                    </button>
                  <% end %>
                </div>
              </div>
            <% end %>

            <!-- Detailed Recipe Dropdown Selector -->
            <div class="relative">
              <span class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">
                Pick Recipe from Collection
              </span>

              <!-- Dropdown Trigger Button -->
              <button type="button"
                      data-slot-modal-target="recipeDropdownButton"
                      data-action="click->slot-modal#toggleRecipeDropdown"
                      class="w-full p-2.5 rounded-2xl border-2 border-slate-200 dark:border-slate-700 hover:border-primary-400 dark:hover:border-primary-500 bg-white dark:bg-slate-900 text-left transition-all focus:outline-none focus:ring-2 focus:ring-primary-500 shadow-2xs cursor-pointer">
                <div data-slot-modal-target="recipeSelectedDisplay">
                  <!-- Populated dynamically by Stimulus syncSelectedRecipeDisplay -->
                </div>
              </button>

              <!-- Dropdown Menu List of Detailed Recipe Options -->
              <div data-slot-modal-target="recipeDropdownMenu"
                   class="hidden absolute left-0 right-0 mt-1.5 bg-white dark:bg-slate-900 rounded-2xl shadow-2xl border border-slate-200 dark:border-slate-700 p-2 z-60 max-h-64 overflow-y-auto overflow-x-hidden themed-scrollbar space-y-1 animate-in fade-in zoom-in-95 duration-100">
                
                <!-- None / Custom Dish Option -->
                <button type="button"
                        data-action="click->slot-modal#selectRecipe"
                        data-recipe-id=""
                        class="w-full p-2 rounded-xl text-left hover:bg-slate-50 dark:hover:bg-slate-800 flex items-center gap-2.5 transition-colors cursor-pointer text-xs font-bold text-slate-600 dark:text-slate-400 border border-transparent hover:border-slate-200 dark:hover:border-slate-700">
                  <span class="w-8 h-8 rounded-lg bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-xs">🍽️</span>
                  <span>-- None (Use Custom Meal Below) --</span>
                </button>

                <!-- List of Recipes with Thumbnails, Tags, Prep Times -->
                <% recipes.each do |recipe| %>
                  <button type="button"
                          data-action="click->slot-modal#selectRecipe"
                          data-recipe-id="<%= recipe.id %>"
                          class="w-full p-2 rounded-xl text-left hover:bg-primary-50/50 dark:hover:bg-primary-950/40 flex items-center gap-3 transition-colors cursor-pointer border border-transparent hover:border-primary-200 dark:hover:border-primary-800 group/item">
                    <img src="<%= recipe.display_image_url %>" alt="<%= recipe.title %>" class="w-9 h-9 rounded-lg object-cover bg-slate-100 dark:bg-slate-800 shrink-0">
                    <div class="min-w-0 flex-1">
                      <div class="font-bold text-xs text-slate-900 dark:text-white group-hover/item:text-primary-600 dark:group-hover/item:text-primary-400 truncate"><%= recipe.title %></div>
                      <div class="flex items-center gap-2 text-[10px] text-slate-500 dark:text-slate-400 mt-0.5">
                        <span>⏱️ <%= recipe.total_time %>m</span>
                        <% if recipe.tag_list.any? %>
                          <span class="truncate">• <%= recipe.tag_list.first(2).join(", ") %></span>
                        <% end %>
                      </div>
                    </div>
                  </button>
                <% end %>
              </div>
            </div>

            <!-- Custom Meal Title (Optional if not choosing a recipe) -->
            <div>
              <label for="<%= frame_id %>_custom_title" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">
                Or Custom Dish / Takeout Name
              </label>
              <%= f.text_field "meal_plan_slot[custom_title]", id: "#{frame_id}_custom_title",
                    value: slot&.custom_title,
                    placeholder: "e.g. Grandma's Lasagna, Pizza Night, Leftovers",
                    class: "w-full px-3.5 py-2.5 rounded-2xl border-2 border-slate-200 dark:border-slate-700 hover:border-primary-400 dark:hover:border-primary-500 bg-white dark:bg-slate-900 text-xs font-semibold text-slate-900 dark:text-white transition-all focus:ring-2 focus:ring-primary-500 focus:outline-none shadow-2xs" %>
            </div>

            <!-- Leftover Toggle Checkbox -->
            <div class="p-3 rounded-xl bg-purple-50/50 dark:bg-purple-950/30 border border-purple-200/60 dark:border-purple-900/60 flex items-center justify-between">
              <label class="flex items-center gap-2 text-xs font-bold text-purple-900 dark:text-purple-300 cursor-pointer">
                <%= f.check_box "meal_plan_slot[is_leftover]", id: "#{frame_id}_is_leftover",
                      checked: slot&.is_leftover?,
                      data: { action: "change->slot-modal#toggleLeftover" },
                      class: "rounded text-purple-600 focus:ring-purple-500 w-4 h-4 cursor-pointer" %>
                <span>🍱 Mark this meal as Leftovers</span>
              </label>
              <span class="text-[10px] text-purple-600 dark:text-purple-400 font-semibold">Ready to heat</span>
            </div>

            <!-- Cook Assignment & Scheduled Time Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <!-- Assigned Cook -->
              <div>
                <label for="<%= frame_id %>_family_member_id" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">
                  Assigned Cook / Chef
                </label>
                <%= f.collection_select "meal_plan_slot[family_member_id]",
                      meal_plan.household.family_members.order(:name), :id, :name,
                      { prompt: "-- Unassigned --", selected: slot&.family_member_id },
                      id: "#{frame_id}_family_member_id",
                      class: "themed-select cursor-pointer w-full px-3.5 py-2.5 rounded-2xl border-2 border-slate-200 dark:border-slate-700 hover:border-primary-400 dark:hover:border-primary-500 bg-white dark:bg-slate-900 text-xs font-semibold text-slate-900 dark:text-white transition-all focus:ring-2 focus:ring-primary-500 focus:outline-none shadow-2xs" %>
              </div>

              <!-- Scheduled Time Override -->
              <div>
                <label for="<%= frame_id %>_scheduled_time" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">
                  Scheduled Time
                </label>
                <%= f.time_field "meal_plan_slot[scheduled_time]", id: "#{frame_id}_scheduled_time",
                      value: current_time,
                      data: { "slot-modal-target": "timeInput" },
                      class: "w-full px-3.5 py-2.5 rounded-2xl border-2 border-slate-200 dark:border-slate-700 hover:border-primary-400 dark:hover:border-primary-500 bg-white dark:bg-slate-900 text-xs font-semibold text-slate-900 dark:text-white transition-all focus:ring-2 focus:ring-primary-500 focus:outline-none shadow-2xs" %>
              </div>
            </div>

            <!-- Reschedule Meal: Date & Meal Type Pickers -->
            <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-700 space-y-2">
              <span class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                Move / Reschedule Slot
              </span>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                <div>
                  <span class="block text-[10px] font-bold text-slate-500 dark:text-slate-400 mb-1">Target Date</span>
                  <%= f.date_field "meal_plan_slot[date]", id: "#{frame_id}_date",
                        value: date,
                        class: "w-full px-3.5 py-2.5 rounded-2xl border-2 border-slate-200 dark:border-slate-700 hover:border-primary-400 dark:hover:border-primary-500 bg-white dark:bg-slate-900 text-xs font-semibold text-slate-900 dark:text-white transition-all focus:ring-2 focus:ring-primary-500 focus:outline-none shadow-2xs" %>
                </div>

                <div>
                  <span class="block text-[10px] font-bold text-slate-500 dark:text-slate-400 mb-1">Target Meal Period</span>
                  <%= f.select "meal_plan_slot[meal_type]",
                        MealPlanSlot::MEAL_TYPES.map { |mt| [mt.capitalize, mt] },
                        { selected: meal_type },
                        id: "#{frame_id}_meal_type",
                        data: { action: "change->slot-modal#updateDefaultTime" },
                        class: "themed-select cursor-pointer w-full px-3.5 py-2.5 rounded-2xl border-2 border-slate-200 dark:border-slate-700 hover:border-primary-400 dark:hover:border-primary-500 bg-white dark:bg-slate-900 text-xs font-semibold text-slate-900 dark:text-white transition-all focus:ring-2 focus:ring-primary-500 focus:outline-none shadow-2xs" %>
                </div>
              </div>
            </div>

            <!-- Notes -->
            <div>
              <label for="<%= frame_id %>_notes" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">
                Cooking Notes (optional)
              </label>
              <%= f.text_field "meal_plan_slot[notes]", id: "#{frame_id}_notes",
                    value: slot&.notes,
                    placeholder: "e.g. Side salad, extra spicy, prep at 5pm",
                    class: "w-full px-3.5 py-2.5 rounded-2xl border-2 border-slate-200 dark:border-slate-700 hover:border-primary-400 dark:hover:border-primary-500 bg-white dark:bg-slate-900 text-xs font-semibold text-slate-900 dark:text-white transition-all focus:ring-2 focus:ring-primary-500 focus:outline-none shadow-2xs" %>
            </div>

            <!-- Modal Action Buttons -->
            <div class="flex items-center justify-between gap-3 pt-2 border-t border-slate-100 dark:border-slate-700">
              <% if slot %>
                <%= button_to meal_plan_meal_plan_slot_path(meal_plan, slot), method: :delete,
                      data: { turbo_confirm: "Clear this meal from your meal plan?" },
                      class: "px-3.5 py-2.5 rounded-xl text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/40 text-xs font-bold transition-colors cursor-pointer" do %>
                  Remove Meal
                <% end %>
              <% else %>
                <div></div>
              <% end %>

              <div class="flex items-center gap-2">
                <button type="button" 
                        data-action="click->slot-modal#close"
                        class="px-4 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-300 text-xs font-bold transition-colors cursor-pointer">
                  Cancel
                </button>
                <%= f.submit (slot ? "Save Changes" : "Schedule Meal"),
                      class: "px-5 py-2.5 rounded-xl bg-primary-600 hover:bg-primary-500 text-white font-bold text-xs shadow-sm cursor-pointer transition-all" %>
              </div>
            </div>
          <% end %>

        </div>
      </div>
    </div>

  <% else %>
    <!-- NON-ADMIN / READ-ONLY VIEW OF MEAL SLOT -->
    <% if slot&.recipe.present? || slot&.custom_title.present? %>
      <div class="relative group/slot rounded-2xl p-3 transition-all min-h-[105px] flex flex-col justify-between <%= slot.is_leftover? ? 'bg-purple-50/30 dark:bg-purple-950/30 border-2 border-purple-200 dark:border-purple-800' : 'bg-white dark:bg-slate-800 border-2 border-primary-200 dark:border-primary-800/80' %> shadow-2xs">
        <div>
          <!-- Header: Meal Badge + Leftover Badge + Time Badge -->
          <div class="flex items-start justify-between gap-1.5 mb-2">
            <div class="flex items-center gap-1.5 flex-wrap">
              <span class="text-[10px] font-extrabold uppercase tracking-wider px-1.5 py-0.5 rounded-md border <%= badge_colors[meal_type] %>">
                <%= type_icons[meal_type] %> <%= meal_type.capitalize %>
              </span>
              <% if slot.is_leftover? %>
                <span class="text-[10px] font-extrabold uppercase tracking-wider px-1.5 py-0.5 rounded-md border bg-purple-100 dark:bg-purple-950/60 text-purple-800 dark:text-purple-300 border-purple-200 dark:border-purple-800 flex items-center gap-1">
                  <span>🍱</span> <span>Leftover</span>
                </span>
              <% end %>
              <% if slot.scheduled_time.present? %>
                <span class="text-[10px] font-mono font-semibold text-slate-500 dark:text-slate-400 bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded-md border border-slate-200 dark:border-slate-700">
                  ⏰ <%= slot.scheduled_time %>
                </span>
              <% end %>
            </div>
          </div>

          <!-- Recipe / Meal Title (Clickable if linked to recipe) -->
          <% if slot.recipe %>
            <%= link_to recipe_path(slot.recipe), class: "mt-1 font-extrabold text-xs text-slate-900 dark:text-white line-clamp-2 leading-snug hover:text-primary-600 dark:hover:text-primary-400 transition-colors block" do %>
              <%= slot.display_title %>
            <% end %>
          <% else %>
            <div class="mt-1 font-extrabold text-xs text-slate-900 dark:text-white line-clamp-2 leading-snug">
              <%= slot.display_title %>
            </div>
          <% end %>

          <% if slot.notes.present? %>
            <p class="text-[10.5px] text-slate-500 dark:text-slate-400 line-clamp-1 mt-1 italic">
              💬 <%= slot.notes %>
            </p>
          <% end %>
        </div>

        <!-- Footer: Cook Badge & Total Duration -->
        <div class="mt-2.5 pt-1.5 border-t border-slate-100 dark:border-slate-700/80 flex items-center justify-between">
          <% if slot.family_member %>
            <div class="flex items-center gap-1.5" title="Assigned Cook: <%= slot.family_member.name %>">
              <span class="inline-flex items-center justify-center w-5 h-5 rounded-full text-white shadow-2xs"
                    style="background-color: <%= slot.family_member.avatar_color %>">
                <%= icon_tag(slot.family_member.avatar_icon.presence || "chef-hat", css_class: "w-3 h-3") %>
              </span>
              <span class="text-[11px] font-semibold text-slate-700 dark:text-slate-300 truncate max-w-[85px]"><%= slot.family_member.name %></span>
            </div>
          <% else %>
            <span class="text-[10px] text-slate-400 dark:text-slate-500"><%= slot.is_leftover? ? "🍱 Ready to heat" : "👤 Unassigned" %></span>
          <% end %>

          <% if slot.recipe %>
            <%= link_to recipe_path(slot.recipe), class: "text-[10px] font-semibold text-primary-600 dark:text-primary-400 hover:underline" do %>
              ⏱️ <%= slot.recipe.total_time %>m →
            <% end %>
          <% end %>
        </div>
      </div>

    <% else %>
      <!-- Read-Only Empty Slot State -->
      <div class="flex flex-col items-center justify-center h-full py-4 text-center rounded-2xl p-3 bg-slate-50/40 dark:bg-slate-900/40 border-2 border-dashed border-slate-200 dark:border-slate-800 min-h-[105px]">
        <span class="text-[10px] font-extrabold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-1">
          <%= type_icons[meal_type] %> <%= meal_type.capitalize %>
        </span>
        <span class="text-[11px] font-semibold text-slate-400 dark:text-slate-500">
          No meal planned
        </span>
      </div>
    <% end %>
  <% end %>
<% end %>
