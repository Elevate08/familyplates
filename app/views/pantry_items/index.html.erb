<div class="max-w-4xl mx-auto py-6">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight flex items-center gap-3">
        <span>Pantry & Staples</span>
        <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-amber-100 dark:bg-amber-950/80 text-amber-800 dark:text-amber-300">
          <%= @pantry_items.where(is_staple: true).count %> active staples
        </span>
      </h1>
      <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
        Items marked as staples are automatically shielded and excluded from your weekly grocery shopping list.
      </p>
    </div>
  </div>

  <!-- Elegant Add Item Card with Interactive Picker -->
  <div class="bg-white dark:bg-slate-900 p-6 rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-sm mb-10" data-controller="pantry-item-form">
    <h2 class="text-sm font-extrabold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-4 flex items-center gap-2">
      <%= icon_tag("plus", css_class: "w-4 h-4 text-primary-500") %>
      <span>Add Item to Pantry</span>
    </h2>

    <%= form_with model: @new_item, url: pantry_items_path, class: "space-y-4" do |f| %>
      <%= f.hidden_field :emoji, value: "", data: { pantry_item_form_target: "iconInput" } %>

      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3">
        <!-- Interactive Icon Picker Trigger -->
        <button type="button" 
                data-action="click->pantry-item-form#togglePicker"
                class="group flex items-center gap-2 p-2 rounded-2xl border-2 border-slate-200 dark:border-slate-700 hover:border-primary-400 dark:hover:border-primary-500 bg-slate-50 dark:bg-slate-800 transition-all cursor-pointer shadow-2xs shrink-0"
                title="Click to choose a custom icon">
          <div data-pantry-item-form-target="iconPreview" class="w-8 h-8 flex items-center justify-center">
            <%= pantry_icon_tag("spice-jar", "Spices & Baking", css_class: "w-6 h-6") %>
          </div>
          <span class="text-[11px] font-bold text-slate-500 dark:text-slate-400 group-hover:text-primary-600 dark:group-hover:text-primary-400 pr-1">
            Pick Icon ▾
          </span>
        </button>

        <!-- Name Input with auto-suggest -->
        <div class="flex-1 w-full">
          <%= f.text_field :name, placeholder: "e.g. Black Pepper, Brown Sugar, Olive Oil, Basmati Rice...", required: true,
                data: { pantry_item_form_target: "nameInput", action: "input->pantry-item-form#onNameChange" },
                class: "w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 text-slate-900 dark:text-white" %>
        </div>

        <!-- Hidden Native Select (synced with chips) -->
        <div class="hidden">
          <%= f.select :aisle_category, PantryItem::CATEGORIES.map { |c| [c, c] }, {},
                data: { pantry_item_form_target: "categorySelect" } %>
        </div>

        <!-- Submit & Always Stocked Toggle -->
        <div class="flex items-center gap-3 w-full sm:w-auto justify-between sm:justify-end">
          <label class="flex items-center gap-2 text-xs font-semibold text-slate-700 dark:text-slate-300 cursor-pointer select-none">
            <%= f.check_box :is_staple, checked: true, class: "w-4 h-4 rounded text-amber-600 focus:ring-amber-500 border-slate-300 dark:border-slate-600" %>
            <span>Always Stocked</span>
          </label>
          <%= f.submit "+ Add Item", class: "py-2.5 px-5 rounded-xl bg-primary-600 hover:bg-primary-500 text-white font-bold text-xs shadow-sm cursor-pointer transition-all hover:scale-105" %>
        </div>
      </div>

      <!-- Category Quick-Select Chips -->
      <div>
        <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-1.5">Aisle Category</span>
        <div class="flex flex-wrap gap-1.5">
          <% category_emojis = { "Produce" => "🥬", "Meat & Seafood" => "🥩", "Dairy & Refrigerated" => "🧀", "Bakery" => "🍞", "Pantry & Grains" => "🌾", "Spices & Baking" => "🧂", "Frozen" => "🧊", "Other" => "📦" } %>
          <% PantryItem::CATEGORIES.each_with_index do |cat, idx| %>
            <button type="button"
                    data-category="<%= cat %>"
                    data-pantry-item-form-target="categoryChip"
                    data-action="click->pantry-item-form#selectCategoryFromChip"
                    class="px-2.5 py-1 rounded-xl text-xs font-semibold border transition-all cursor-pointer <%= idx == 5 ? 'bg-primary-600 text-white border-primary-600' : 'bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border-slate-200 dark:border-slate-700 hover:border-slate-300 dark:hover:border-slate-600' %>">
              <span><%= category_emojis[cat] %></span>
              <span><%= cat %></span>
            </button>
          <% end %>
        </div>
      </div>

      <!-- Expandable Icon Palette Drawer -->
      <div data-pantry-item-form-target="pickerContainer" class="hidden pt-3 border-t border-slate-100 dark:border-slate-800 animate-in fade-in zoom-in-95 duration-150">
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-bold text-slate-700 dark:text-slate-300">Choose an Icon:</span>
          <span class="text-[10px] text-slate-400">Includes Custom SVGs & Emojis</span>
        </div>

        <div class="grid grid-cols-6 sm:grid-cols-10 gap-2 p-3 bg-slate-50 dark:bg-slate-800/60 rounded-2xl border border-slate-200 dark:border-slate-700 max-h-48 overflow-y-auto">
          <!-- Custom SVGs -->
          <button type="button" data-icon-id="pepper-shaker" data-action="click->pantry-item-form#pickIcon" class="p-2 rounded-xl bg-white dark:bg-slate-700 hover:scale-110 border border-slate-200 dark:border-slate-600 flex flex-col items-center justify-center transition-all cursor-pointer" title="Black Pepper Shaker">
            <%= pantry_icon_tag("pepper-shaker", css_class: "w-6 h-6") %>
            <span class="text-[8px] font-medium text-slate-500 mt-1 truncate max-w-full">Pepper</span>
          </button>

          <button type="button" data-icon-id="sugar-bag" data-action="click->pantry-item-form#pickIcon" class="p-2 rounded-xl bg-white dark:bg-slate-700 hover:scale-110 border border-slate-200 dark:border-slate-600 flex flex-col items-center justify-center transition-all cursor-pointer" title="Sugar Bag">
            <%= pantry_icon_tag("sugar-bag", css_class: "w-6 h-6") %>
            <span class="text-[8px] font-medium text-slate-500 mt-1 truncate max-w-full">Sugar</span>
          </button>

          <button type="button" data-icon-id="oil-bottle" data-action="click->pantry-item-form#pickIcon" class="p-2 rounded-xl bg-white dark:bg-slate-700 hover:scale-110 border border-slate-200 dark:border-slate-600 flex flex-col items-center justify-center transition-all cursor-pointer" title="Cooking Oil">
            <%= pantry_icon_tag("oil-bottle", css_class: "w-6 h-6") %>
            <span class="text-[8px] font-medium text-slate-500 mt-1 truncate max-w-full">Oil</span>
          </button>

          <button type="button" data-icon-id="spice-jar" data-action="click->pantry-item-form#pickIcon" class="p-2 rounded-xl bg-white dark:bg-slate-700 hover:scale-110 border border-slate-200 dark:border-slate-600 flex flex-col items-center justify-center transition-all cursor-pointer" title="Spice Jar / Powder">
            <%= pantry_icon_tag("spice-jar", css_class: "w-6 h-6") %>
            <span class="text-[8px] font-medium text-slate-500 mt-1 truncate max-w-full">Spices</span>
          </button>

          <!-- Popular Emojis -->
          <% [
            ["🧂", "Salt"], ["🍾", "Olive Oil"], ["🧈", "Butter"], ["🥚", "Eggs"],
            ["🥛", "Milk"], ["🧀", "Cheese"], ["🧄", "Garlic"], ["🧅", "Onion"],
            ["🍞", "Bread"], ["🍚", "Rice"], ["🍝", "Pasta"], ["🌾", "Flour"],
            ["🌿", "Herbs"], ["🍯", "Honey"], ["🍶", "Soy Sauce"], ["🥩", "Meat"],
            ["🍗", "Poultry"], ["🐟", "Fish"], ["🥬", "Greens"], ["🍅", "Tomato"],
            ["🍋", "Lemon"], ["🥑", "Avocado"], ["🥔", "Potato"], ["🧊", "Frozen"]
          ].each do |emoji_char, label| %>
            <button type="button" data-icon-id="<%= emoji_char %>" data-action="click->pantry-item-form#pickIcon" class="p-2 rounded-xl bg-white dark:bg-slate-700 hover:scale-110 border border-slate-200 dark:border-slate-600 flex flex-col items-center justify-center transition-all cursor-pointer" title="<%= label %>">
              <span class="text-xl leading-none"><%= emoji_char %></span>
              <span class="text-[8px] font-medium text-slate-500 mt-1 truncate max-w-full"><%= label %></span>
            </button>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Aisle Categories Display -->
  <div class="space-y-6">
    <% PantryItem::CATEGORIES.each do |category| %>
      <% items = @items_by_category[category] || [] %>
      <% if items.any? %>
        <div>
          <h2 class="text-sm font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-3 flex items-center gap-2">
            <span><%= category %></span>
            <span class="text-xs font-normal text-slate-400 dark:text-slate-500">(<%= items.count %>)</span>
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
            <% items.each do |item| %>
              <%= render "pantry_items/pantry_item", pantry_item: item %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
