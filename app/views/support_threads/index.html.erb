<% content_for :title, "Contact Support | FamilyPlates" %>

<div class="max-w-3xl mx-auto py-6 sm:py-8 space-y-8">
  <div>
    <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">Contact support</h1>
    <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">Start a conversation with our support team and keep the full history in one place.</p>
  </div>

  <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
    <h2 class="text-lg font-extrabold text-slate-900 dark:text-white">Start a support request</h2>
    <%= form_with url: support_threads_path, scope: :support_thread, class: "mt-4 space-y-4" do |form| %>
      <div>
        <label for="support_thread_subject" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Subject</label>
        <%= form.text_field :subject, id: "support_thread_subject", required: true, maxlength: 200, placeholder: "What can we help with?", class: "block w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm dark:border-slate-700 dark:bg-slate-950 dark:text-white" %>
      </div>
      <div>
        <label for="support_thread_body" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Message</label>
        <%= form.text_area :body, id: "support_thread_body", required: true, maxlength: 10_000, rows: 5, placeholder: "Tell us what happened...", class: "block w-full rounded-xl border border-slate-300 p-4 text-sm dark:border-slate-700 dark:bg-slate-950 dark:text-white" %>
      </div>
      <%= form.submit "Send to support", class: "rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-bold text-white hover:bg-slate-700 cursor-pointer transition-colors" %>
    <% end %>
  </div>

  <!-- Active Conversations Section -->
  <% if @active_threads.present? %>
    <div class="rounded-3xl border border-slate-200 bg-white px-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <div class="pt-6 pb-2 flex items-center justify-between">
        <h2 class="text-lg font-extrabold text-slate-900 dark:text-white">Active conversations</h2>
        <span class="px-2 py-0.5 rounded-full text-xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300"><%= @active_threads.size %></span>
      </div>
      <div class="divide-y divide-slate-100 dark:divide-slate-800">
        <% @active_threads.each do |thread| %>
          <%= link_to support_thread_path(thread), class: "block py-4 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors group" do %>
            <div class="flex items-center justify-between gap-4">
              <span class="font-bold text-slate-900 dark:text-white group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors"><%= thread.subject %></span>
              <%= support_thread_status_badge(thread) %>
            </div>
            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
              Last message <%= thread.last_message_at ? "#{time_ago_in_words(thread.last_message_at)} ago" : "just now" %>
            </p>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Resolved Support Requests Section -->
  <% if @resolved_threads.present? %>
    <div class="rounded-3xl border border-slate-200/80 bg-white/70 px-6 shadow-2xs dark:border-slate-800 dark:bg-slate-900/60">
      <div class="pt-6 pb-2 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <h2 class="text-base font-bold text-slate-900 dark:text-white">Resolved requests</h2>
        </div>
        <span class="px-2 py-0.5 rounded-full text-xs font-bold bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60"><%= @resolved_threads.size %></span>
      </div>
      <div class="divide-y divide-slate-100 dark:divide-slate-800/70">
        <% @resolved_threads.each do |thread| %>
          <%= link_to support_thread_path(thread), class: "block py-4 hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors group opacity-85 hover:opacity-100" do %>
            <div class="flex items-center justify-between gap-4">
              <span class="font-semibold text-slate-800 dark:text-slate-200 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors"><%= thread.subject %></span>
              <%= support_thread_status_badge(thread) %>
            </div>
            <p class="mt-1 text-xs text-slate-400 dark:text-slate-500">
              Resolved <%= thread.resolved_at ? "#{time_ago_in_words(thread.resolved_at)} ago" : "previously" %>
            </p>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
