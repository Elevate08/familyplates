<% content_for :title, "Contact Support | FamilyPlates" %>

<div class="max-w-3xl mx-auto py-6 sm:py-8 space-y-7">
  <div>
    <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">Contact support</h1>
    <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">Start a conversation and keep the full history in one place.</p>
  </div>

  <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
    <h2 class="text-lg font-extrabold text-slate-900 dark:text-white">Start a support request</h2>
    <%= form_with url: support_threads_path, scope: :support_thread, class: "mt-4 space-y-4" do |form| %>
      <%= form.text_field :subject, required: true, maxlength: 200, placeholder: "What can we help with?", class: "block w-full rounded-xl border-slate-300 dark:border-slate-700 dark:bg-slate-950" %>
      <%= form.text_area :body, required: true, maxlength: 10_000, rows: 5, placeholder: "Tell us what happened...", class: "block w-full rounded-xl border-slate-300 dark:border-slate-700 dark:bg-slate-950" %>
      <%= form.submit "Send to support", class: "rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-bold text-white hover:bg-slate-700" %>
    <% end %>
  </div>

  <% if @support_threads.present? %>
    <div class="rounded-3xl border border-slate-200 bg-white px-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <h2 class="pt-6 text-lg font-extrabold text-slate-900 dark:text-white">Your conversations</h2>
      <div class="mt-3 divide-y divide-slate-100 dark:divide-slate-800">
        <% @support_threads.each do |thread| %>
          <%= link_to support_thread_path(thread), class: "block py-4 hover:bg-slate-50 dark:hover:bg-slate-800/50" do %>
            <div class="flex items-center justify-between gap-4">
              <span class="font-bold text-slate-900 dark:text-white"><%= thread.subject %></span>
              <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-bold text-slate-600 dark:bg-slate-800 dark:text-slate-300"><%= thread.status.humanize %></span>
            </div>
            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400"><%= thread.last_message_at&.strftime("%b %-d, %Y at %-I:%M %p") || "Just started" %></p>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
