<% content_for :title, "#{@support_thread.subject} | FamilyPlates Support" %>

<div class="max-w-3xl mx-auto py-6 sm:py-8 space-y-7">
  <div class="border-b border-slate-200 pb-6 dark:border-slate-800">
    <%= link_to "← All support conversations", support_threads_path, class: "text-xs font-bold text-primary-600 hover:underline dark:text-primary-400" %>
    <div class="mt-3 flex items-center justify-between gap-4">
      <h1 class="text-2xl font-extrabold text-slate-900 dark:text-white"><%= @support_thread.subject %></h1>
      <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-bold text-slate-600 dark:bg-slate-800 dark:text-slate-300"><%= @support_thread.status.humanize %></span>
    </div>
  </div>

  <div class="rounded-3xl border border-slate-200 bg-white px-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
    <div class="divide-y divide-slate-100 dark:divide-slate-800">
      <% @support_thread.messages.order(:created_at, :id).each do |message| %>
        <div class="py-5">
          <div class="flex items-center justify-between gap-4">
            <span class="text-sm font-bold text-slate-800 dark:text-slate-200"><%= message.platform_admin? ? "FamilyPlates Support" : "You" %></span>
            <time class="text-xs text-slate-500" datetime="<%= message.created_at.iso8601 %>"><%= message.created_at.strftime("%b %-d, %Y at %-I:%M %p") %></time>
          </div>
          <p class="mt-2 whitespace-pre-wrap text-sm text-slate-700 dark:text-slate-300"><%= message.body %></p>
        </div>
      <% end %>
    </div>
    <%= form_with url: support_thread_messages_path(@support_thread), scope: :support_message, class: "border-t border-slate-200 py-5 dark:border-slate-800" do |form| %>
      <%= form.text_area :body, required: true, maxlength: 10_000, rows: 4, placeholder: "Reply to support...", class: "block w-full rounded-xl border-slate-300 dark:border-slate-700 dark:bg-slate-950" %>
      <%= form.submit "Send reply", class: "mt-3 rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-bold text-white hover:bg-slate-700" %>
    <% end %>
  </div>
</div>
