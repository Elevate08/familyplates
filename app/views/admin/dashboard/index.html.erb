<div class="max-w-5xl mx-auto py-6 sm:py-8 space-y-8">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-200 pb-6">
    <div class="flex items-center gap-3.5">
      <div class="w-12 h-12 rounded-2xl bg-slate-900 text-white flex items-center justify-center shadow-md">
        <%= icon_tag("cog", css_class: "w-6 h-6") %>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Admin Control Center</h1>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-100 text-amber-800 border border-amber-200">
            Organizer Only
          </span>
        </div>
        <p class="text-xs text-slate-500 mt-0.5">Manage family roster, reset PINs, master account email, and kitchen feeds.</p>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <%= link_to root_path, class: "flex items-center gap-2 px-4 py-2.5 rounded-2xl bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 text-xs font-bold transition-all shadow-xs" do %>
        <%= icon_tag("arrow-right", css_class: "w-4 h-4 rotate-180") %>
        <span>Back to Kitchen</span>
      <% end %>
    </div>
  </div>

  <!-- Summary Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
    <!-- Household Card -->
    <div class="bg-white rounded-3xl border border-slate-200/80 p-6 shadow-xs flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between mb-3">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Household</span>
          <span class="text-lg">🏡</span>
        </div>
        <h2 class="text-xl font-extrabold text-slate-900 truncate"><%= @household.name %></h2>
        <p class="text-xs text-slate-500 mt-1"><%= @recipes_count %> recipes &bull; <%= @meal_plans_count %> weekly plans</p>
      </div>
      <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between">
        <%= link_to "Edit Name →", edit_admin_household_path, class: "text-xs font-bold text-primary-600 hover:text-primary-700" %>
      </div>
    </div>

    <!-- Master Login Card -->
    <div class="bg-white rounded-3xl border border-slate-200/80 p-6 shadow-xs flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between mb-3">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Primary Account</span>
          <span class="text-lg">🔐</span>
        </div>
        <h2 class="text-base font-extrabold text-slate-900 truncate" title="<%= @user.email_address %>">
          <%= @user.email_address %>
        </h2>
        <p class="text-xs text-slate-500 mt-1">Master email & password</p>
      </div>
      <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between">
        <%= link_to "Change Credentials →", edit_admin_account_path, class: "text-xs font-bold text-primary-600 hover:text-primary-700" %>
      </div>
    </div>

    <!-- Roster Summary Card -->
    <div class="bg-white rounded-3xl border border-slate-200/80 p-6 shadow-xs flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between mb-3">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Kitchen Roster</span>
          <span class="text-lg">👥</span>
        </div>
        <h2 class="text-2xl font-black text-slate-900"><%= @family_members.count %> Members</h2>
        <p class="text-xs text-slate-500 mt-1">
          <%= @family_members.count(&:admin?) %> Organizer(s), <%= @family_members.count { |m| !m.admin? } %> Regular Member(s)
        </p>
      </div>
      <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between">
        <%= link_to "Manage Roster →", admin_family_members_path, class: "text-xs font-bold text-primary-600 hover:text-primary-700" %>
      </div>
    </div>
  </div>

  <!-- Family Members & PIN Management Section -->
  <div class="bg-white rounded-3xl border border-slate-200/80 p-6 sm:p-8 shadow-xs">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h2 class="text-lg font-extrabold text-slate-900 tracking-tight">Family Members & PIN Security</h2>
        <p class="text-xs text-slate-500 mt-0.5">Control member roles, reset 4-digit PINs, and update profiles.</p>
      </div>
      <%= link_to admin_family_members_path, class: "px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold transition-colors shadow-xs" do %>
        <span>Manage Roster</span>
      <% end %>
    </div>

    <div class="divide-y divide-slate-100">
      <% @family_members.each do |member| %>
        <div class="py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
          <div class="flex items-center gap-3.5">
            <div class="w-11 h-11 rounded-2xl flex items-center justify-center text-white shadow-xs font-bold text-sm"
                 style="background-color: <%= member.avatar_color %>">
              <%= icon_tag(member.avatar_icon.presence || "chef-hat", css_class: "w-5 h-5") %>
            </div>
            <div>
              <div class="flex items-center gap-2">
                <span class="font-bold text-slate-900 text-sm"><%= member.name %></span>
                <% if member.admin? %>
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-amber-100 text-amber-800">Admin</span>
                <% else %>
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-slate-100 text-slate-600">Member</span>
                <% end %>
              </div>
              <div class="flex items-center gap-2 mt-0.5">
                <% if member.admin? %>
                  <% if member.pin.present? %>
                    <span class="text-xs text-emerald-600 font-medium flex items-center gap-1">
                      <span>🔒</span> PIN Protected
                    </span>
                  <% else %>
                    <span class="text-xs text-slate-400 font-medium">No PIN Set</span>
                  <% end %>
                <% else %>
                  <span class="text-xs text-slate-400">1-Tap Switch (No PIN)</span>
                <% end %>
              </div>
            </div>
          </div>

          <div class="flex items-center gap-2 self-end sm:self-auto">
            <%= link_to "Edit Profile", edit_admin_family_member_path(member), class: "px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition-colors" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Calendar Feed Token Management -->
  <div class="bg-white rounded-3xl border border-slate-200/80 p-6 sm:p-8 shadow-xs">
    <div class="flex items-start justify-between gap-4 mb-4">
      <div>
        <h2 class="text-lg font-extrabold text-slate-900 tracking-tight flex items-center gap-2">
          <%= icon_tag("calendar", css_class: "w-5 h-5 text-primary-500") %>
          <span>Calendar Feed Integration (.ics)</span>
        </h2>
        <p class="text-xs text-slate-500 mt-1">
          Sync your weekly dinner schedule directly to Apple Calendar, Google Calendar, or Outlook.
        </p>
      </div>
      <%= button_to regenerate_calendar_token_admin_household_path, method: :post,
            data: { turbo_confirm: "Are you sure you want to regenerate the calendar token? Any existing calendar subscriptions will need the new URL." },
            class: "px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-rose-50 hover:text-rose-600 text-slate-700 text-xs font-bold transition-colors cursor-pointer" do %>
        <span>Regenerate Token</span>
      <% end %>
    </div>

    <div class="bg-slate-50 rounded-2xl p-4 border border-slate-200/80">
      <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1.5">Live Subscription URL</label>
      <div class="flex items-center gap-2">
        <input type="text" readonly value="<%= calendar_feed_url(@household.calendar_token) %>" 
               class="w-full bg-white px-3.5 py-2 rounded-xl border border-slate-200 text-xs font-mono text-slate-700 focus:outline-none select-all">
      </div>
    </div>
  </div>
</div>
