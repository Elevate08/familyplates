<div class="hearth-settings max-w-2xl mx-auto py-6 sm:py-8 space-y-8">
  <%= render "shared/household_tabs" %>
  <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-4">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-2xl bg-primary-50 dark:bg-primary-950/60 text-primary-600 dark:text-primary-400 flex items-center justify-center shadow-xs">
        <span class="text-xl">🏡</span>
      </div>
      <div>
        <h1 class="text-2xl font-extrabold text-slate-900 dark:text-white tracking-tight">Household & Meal Schedule</h1>
        <p class="text-xs text-slate-500 dark:text-slate-400">Configure kitchen branding and default breakfast, lunch, and dinner times</p>
      </div>
    </div>
    <%= link_to "← Admin Dashboard", admin_root_path, class: "text-xs font-bold text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors" %>
  </div>

  <div class="bg-cream dark:bg-slate-900 rounded-3xl border border-slate-200/80 dark:border-slate-800 p-6 sm:p-8 shadow-xs">
    <%= form_with model: @household, url: admin_household_path, method: :patch, class: "space-y-8" do |f| %>
      <% if @household.errors.any? %>
        <div class="p-4 rounded-2xl bg-rose-50 dark:bg-rose-950/60 border border-rose-200 dark:border-rose-800 text-rose-800 dark:text-rose-300 text-xs">
          <p class="font-bold mb-1">Please fix the following issues:</p>
          <ul class="list-disc list-inside space-y-0.5">
            <% @household.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :name, "Household / Family Kitchen Name", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5" %>
        <%= f.text_field :name, required: true,
              class: "w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-cream dark:bg-slate-800 text-slate-900 dark:text-white font-semibold text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" %>
        <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">This name displays in your navigation bar and calendar feeds.</p>
      </div>

      <div class="pt-6 border-t border-slate-100 dark:border-slate-800">
        <h2 class="text-sm font-extrabold text-slate-900 dark:text-white mb-1 flex items-center gap-2">
          <span>🌍</span>
          <span>Kitchen Time Zone</span>
        </h2>
        <p class="text-xs text-slate-500 dark:text-slate-400 mb-4">
          The clock your meal times are read against. It decides which day is “today” and which meal Cook Mode opens.
          <% if @household.time_zone.blank? %>
            Not set yet, so times are read as UTC — the first device to open FamilyPlates will fill this in.
          <% end %>
        </p>

        <%= f.label :time_zone, "Time Zone", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1" %>
        <%= f.time_zone_select :time_zone, ActiveSupport::TimeZone.all,
              { include_blank: "Use UTC", default: nil },
              class: "themed-select w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-cream dark:bg-slate-800 text-slate-900 dark:text-white font-semibold text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" %>
        <p class="text-[10px] text-slate-400 dark:text-slate-500 mt-1">
          Stored times stay in UTC; this only changes how they are read, and daylight saving is applied automatically.
        </p>
      </div>

      <div class="pt-6 border-t border-slate-100 dark:border-slate-800">
        <h2 class="text-sm font-extrabold text-slate-900 dark:text-white mb-1 flex items-center gap-2">
          <span>⏰</span>
          <span>Default Meal Schedule Times</span>
        </h2>
        <p class="text-xs text-slate-500 dark:text-slate-400 mb-4">
          When meals are scheduled and synced to calendars, these hours determine when breakfast, lunch, and dinner events appear.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <%= f.label :breakfast_time, "Breakfast Start", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1" %>
            <%= f.time_field :breakfast_time, value: (@household.breakfast_time.presence || "08:00"),
                  class: "w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-cream dark:bg-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" %>
            <span class="text-[10px] text-slate-400 dark:text-slate-500 mt-0.5 block">Duration: 45 min</span>
          </div>

          <div>
            <%= f.label :lunch_time, "Lunch Start", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1" %>
            <%= f.time_field :lunch_time, value: (@household.lunch_time.presence || "12:30"),
                  class: "w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-cream dark:bg-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" %>
            <span class="text-[10px] text-slate-400 dark:text-slate-500 mt-0.5 block">Duration: 45 min</span>
          </div>

          <div>
            <%= f.label :dinner_time, "Dinner Start", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1" %>
            <%= f.time_field :dinner_time, value: (@household.dinner_time.presence || "18:00"),
                  class: "w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-cream dark:bg-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" %>
            <span class="text-[10px] text-slate-400 dark:text-slate-500 mt-0.5 block">Duration: 60 min</span>
          </div>
        </div>
      </div>

      <div class="pt-6 border-t border-slate-100 dark:border-slate-800">
        <h2 class="text-sm font-extrabold text-slate-900 dark:text-white mb-1 flex items-center gap-2">
          <span>🛒</span>
          <span>Shopping</span>
        </h2>
        <p class="text-xs text-slate-500 dark:text-slate-400 mb-4">
          How often you shop. The Groceries tab opens to the current shopping period, from one shopping day to the day before the next.
        </p>

        <% monthly = @household.shopping_frequency == "monthly" %>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" data-controller="shopping-day">
          <div>
            <%= f.label :shopping_frequency, "How often", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1" %>
            <%= f.select :shopping_frequency,
                  [ [ "Every week", "weekly" ], [ "Every 2 weeks", "fortnightly" ], [ "Every month", "monthly" ] ],
                  {},
                  class: "themed-select w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-cream dark:bg-slate-800 text-slate-900 dark:text-white font-semibold text-sm focus:outline-none focus:ring-2 focus:ring-primary-500",
                  data: { shopping_day_target: "frequency", action: "change->shopping-day#toggle" } %>
          </div>

          <div>
            <div data-shopping-day-target="weekday" <% if monthly %>hidden<% end %>>
              <fieldset class="hearth-weekdays">
                <legend class="mb-2 text-sm font-semibold">A day you shop</legend>
                <div class="flex flex-wrap gap-2">
                  <% ShoppingSchedule.weekday_choices.each do |name, value| %>
                    <label class="cursor-pointer">
                      <%= f.radio_button :shopping_wday, value, disabled: monthly, class: "sr-only peer", aria: { label: name } %>
                      <span class="block rounded-full border border-line bg-cream px-3 py-2 text-sm text-forest peer-checked:bg-primary-500 peer-checked:text-white peer-checked:border-primary-500 peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 dark:bg-slate-800 dark:text-slate-200 dark:border-slate-600 dark:peer-checked:bg-primary-500"><%= name.first(3) %></span>
                    </label>
                  <% end %>
                </div>
              </fieldset>
              <span class="text-[10px] text-slate-400 dark:text-slate-500 mt-0.5 block">Every week, the list runs from this day to the day before it next week. Every 2 weeks, you shop this same day, every other week.</span>
            </div>

            <div data-shopping-day-target="monthday" <% unless monthly %>hidden<% end %>>
              <%= f.label :shopping_month_day, "A day you shop", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1" %>
              <%= f.select :shopping_month_day, ShoppingSchedule.month_day_choices, {},
                    disabled: !monthly,
                    class: "themed-select w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-cream dark:bg-slate-800 text-slate-900 dark:text-white font-semibold text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" %>
              <span class="text-[10px] text-slate-400 dark:text-slate-500 mt-0.5 block">The list runs from this day of the month to the day before it next month. A 29th, 30th, or 31st falls on the last day of a shorter month.</span>
            </div>
          </div>
        </div>
      </div>

      <div class="pt-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 border-t border-slate-100 dark:border-slate-800">
        <%= link_to "Cancel", admin_root_path, class: "text-xs font-bold text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white text-center sm:text-left transition-colors" %>
        
        <div class="flex items-center gap-2">
          <%= f.submit "Save Household Settings", class: "w-full sm:w-auto py-2.5 px-6 rounded-full bg-primary-600 hover:bg-primary-500 text-white font-bold text-sm shadow-sm cursor-pointer transition-all" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
