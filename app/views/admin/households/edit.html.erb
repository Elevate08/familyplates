<div class="max-w-2xl mx-auto py-6 sm:py-8 space-y-8" 
     data-controller="calendar-sync"
     data-calendar-sync-test-url-value="<%= test_google_calendar_admin_household_path %>"
     data-calendar-sync-sync-url-value="<%= sync_google_calendar_admin_household_path %>">

  <!-- Header -->
  <div class="flex items-center justify-between border-b border-slate-200 pb-4">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-2xl bg-primary-50 text-primary-600 flex items-center justify-center shadow-xs">
        <span class="text-xl">🏡</span>
      </div>
      <div>
        <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Household & Calendar Settings</h1>
        <p class="text-xs text-slate-500">Configure kitchen branding, meal schedule hours, and real-time Google Calendar sync</p>
      </div>
    </div>
    <%= link_to "Admin Dashboard", admin_root_path, class: "text-xs font-bold text-slate-500 hover:text-slate-900" %>
  </div>

  <!-- Settings Form -->
  <div class="bg-white rounded-3xl border border-slate-200/80 p-6 sm:p-8 shadow-xs">
    <%= form_with model: @household, url: admin_household_path, method: :patch, class: "space-y-8" do |f| %>
      <% if @household.errors.any? %>
        <div class="p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-xs">
          <p class="font-bold mb-1">Please fix the following issues:</p>
          <ul class="list-disc list-inside space-y-0.5">
            <% @household.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <!-- Section 1: Household Name -->
      <div>
        <%= f.label :name, "Household / Family Name", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5" %>
        <%= f.text_field :name, required: true,
              class: "w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" %>
        <p class="text-xs text-slate-400 mt-1">This name displays in your navigation bar and calendar feeds.</p>
      </div>

      <!-- Section 2: Meal Schedule Times -->
      <div class="pt-6 border-t border-slate-100">
        <h2 class="text-sm font-extrabold text-slate-900 mb-1 flex items-center gap-2">
          <span>⏰</span>
          <span>Default Meal Schedule Times</span>
        </h2>
        <p class="text-xs text-slate-500 mb-4">
          When meals are synced to Google Calendar, these hours determine when breakfast, lunch, and dinner events appear.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <%= f.label :breakfast_time, "Breakfast Start", class: "block text-xs font-bold text-slate-700 mb-1" %>
            <%= f.time_field :breakfast_time, value: (@household.breakfast_time.presence || "08:00"),
                  class: "w-full px-3 py-2 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" %>
            <span class="text-[10px] text-slate-400 mt-0.5 block">Duration: 45 min</span>
          </div>

          <div>
            <%= f.label :lunch_time, "Lunch Start", class: "block text-xs font-bold text-slate-700 mb-1" %>
            <%= f.time_field :lunch_time, value: (@household.lunch_time.presence || "12:30"),
                  class: "w-full px-3 py-2 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" %>
            <span class="text-[10px] text-slate-400 mt-0.5 block">Duration: 45 min</span>
          </div>

          <div>
            <%= f.label :dinner_time, "Dinner Start", class: "block text-xs font-bold text-slate-700 mb-1" %>
            <%= f.time_field :dinner_time, value: (@household.dinner_time.presence || "18:00"),
                  class: "w-full px-3 py-2 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" %>
            <span class="text-[10px] text-slate-400 mt-0.5 block">Duration: 60 min</span>
          </div>
        </div>
      </div>

      <!-- Section 3: Google Calendar Real-Time Sync -->
      <div class="pt-6 border-t border-slate-100 space-y-5">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-sm font-extrabold text-slate-900 flex items-center gap-2">
              <span>📅</span>
              <span>Google Calendar Direct Sync</span>
            </h2>
            <p class="text-xs text-slate-500 mt-0.5">Automatically write meal events directly into your family's Google Calendar.</p>
          </div>

          <label class="relative inline-flex items-center cursor-pointer">
            <%= f.check_box :google_calendar_enabled, class: "sr-only peer" %>
            <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary-600"></div>
          </label>
        </div>

        <!-- Step 1: Service Account Credentials JSON -->
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <%= f.label :google_service_account_json, "Step 1: Service Account JSON Key", class: "block text-xs font-bold uppercase tracking-wider text-slate-700" %>
            <% if GoogleCalendarService.configured?(@household) %>
              <span class="inline-flex items-center gap-1 text-[11px] font-bold text-emerald-600">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                Key Configured
              </span>
            <% else %>
              <span class="inline-flex items-center gap-1 text-[11px] font-bold text-amber-600">
                ⚠️ Key Required
              </span>
            <% end %>
          </div>
          <%= f.text_area :google_service_account_json, rows: 4, placeholder: 'Paste the contents of your downloaded Google Service Account JSON file here (starts with {"type": "service_account", ...})',
                class: "w-full font-mono text-xs px-3.5 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary-500" %>
          <p class="text-xs text-slate-400 mt-1">
            Generated from Google Cloud Console > IAM & Admin > Service Accounts > Keys > Create JSON Key.
          </p>
        </div>

        <!-- Step 2: Service Account Email Display -->
        <% service_email = GoogleCalendarService.service_account_email(@household) %>
        <% if service_email.present? %>
          <div class="p-4 rounded-2xl bg-emerald-50/80 border border-emerald-200/80 space-y-2">
            <p class="text-xs font-bold text-emerald-900 flex items-center gap-1.5">
              <span>🔑</span>
              <span>Step 2: Share Google Calendar with this Kitchen Bot Email</span>
            </p>
            <p class="text-xs text-emerald-800 leading-relaxed">
              In Google Calendar settings under <em>"Share with specific people or groups"</em>, add this email and set permission to <strong>"Make changes to events"</strong>:
            </p>
            <div class="flex items-center gap-2">
              <input type="text" readonly value="<%= service_email %>" id="service-account-email"
                     class="w-full font-mono text-xs px-3 py-2 bg-white rounded-xl border border-emerald-300 text-slate-800 select-all font-semibold">
              <button type="button" onclick="navigator.clipboard.writeText(document.getElementById('service-account-email').value); alert('Service Account email copied to clipboard!');"
                      class="px-3.5 py-2 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold rounded-xl transition-colors cursor-pointer shrink-0 shadow-xs">
                Copy Email
              </button>
            </div>
          </div>
        <% else %>
          <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 text-xs text-slate-600 space-y-1">
            <p class="font-bold text-slate-800">Step 2: Share Calendar</p>
            <p>Once you paste and save your Service Account JSON above, your unique kitchen bot email will display here for 1-click sharing.</p>
          </div>
        <% end %>

        <!-- Step 3: Google Calendar ID -->
        <div>
          <%= f.label :google_calendar_id, "Step 3: Google Calendar ID", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5" %>
          <%= f.text_field :google_calendar_id, placeholder: "e.g. primary or yourfamily@group.calendar.google.com",
                data: { "calendar-sync-target": "calendarIdInput" },
                class: "w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-primary-500" %>
          <p class="text-xs text-slate-400 mt-1">Found under Google Calendar Settings > Integrate Calendar > Calendar ID (use <code>primary</code> for your main calendar).</p>
        </div>
      </div>

      <!-- Form Submit & Action Buttons -->
      <div class="pt-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 border-t border-slate-100">
        <%= link_to "Back", admin_root_path, class: "text-xs font-bold text-slate-500 hover:text-slate-900 text-center sm:text-left" %>
        
        <div class="flex items-center gap-2">
          <%= f.submit "Save Settings", class: "w-full sm:w-auto py-2.5 px-6 rounded-xl bg-primary-600 hover:bg-primary-500 text-white font-bold text-sm shadow-sm cursor-pointer transition-all" %>
        </div>
      </div>
    <% end %>

    <!-- Separate Utility Actions with Pulsing Status and Progress Bar -->
    <div class="mt-8 pt-6 border-t border-slate-200/80 space-y-4">
      <div class="flex flex-wrap items-center gap-3">
        <!-- Test Connection Button -->
        <button type="button"
                data-calendar-sync-target="testButton"
                data-action="click->calendar-sync#testConnection"
                class="px-4 py-2 rounded-xl border border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-700 text-xs font-bold transition-colors cursor-pointer inline-flex items-center gap-1.5 shadow-2xs">
          <span>🔍</span>
          <span>Test Google Calendar Connection</span>
        </button>

        <!-- Sync Now Button -->
        <button type="button"
                data-calendar-sync-target="syncButton"
                data-action="click->calendar-sync#syncPlan"
                class="px-4 py-2 rounded-xl border border-primary-200 bg-primary-50 hover:bg-primary-100 text-primary-700 text-xs font-bold transition-colors cursor-pointer inline-flex items-center gap-1.5 shadow-2xs">
          <span>🔄</span>
          <span>Sync Current Meal Plan Now</span>
        </button>
      </div>

      <!-- Pulsing Light Indicator for Test Connection -->
      <div data-calendar-sync-target="testStatus" class="hidden"></div>

      <!-- Animated Progress Bar for Sync -->
      <div data-calendar-sync-target="syncContainer" class="hidden p-4 rounded-2xl bg-slate-50 border border-slate-200 space-y-2 animate-in fade-in">
        <div class="flex items-center justify-between text-xs font-semibold text-slate-700">
          <span data-calendar-sync-target="progressText">Syncing meal slots to Google Calendar...</span>
        </div>
        <div class="w-full bg-slate-200 rounded-full h-2.5 overflow-hidden">
          <div data-calendar-sync-target="progressBar" class="bg-blue-600 h-2.5 rounded-full transition-all duration-300 ease-out" style="width: 0%"></div>
        </div>
      </div>
    </div>
  </div>
</div>
