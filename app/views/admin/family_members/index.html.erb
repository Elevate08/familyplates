<div class="max-w-4xl mx-auto py-6 sm:py-8 space-y-8">
  <!-- Header -->
  <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-6">
    <div class="flex items-center gap-3.5">
      <div class="w-12 h-12 rounded-2xl bg-primary-50 dark:bg-primary-950/60 text-primary-600 dark:text-primary-400 flex items-center justify-center shadow-xs">
        <%= icon_tag("users", css_class: "w-6 h-6") %>
      </div>
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Family Kitchen Roster</h1>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Manage family profiles, assign organizer roles, and manage PIN codes.</p>
      </div>
    </div>
    <%= link_to admin_root_path, class: "px-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-bold transition-colors" do %>
      <span>Admin Dashboard</span>
    <% end %>
  </div>

  <!-- Members List Card -->
  <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/80 dark:border-slate-800 p-6 sm:p-8 shadow-xs">
    <h2 class="text-lg font-extrabold text-slate-900 dark:text-white mb-6">Current Members (<%= @family_members.count %>)</h2>

    <div class="space-y-4">
      <% @family_members.each do |member| %>
        <div class="p-4 sm:p-5 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/70 dark:border-slate-700 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <div class="flex items-center gap-3.5">
            <div class="w-12 h-12 rounded-2xl flex items-center justify-center text-white shadow-xs font-bold"
                 style="background-color: <%= member.avatar_color %>">
              <%= icon_tag(member.avatar_icon.presence || "chef-hat", css_class: "w-6 h-6") %>
            </div>
            <div>
              <div class="flex items-center gap-2">
                <h3 class="font-bold text-slate-900 dark:text-white text-base"><%= member.name %></h3>
                <% if member.admin? %>
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-amber-100 dark:bg-amber-950/80 text-amber-800 dark:text-amber-300">Admin</span>
                <% else %>
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300">Member</span>
                <% end %>
                <% if member == current_family_member %>
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-primary-100 dark:bg-primary-950/80 text-primary-700 dark:text-primary-300">Active</span>
                <% end %>
              </div>
              <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                <% if member.admin? %>
                  <% if member.pin_digest.present? %>
                    <span class="text-emerald-700 dark:text-emerald-400 font-semibold">🔒 4-digit PIN Active</span>
                  <% else %>
                    <span class="text-slate-400 dark:text-slate-500">No PIN configured</span>
                  <% end %>
                <% else %>
                  <span class="text-slate-400 dark:text-slate-500">Standard Member (1-Tap Switch)</span>
                <% end %>
              </p>
            </div>
          </div>

          <!-- Actions -->
          <div class="flex items-center gap-2 self-end sm:self-auto flex-wrap">
            <% if member.admin? %>
              <!-- Quick PIN Reset Modal Trigger -->
              <div data-controller="modal" data-action="keydown.esc@window->modal#handleKeydown">
                <button type="button" data-action="click->modal#open" 
                        class="px-3 py-2 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-bold transition-colors cursor-pointer flex items-center gap-1.5 shadow-xs">
                  <%= icon_tag("key", css_class: "w-3.5 h-3.5 text-amber-500") %>
                  <span>Reset PIN</span>
                </button>

                <!-- PIN Reset Modal -->
                <div data-modal-target="dialog" class="hidden fixed inset-0 z-50 items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs animate-in fade-in duration-150">
                  <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 sm:p-8 max-w-sm w-full shadow-2xl border border-slate-100 dark:border-slate-800 text-center animate-in zoom-in-95 duration-150">
                    <div class="w-12 h-12 rounded-2xl bg-amber-100 dark:bg-amber-950/80 text-amber-700 dark:text-amber-300 flex items-center justify-center mx-auto mb-3 text-xl">
                      🔒
                    </div>
                    <h3 class="text-lg font-extrabold text-slate-900 dark:text-white mb-1">Reset PIN for <%= member.name %></h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mb-5 leading-relaxed">
                      Enter a new 4-digit PIN for this admin profile.
                    </p>

                    <%= form_with url: reset_pin_admin_family_member_path(member), method: :patch, class: "space-y-4" do %>
                      <div>
                        <input type="password" name="pin" maxlength="4" pattern="[0-9]*" inputmode="numeric" placeholder="4-digit PIN" required
                               class="w-full text-center text-xl font-mono tracking-widest px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500">
                      </div>

                      <div class="flex items-center justify-center gap-3">
                        <button type="button" data-action="click->modal#close" 
                                class="px-4 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 text-xs font-bold transition-colors cursor-pointer">
                          Cancel
                        </button>
                        <button type="submit" 
                                class="px-5 py-2.5 rounded-xl bg-primary-600 hover:bg-primary-500 text-white text-xs font-bold shadow-sm transition-colors cursor-pointer">
                          Save PIN
                        </button>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>

            <%= link_to "Edit", edit_admin_family_member_path(member), 
                  class: "px-3 py-2 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-bold transition-colors shadow-xs" %>

            <% if @family_members.count > 1 %>
              <div data-controller="modal" data-action="keydown.esc@window->modal#handleKeydown">
                <button type="button" data-action="click->modal#open"
                        class="p-2 rounded-xl text-slate-400 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-colors cursor-pointer"
                        title="Remove <%= member.name %>">
                  <%= icon_tag("trash", css_class: "w-4 h-4") %>
                </button>

                <!-- Delete Modal -->
                <div data-modal-target="dialog" class="hidden fixed inset-0 z-50 items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs animate-in fade-in duration-150">
                  <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 sm:p-8 max-w-sm w-full shadow-2xl border border-slate-100 dark:border-slate-800 text-center animate-in zoom-in-95 duration-150">
                    <div class="w-12 h-12 rounded-2xl bg-rose-100 dark:bg-rose-950/80 text-rose-600 dark:text-rose-400 flex items-center justify-center mx-auto mb-3">
                      <%= icon_tag("trash", css_class: "w-6 h-6") %>
                    </div>
                    <h3 class="text-lg font-extrabold text-slate-900 dark:text-white mb-1.5">Remove <%= member.name %>?</h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mb-5 leading-relaxed">
                      Are you sure you want to remove <strong><%= member.name %></strong> from the family kitchen roster?
                    </p>

                    <div class="flex items-center justify-center gap-3">
                      <button type="button" data-action="click->modal#close" 
                              class="px-4 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 text-xs font-bold transition-colors cursor-pointer">
                        Cancel
                      </button>
                      <%= button_to admin_family_member_path(member), method: :delete,
                            class: "px-4 py-2 rounded-xl bg-rose-600 hover:bg-rose-500 text-white text-xs font-bold shadow-sm transition-colors cursor-pointer inline-flex items-center gap-1.5" do %>
                        <%= icon_tag("trash", css_class: "w-3.5 h-3.5") %>
                        <span>Remove</span>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Add Member Card -->
  <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/80 dark:border-slate-800 p-6 sm:p-8 shadow-xs">
    <h2 class="text-lg font-extrabold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
      <%= icon_tag("plus", css_class: "w-5 h-5 text-primary-500") %>
      <span>Add New Family Member</span>
    </h2>

    <%= form_with model: @new_member, url: admin_family_members_path, class: "space-y-6" do |f| %>
      <% if @new_member.errors.any? %>
        <div class="p-4 rounded-2xl bg-rose-50 dark:bg-rose-950/60 border border-rose-200 dark:border-rose-800 text-rose-800 dark:text-rose-300 text-xs">
          <p class="font-bold mb-1">Please fix the following issues:</p>
          <ul class="list-disc list-inside space-y-0.5">
            <% @new_member.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :name, "Name or Nickname", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5" %>
          <%= f.text_field :name, placeholder: "e.g. Leo, Alex, Grandma", required: true,
                class: "w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" %>
        </div>

        <div>
          <%= f.label :role, "Kitchen Role", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5" %>
          <%= f.select :role, [["Family Member (1-Tap Switching)", "member"], ["Organizer / Parent (Admin)", "admin"]], {},
                class: "themed-select w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" %>
        </div>
      </div>

      <!-- Icon Picker -->
      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">Avatar Icon</label>
        <div class="grid grid-cols-4 sm:grid-cols-8 gap-2.5">
          <% FamilyMember::AVATAR_ICONS.each_with_index do |icon_name, idx| %>
            <label class="cursor-pointer group flex flex-col items-center">
              <%= f.radio_button :avatar_icon, icon_name, checked: (idx == 0), class: "sr-only peer" %>
              <div class="w-11 h-11 rounded-2xl border-2 border-slate-200 dark:border-slate-700 peer-checked:border-slate-900 dark:peer-checked:border-white peer-checked:bg-slate-900 dark:peer-checked:bg-white peer-checked:text-white dark:peer-checked:text-slate-900 text-slate-600 dark:text-slate-300 flex items-center justify-center transition-all group-hover:scale-105 shadow-xs">
                <%= icon_tag(icon_name, css_class: "w-5 h-5") %>
              </div>
              <span class="text-[10px] font-medium text-slate-400 dark:text-slate-500 mt-1 capitalize text-center truncate max-w-full">
                <%= icon_name.tr("-", " ") %>
              </span>
            </label>
          <% end %>
        </div>
      </div>

      <!-- Color Swatches -->
      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">Theme Accent Color</label>
        <div class="flex flex-wrap items-center gap-2.5">
          <% FamilyMember::AVATAR_COLORS.each_with_index do |color, idx| %>
            <label class="cursor-pointer">
              <%= f.radio_button :avatar_color, color, checked: (idx == 0), class: "sr-only peer" %>
              <span class="inline-block w-8 h-8 rounded-full shadow-xs peer-checked:ring-4 peer-checked:ring-offset-2 dark:peer-checked:ring-offset-slate-900 peer-checked:ring-slate-900 dark:peer-checked:ring-white peer-checked:scale-110 transition-all"
                    style="background-color: <%= color %>"></span>
            </label>
          <% end %>
        </div>
      </div>

      <div>
        <%= f.label :pin, "4-Digit PIN (Required if role is Admin)", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5" %>
        <div class="max-w-xs">
          <%= f.password_field :pin, maxlength: 4, placeholder: "e.g. 1234", pattern: "[0-9]*", inputmode: "numeric",
                class: "w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-sm font-mono tracking-widest focus:outline-none focus:ring-2 focus:ring-primary-500" %>
        </div>
        <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">Non-admin members will ignore this field automatically.</p>
      </div>

      <div class="pt-2">
        <%= f.submit "Add Member", class: "py-2.5 px-6 rounded-xl bg-primary-600 hover:bg-primary-500 text-white font-bold text-sm shadow-sm cursor-pointer transition-all" %>
      </div>
    <% end %>
  </div>
</div>
