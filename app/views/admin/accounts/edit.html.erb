<div class="max-w-xl mx-auto py-6 sm:py-8 space-y-6">
  <div class="flex items-center justify-between border-b border-slate-200 pb-4">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-2xl bg-amber-100 text-amber-800 flex items-center justify-center shadow-xs">
        <%= icon_tag("key", css_class: "w-5 h-5") %>
      </div>
      <div>
        <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Primary Master Account</h1>
        <p class="text-xs text-slate-500">Update kitchen login email & master password</p>
      </div>
    </div>
    <%= link_to "Cancel", admin_root_path, class: "text-xs font-bold text-slate-500 hover:text-slate-900" %>
  </div>

  <div class="bg-white rounded-3xl border border-slate-200/80 p-6 sm:p-8 shadow-xs">
    <%= form_with model: @user, url: admin_account_path, method: :patch, class: "space-y-6" do |f| %>
      <% if @user.errors.any? %>
        <div class="p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-xs">
          <p class="font-bold mb-1">Please fix the following issues:</p>
          <ul class="list-disc list-inside space-y-0.5">
            <% @user.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :email_address, "Primary Login Email Address", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5" %>
        <%= f.email_field :email_address, required: true, autocomplete: "email",
              class: "w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" %>
        <p class="text-xs text-slate-400 mt-1">This email is used to sign into the household on new devices.</p>
      </div>

      <div class="pt-4 border-t border-slate-100 space-y-4">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700">Change Master Password</h3>
        <p class="text-xs text-slate-400">Leave these fields blank if you do not wish to change the password.</p>

        <div>
          <%= f.label :password, "New Master Password", class: "block text-xs font-semibold text-slate-700 mb-1" %>
          <%= f.password_field :password, placeholder: "••••••••", autocomplete: "new-password", maxlength: 72,
                class: "w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" %>
        </div>

        <div>
          <%= f.label :password_confirmation, "Confirm New Password", class: "block text-xs font-semibold text-slate-700 mb-1" %>
          <%= f.password_field :password_confirmation, placeholder: "••••••••", autocomplete: "new-password", maxlength: 72,
                class: "w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" %>
        </div>
      </div>

      <div class="pt-4 flex items-center justify-between border-t border-slate-100">
        <%= link_to "Back", admin_root_path, class: "text-xs font-bold text-slate-500 hover:text-slate-900" %>
        <%= f.submit "Save Credentials", class: "py-2.5 px-6 rounded-xl bg-primary-600 hover:bg-primary-500 text-white font-bold text-sm shadow-sm cursor-pointer transition-all" %>
      </div>
    <% end %>
  </div>
</div>
