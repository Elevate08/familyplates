<% content_for :title, "Platform Operator Console | FamilyPlates" %>

<div class="max-w-6xl mx-auto py-6 sm:py-8 space-y-8">
  <div class="flex flex-col gap-4 border-b border-slate-200 dark:border-slate-800 pb-6 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-xs font-bold uppercase tracking-wider text-primary-600 dark:text-primary-400">Hosted operations</p>
      <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">Platform Operator Console</h1>
      <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">Signed in as <%= current_platform_admin.email %>.</p>
    </div>
    <%= button_to "Sign out", platform_admin_session_path, method: :delete, class: "rounded-xl border border-slate-300 px-4 py-2 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800" %>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Hosted households</p>
      <p class="mt-3 text-4xl font-black text-slate-900 dark:text-white"><%= @households_count %></p>
      <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">All household records in this deployment.</p>
    </div>
    <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Customer accounts</p>
      <p class="mt-3 text-4xl font-black text-slate-900 dark:text-white"><%= @users_count %></p>
      <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">User identities connected to households.</p>
    </div>
  </div>

  <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
    <div class="flex items-center justify-between gap-4">
      <div>
        <h2 class="text-lg font-extrabold text-slate-900 dark:text-white">Household operations</h2>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Inspect account metadata and feature counts without opening household content.</p>
      </div>
      <%= link_to "View all households", platform_admin_households_path, class: "shrink-0 rounded-xl bg-slate-900 px-4 py-2 text-sm font-bold text-white hover:bg-slate-700" %>
    </div>
    <div class="mt-5 divide-y divide-slate-100 dark:divide-slate-800">
      <% @recent_households.each do |household| %>
        <%= link_to platform_admin_household_path(household), class: "flex items-center justify-between gap-4 py-3 hover:bg-slate-50 dark:hover:bg-slate-800/50" do %>
          <span class="font-semibold text-slate-800 dark:text-slate-200"><%= household.name %></span>
          <span class="text-xs text-slate-500 dark:text-slate-400"><%= household.created_at.to_date %> <span aria-hidden="true">→</span></span>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
