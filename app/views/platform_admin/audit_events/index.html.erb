<% content_for :title, "Audit log | Platform Operator Console" %>

<div class="mx-auto max-w-6xl space-y-6 py-6 sm:py-8">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-slate-200 pb-6 dark:border-slate-800">
    <div>
      <%= link_to "← Console", platform_admin_root_path, class: "text-xs font-bold text-primary-600 hover:underline dark:text-primary-400" %>
      <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">Platform audit log</h1>
      <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">Recent operator actions, support updates, and lifecycle changes. Sensitive values are intentionally omitted.</p>
    </div>
    <div class="flex items-center gap-2 shrink-0">
      <span class="inline-flex items-center px-3 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-xs font-bold text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 shadow-2xs">
        Showing <%= @events.size %> of <%= @filtered_count %> events
        <% if @filtered_count != @total_count %>
          <span class="ml-1 text-slate-400 font-normal">(from <%= @total_count %> total)</span>
        <% end %>
      </span>
    </div>
  </div>

  <!-- Filter & Search Panel -->
  <div class="space-y-3">
    <!-- Category Tabs -->
    <div class="flex flex-wrap items-center gap-1.5">
      <% categories = [
           ["all", "All Activity"],
           ["changes", "Changes & Mutations Only"],
           ["households", "Households"],
           ["support", "Support"],
           ["auth", "Auth & Security"],
           ["promotions", "Promotions"]
         ] %>
      <% categories.each do |cat_key, label| %>
        <% is_active = (@category == cat_key) %>
        <%= link_to label,
              platform_admin_audit_events_path(category: cat_key, action_name: @action_name, admin_id: @admin_id, q: @query, hide_views: @hide_views ? "1" : nil),
              class: "px-3 py-1.5 rounded-xl text-xs font-bold transition-all #{is_active ? 'bg-slate-900 text-white dark:bg-white dark:text-slate-900 shadow-2xs' : 'bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800'}" %>
      <% end %>
    </div>

    <!-- Filter Form -->
    <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-4 shadow-xs">
      <%= form_with url: platform_admin_audit_events_path, method: :get, class: "space-y-3" do |f| %>
        <%= f.hidden_field :category, value: @category %>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5">
          <!-- Text Search -->
          <div>
            <%= f.text_field :q, value: @query, placeholder: "Search actions, targets, IPs, metadata...",
                  class: "w-full px-3 py-2 text-xs rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-primary-500" %>
          </div>

          <!-- Action Dropdown -->
          <div>
            <%= f.select :action_name, options_for_select([["All Specific Actions", ""]] + @available_actions.map { |a| [a.tr(".", " ").humanize, a] }, @action_name),
                  {},
                  class: "w-full px-3 py-2 text-xs rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500" %>
          </div>

          <!-- Operator Dropdown -->
          <div>
            <%= f.select :admin_id, options_for_select([["All Operators", ""]] + @platform_admins.map { |adm| [adm.email, adm.id] }, @admin_id),
                  {},
                  class: "w-full px-3 py-2 text-xs rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500" %>
          </div>

          <!-- Action Buttons & Quick Toggle -->
          <div class="flex items-center justify-between sm:justify-end gap-2">
            <button type="submit" class="px-4 py-2 rounded-xl bg-slate-900 dark:bg-slate-100 hover:bg-slate-800 dark:hover:bg-white text-white dark:text-slate-900 text-xs font-bold transition-colors cursor-pointer shadow-2xs">
              Filter
            </button>
            <% if @filters_active %>
              <%= link_to "Clear filters", platform_admin_audit_events_path, class: "px-3 py-2 rounded-xl text-xs font-bold text-slate-500 hover:text-slate-900 dark:hover:text-white transition-colors" %>
            <% end %>
          </div>
        </div>

        <!-- Hide Page Views Toggle -->
        <% if @category != "changes" %>
          <div class="pt-2 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
            <label class="inline-flex items-center gap-2 cursor-pointer select-none text-xs font-medium text-slate-600 dark:text-slate-400">
              <%= f.check_box :hide_views, { checked: @hide_views, onchange: "this.form.submit();", class: "w-4 h-4 rounded text-primary-600 focus:ring-primary-500 border-slate-300 dark:border-slate-700 cursor-pointer" }, "1", "0" %>
              <span>Hide page views (read events like <code>household.viewed</code>)</span>
            </label>
            <% if @hide_views %>
              <span class="text-[11px] font-semibold text-amber-600 dark:text-amber-400">Filtered: Showing actions only</span>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Audit Events List -->
  <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
    <div class="divide-y divide-slate-100 dark:divide-slate-800">
      <% @events.each do |event| %>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-4 sm:p-5 hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors">
          <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4 min-w-0">
            <!-- Timestamp -->
            <time class="text-xs font-mono text-slate-400 dark:text-slate-500 shrink-0 w-36" datetime="<%= event.created_at.iso8601 %>">
              <%= event.created_at.strftime("%b %-d, %Y %-I:%M %p") %>
            </time>

            <!-- Action Badge & Target -->
            <div class="space-y-1 min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-extrabold border shadow-2xs <%= platform_audit_action_badge_classes(event) %>" data-audit-action="<%= event.action %>">
                  <%= event.action.to_s.tr(".", " ").humanize %>
                </span>

                <span class="text-xs text-slate-600 dark:text-slate-400 truncate">
                  <% if event.target_type == "Household" && event.target_id.present? %>
                    <%= link_to "Household ##{event.target_id}", platform_admin_household_path(event.target_id), class: "font-bold text-slate-800 dark:text-slate-200 hover:text-primary-600 dark:hover:text-primary-400 hover:underline" %>
                  <% elsif event.target_type == "SupportThread" && event.target_id.present? %>
                    <%= link_to "Support Thread ##{event.target_id}", platform_admin_support_thread_path(event.target_id), class: "font-bold text-slate-800 dark:text-slate-200 hover:text-primary-600 dark:hover:text-primary-400 hover:underline" %>
                  <% elsif event.target_type.present? %>
                    <span class="font-bold text-slate-800 dark:text-slate-200"><%= event.target_type %></span> <span class="font-mono text-[11px] text-slate-400">#<%= event.target_id %></span>
                  <% else %>
                    <span class="text-slate-400 font-medium">Platform Access</span>
                  <% end %>
                </span>
              </div>

              <!-- Metadata details if present -->
              <% if event.metadata.present? && event.metadata.is_a?(Hash) && event.metadata.compact.any? %>
                <div class="flex flex-wrap items-center gap-1.5 pt-0.5">
                  <% event.metadata.each do |key, val| %>
                    <% next if val.blank? %>
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-[10px] font-mono text-slate-600 dark:text-slate-400">
                      <span class="font-semibold text-slate-500"><%= key %>:</span>
                      <span class="text-slate-800 dark:text-slate-200 font-bold truncate max-w-[200px]"><%= val %></span>
                    </span>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>

          <!-- Operator & IP -->
          <div class="text-left sm:text-right shrink-0">
            <p class="text-xs font-bold text-slate-700 dark:text-slate-300">
              <%= event.platform_admin&.email || "System / Public" %>
            </p>
            <% if event.ip_address.present? %>
              <p class="text-[10px] font-mono text-slate-400 dark:text-slate-500">
                IP: <%= event.ip_address %>
              </p>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if @events.empty? %>
        <div class="px-5 py-16 text-center">
          <div class="mx-auto w-12 h-12 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-xl mb-3">
            🔍
          </div>
          <p class="text-sm font-bold text-slate-800 dark:text-slate-200">No audit events match your filters</p>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Try selecting a different category or clearing search parameters.</p>
          <% if @filters_active %>
            <div class="mt-4">
              <%= link_to "Clear all filters", platform_admin_audit_events_path, class: "inline-flex px-4 py-2 rounded-xl bg-primary-600 hover:bg-primary-500 text-white text-xs font-bold transition-colors cursor-pointer shadow-sm" %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
