<% content_for :title, "Households | Platform Operator Console" %>

<div class="space-y-6">
  <!-- Page Header & Filter Toolbar -->
  <div class="flex flex-col gap-4 border-b border-slate-200 pb-6 dark:border-slate-800 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <div class="flex items-center gap-2.5">
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">Households</h1>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300">
          <%= @total_count %> total
        </span>
      </div>
      <p class="mt-1.5 text-sm text-slate-500 dark:text-slate-400">
        Account lifecycle, customer subscriptions, promotions, and access periods across hosted households.
      </p>

      <!-- Stat Badges -->
      <div class="mt-3 flex flex-wrap items-center gap-2 text-xs">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-emerald-50 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 font-semibold">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <%= @total_count - @suspended_count %> Active
        </span>
        <% if @suspended_count > 0 %>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-rose-50 text-rose-700 dark:bg-rose-950/60 dark:text-rose-300 border border-rose-200 dark:border-rose-800 font-semibold">
            <span class="w-2 h-2 rounded-full bg-rose-500"></span>
            <%= @suspended_count %> Suspended
          </span>
        <% end %>
        <% if @with_promo_count > 0 %>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-purple-50 text-purple-700 dark:bg-purple-950/60 dark:text-purple-300 border border-purple-200 dark:border-purple-800 font-semibold">
            <%= icon_tag("tag", css_class: "w-3 h-3") %>
            <%= @with_promo_count %> with Promo
          </span>
        <% end %>
      </div>
    </div>

    <!-- Search & Filters -->
    <%= form_with url: platform_admin_households_path, method: :get, class: "flex flex-wrap items-center gap-2.5" do |form| %>
      <div class="relative">
        <%= form.search_field :search, value: @search, placeholder: "Search name, email, promo...", class: "w-64 sm:w-72 rounded-xl border border-slate-300 px-3.5 py-2 text-sm shadow-2xs dark:border-slate-700 dark:bg-slate-900 dark:text-white placeholder:text-slate-400" %>
      </div>
      <%= form.select :status, options_for_select([["All statuses", ""], ["Active", "active"], ["Suspended", "suspended"]], @status), {}, class: "rounded-xl border border-slate-300 px-3 py-2 text-sm shadow-2xs dark:border-slate-700 dark:bg-slate-900 dark:text-white" %>
      <%= form.submit "Filter", class: "rounded-xl bg-slate-900 px-4 py-2 text-sm font-bold text-white hover:bg-slate-800 shadow-2xs cursor-pointer transition-colors" %>
      <% if @search.present? || @status.present? %>
        <%= link_to "Clear", platform_admin_households_path, class: "px-2.5 py-2 text-xs font-semibold text-slate-500 hover:text-slate-800 dark:hover:text-slate-200" %>
      <% end %>
    <% end %>
  </div>

  <!-- Households Table -->
  <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
    <!-- Desktop Table Header -->
    <div class="hidden grid-cols-[minmax(0,2.5fr)_minmax(0,1.2fr)_minmax(0,1.5fr)_minmax(0,1.5fr)_minmax(0,1fr)_minmax(0,1fr)_auto] gap-4 border-b border-slate-200 px-6 py-3.5 text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:border-slate-800 dark:text-slate-400 lg:grid">
      <span>Household / Customer</span>
      <span>Joined</span>
      <span>Plan & Status</span>
      <span>Renewal / Expiration</span>
      <span>Promotion</span>
      <span>Last Activity</span>
      <span class="w-5"></span>
    </div>

    <!-- Rows -->
    <div class="divide-y divide-slate-100 dark:divide-slate-800">
      <% @households.each do |household| %>
        <%
          status = household.subscription_status
          expires_at = household.subscription_expires_at
          label = household.subscription_billing_label
          promo = household.applied_promotion_code
          last_activity = household.activity_events.maximum(:created_at)
        %>
        <%= link_to platform_admin_household_path(household), class: "group grid gap-3 px-5 py-4 transition-colors hover:bg-slate-50 dark:hover:bg-slate-800/50 lg:grid-cols-[minmax(0,2.5fr)_minmax(0,1.2fr)_minmax(0,1.5fr)_minmax(0,1.5fr)_minmax(0,1fr)_minmax(0,1fr)_auto] lg:items-center lg:gap-4 lg:px-6" do %>

          <!-- 1. Household & Customer -->
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <p class="truncate font-bold text-slate-900 group-hover:text-primary-600 dark:text-white dark:group-hover:text-primary-400 transition-colors">
                <%= household.name %>
              </p>
              <% if household.suspended? %>
                <span class="shrink-0 inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-300">
                  Suspended
                </span>
              <% end %>
            </div>
            <p class="truncate text-xs text-slate-500 dark:text-slate-400 mt-0.5">
              <%= household.email.presence || "No customer email" %>
            </p>
          </div>

          <!-- 2. Joined Date -->
          <div class="text-xs">
            <span class="lg:hidden text-slate-400 font-semibold">Joined: </span>
            <span class="font-medium text-slate-700 dark:text-slate-300"><%= household.created_at.strftime("%b %-d, %Y") %></span>
            <p class="text-[11px] text-slate-400 dark:text-slate-500"><%= time_ago_in_words(household.created_at) %> ago</p>
          </div>

          <!-- 3. Plan & Subscription Status -->
          <div class="space-y-1">
            <div class="flex items-center gap-1.5 flex-wrap">
              <!-- Plan Name Badge -->
              <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-bold bg-slate-100 text-slate-800 dark:bg-slate-800 dark:text-slate-200">
                <%= household.subscription_plan_name || "Free Trial" %>
              </span>

              <!-- Status Badge -->
              <% case status %>
              <% when :active %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">
                  Active
                </span>
              <% when :trialing %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-sky-100 text-sky-800 dark:bg-sky-950 dark:text-sky-300">
                  Trial (<%= household.trial_days_left %>d left)
                </span>
              <% when :past_due_grace %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300">
                  Past Due (Grace)
                </span>
              <% when :past_due %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-300">
                  Past Due
                </span>
              <% when :canceled %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-200 text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                  Canceled
                </span>
              <% when :expired %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-500 dark:bg-slate-800 dark:text-slate-400">
                  Expired
                </span>
              <% end %>
            </div>
          </div>

          <!-- 4. Subscription Renewal / Expiration -->
          <div class="text-xs">
            <span class="lg:hidden text-slate-400 font-semibold">Subscription: </span>
            <% if expires_at.present? %>
              <p class="font-medium text-slate-800 dark:text-slate-200">
                <span class="text-slate-500 dark:text-slate-400 text-[11px]"><%= label %>:</span>
                <%= expires_at.strftime("%b %-d, %Y") %>
              </p>
              <p class="text-[11px] text-slate-400 dark:text-slate-500">
                <% if expires_at.future? %>
                  in <%= time_ago_in_words(expires_at) %>
                <% else %>
                  <%= time_ago_in_words(expires_at) %> ago
                <% end %>
              </p>
            <% else %>
              <span class="text-slate-400">—</span>
            <% end %>
          </div>

          <!-- 5. Promotion Code -->
          <div>
            <span class="lg:hidden text-slate-400 font-semibold text-xs">Promotion: </span>
            <% if promo.present? %>
              <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-mono font-bold bg-purple-50 text-purple-700 dark:bg-purple-950/60 dark:text-purple-300 border border-purple-200 dark:border-purple-800/80">
                <%= icon_tag("tag", css_class: "w-3 h-3 text-purple-500") %>
                <%= promo %>
              </span>
            <% else %>
              <span class="text-slate-400 text-xs">—</span>
            <% end %>
          </div>

          <!-- 6. Last Activity -->
          <div class="text-xs text-slate-500 dark:text-slate-400">
            <span class="lg:hidden font-semibold">Activity: </span>
            <% if last_activity.present? %>
              <span class="text-slate-700 dark:text-slate-300 font-medium"><%= last_activity.strftime("%b %-d, %Y") %></span>
              <p class="text-[11px] text-slate-400"><%= time_ago_in_words(last_activity) %> ago</p>
            <% else %>
              <span>Never</span>
            <% end %>
          </div>

          <!-- 7. Action Arrow -->
          <div class="hidden lg:flex justify-end text-slate-400 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
            <%= icon_tag("arrow-right", css_class: "w-4 h-4") %>
          </div>
        <% end %>
      <% end %>

      <% if @households.empty? %>
        <div class="py-12 text-center text-slate-500 dark:text-slate-400">
          <p class="text-base font-semibold">No households match your criteria</p>
          <p class="mt-1 text-sm text-slate-400">Try adjusting your search terms or filters.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
