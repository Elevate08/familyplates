<% content_for :title, "Households | Platform Operator Console" %>

<div class="max-w-6xl mx-auto py-6 sm:py-8 space-y-7">
  <div class="flex flex-col gap-4 border-b border-slate-200 pb-6 dark:border-slate-800 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <%= link_to "← Operator console", platform_admin_root_path, class: "text-xs font-bold text-primary-600 hover:underline dark:text-primary-400" %>
      <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">Households</h1>
      <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">Metadata and operational signals across hosted households.</p>
    </div>
    <%= form_with url: platform_admin_households_path, method: :get, class: "flex gap-2" do |form| %>
      <%= form.search_field :search, value: @search, placeholder: "Search households or email", class: "w-64 rounded-xl border-slate-300 dark:border-slate-700 dark:bg-slate-950" %>
      <%= form.submit "Search", class: "rounded-xl bg-slate-900 px-4 py-2 text-sm font-bold text-white hover:bg-slate-700" %>
    <% end %>
  </div>

  <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
    <div class="hidden grid-cols-[minmax(0,2fr)_repeat(4,minmax(0,1fr))_auto] gap-4 border-b border-slate-200 px-5 py-3 text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:border-slate-800 sm:grid">
      <span>Household</span><span>Members</span><span>Recipes</span><span>Meal plans</span><span>Created</span><span></span>
    </div>
    <div class="divide-y divide-slate-100 dark:divide-slate-800">
      <% @households.each do |household| %>
        <%= link_to platform_admin_household_path(household), class: "grid gap-2 px-5 py-4 hover:bg-slate-50 dark:hover:bg-slate-800/50 sm:grid-cols-[minmax(0,2fr)_repeat(4,minmax(0,1fr))_auto] sm:items-center sm:gap-4" do %>
          <div class="min-w-0">
            <p class="truncate font-bold text-slate-900 dark:text-white"><%= household.name %></p>
            <p class="truncate text-xs text-slate-500 dark:text-slate-400"><%= household.email.presence || "No customer email" %></p>
          </div>
          <span class="text-sm text-slate-600 dark:text-slate-300"><span class="sm:hidden">Members: </span><%= household.family_members.size %></span>
          <span class="text-sm text-slate-600 dark:text-slate-300"><span class="sm:hidden">Recipes: </span><%= household.recipes.count %></span>
          <span class="text-sm text-slate-600 dark:text-slate-300"><span class="sm:hidden">Meal plans: </span><%= household.meal_plans.count %></span>
          <span class="text-sm text-slate-600 dark:text-slate-300"><%= household.created_at.to_date %></span>
          <span class="text-slate-400" aria-hidden="true">→</span>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
