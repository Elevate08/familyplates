<% content_for :title, "#{@household.name} | Platform Operator Console" %>

<div class="max-w-6xl mx-auto py-6 sm:py-8 space-y-7">
  <div class="flex flex-col gap-3 border-b border-slate-200 pb-6 dark:border-slate-800">
    <%= link_to "← All households", platform_admin_households_path, class: "text-xs font-bold text-primary-600 hover:underline dark:text-primary-400" %>
    <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white"><%= @household.name %></h1>
        <p class="mt-2 text-sm text-slate-500 dark:text-slate-400"><%= @household.email.presence || "No customer email" %></p>
      </div>
      <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-bold text-emerald-800 dark:bg-emerald-950/70 dark:text-emerald-300">Metadata view</span>
    </div>
  </div>

  <div class="grid gap-4 sm:grid-cols-4">
    <% [["Members", @family_members.size], ["Recipes", @recipes_count], ["Meal plans", @meal_plans_count], ["Pantry items", @pantry_items_count]].each do |label, count| %>
      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <p class="text-xs font-bold uppercase tracking-wider text-slate-500"><%= label %></p>
        <p class="mt-2 text-3xl font-black text-slate-900 dark:text-white"><%= count %></p>
      </div>
    <% end %>
  </div>

  <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
    <h2 class="text-lg font-extrabold text-slate-900 dark:text-white">Household members</h2>
    <div class="mt-4 divide-y divide-slate-100 dark:divide-slate-800">
      <% @family_members.each do |member| %>
        <div class="flex items-center justify-between gap-4 py-3">
          <div>
            <p class="font-semibold text-slate-800 dark:text-slate-200"><%= member.name %></p>
            <p class="text-xs text-slate-500 dark:text-slate-400"><%= member.user&.email.presence || "No linked customer login" %></p>
          </div>
          <span class="text-xs font-bold uppercase tracking-wide text-slate-500"><%= member.role %></span>
        </div>
      <% end %>
    </div>
  </div>
</div>
