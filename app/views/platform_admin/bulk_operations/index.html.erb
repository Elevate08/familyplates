<% content_for :title, "Bulk Operations | Platform Operator Console" %>

<div class="mx-auto max-w-6xl space-y-6 py-6 sm:py-8">
  <div class="flex flex-col gap-4 border-b border-slate-200 pb-6 sm:flex-row sm:items-end sm:justify-between dark:border-slate-800">
    <div>
      <%= link_to "← Console", platform_admin_root_path, class: "text-xs font-bold text-primary-600 hover:underline dark:text-primary-400" %>
      <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">Guarded Bulk Operations</h1>
      <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Safely preview, validate eligibility, and execute idempotent batch actions across households.</p>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= link_to "New Bulk Operation", new_platform_admin_bulk_operation_path, class: "rounded-xl bg-primary-600 px-4 py-2 text-sm font-bold text-white shadow-sm hover:bg-primary-500 transition-colors" %>
    </div>
  </div>

  <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Historical Bulk Operations</p>
        <p class="mt-2 text-3xl font-black text-slate-900 dark:text-white"><%= @total_operations %></p>
      </div>
      <div class="text-right text-xs text-slate-500 dark:text-slate-400">
        <p>Audit logging active</p>
        <p class="mt-0.5">All executions recorded in platform audit log</p>
      </div>
    </div>
  </div>

  <div class="rounded-3xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900 overflow-hidden">
    <div class="border-b border-slate-100 p-6 dark:border-slate-800">
      <h2 class="text-base font-extrabold text-slate-900 dark:text-white">Recent Execution History</h2>
    </div>

    <% if @recent_operations.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-100 text-left text-xs dark:divide-slate-800">
          <thead class="bg-slate-50 font-bold uppercase tracking-wider text-slate-500 dark:bg-slate-800/50">
            <tr>
              <th class="px-6 py-3">Timestamp</th>
              <th class="px-6 py-3">Action</th>
              <th class="px-6 py-3">Operator</th>
              <th class="px-6 py-3">Reason</th>
              <th class="px-6 py-3">Results</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
            <% @recent_operations.each do |event| %>
              <% meta = event.metadata || {} %>
              <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors">
                <td class="whitespace-nowrap px-6 py-4 font-mono text-slate-500 dark:text-slate-400">
                  <%= event.created_at.strftime("%Y-%m-%d %H:%M") %>
                </td>
                <td class="px-6 py-4">
                  <span class="inline-flex items-center rounded-lg px-2.5 py-1 font-bold <%= platform_audit_action_badge_classes(event) %>">
                    <%= meta["bulk_action"] || event.action %>
                  </span>
                </td>
                <td class="px-6 py-4 font-semibold text-slate-800 dark:text-slate-200">
                  <%= event.platform_admin&.email || "Operator" %>
                </td>
                <td class="px-6 py-4 text-slate-600 dark:text-slate-300 max-w-xs truncate" title="<%= meta["reason"] %>">
                  <%= meta["reason"] %>
                </td>
                <td class="px-6 py-4 font-mono">
                  <span class="text-emerald-600 dark:text-emerald-400 font-bold"><%= meta["success_count"] || 0 %> updated</span>
                  <% if (meta["skipped_count"] || 0) > 0 %>
                    <span class="text-slate-400">· <%= meta["skipped_count"] %> skipped</span>
                  <% end %>
                  <% if (meta["error_count"] || 0) > 0 %>
                    <span class="text-rose-600 dark:text-rose-400 font-bold">· <%= meta["error_count"] %> failed</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="p-12 text-center text-sm text-slate-500 dark:text-slate-400">
        No bulk operations recorded yet. Click "New Bulk Operation" to start a batch with preview guardrails.
      </div>
    <% end %>
  </div>
</div>
