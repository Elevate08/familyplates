<% content_for :title, "New Bulk Operation | Platform Operator Console" %>

<div class="mx-auto max-w-4xl space-y-6 py-6 sm:py-8">
  <div class="border-b border-slate-200 pb-6 dark:border-slate-800">
    <%= link_to "← Bulk operations", platform_admin_bulk_operations_path, class: "text-xs font-bold text-primary-600 hover:underline dark:text-primary-400" %>
    <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">Configure Bulk Operation</h1>
    <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Select target households and the action to perform. You will preview exact affected households before anything changes.</p>
  </div>

  <%= form_with url: preview_platform_admin_bulk_operations_path, method: :post, local: true, class: "space-y-8" do |form| %>
    <!-- Step 1: Targeting & Filters -->
    <div class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm dark:border-slate-800 dark:bg-slate-900 space-y-5">
      <div class="border-b border-slate-100 pb-4 dark:border-slate-800">
        <h2 class="text-lg font-extrabold text-slate-900 dark:text-white">1. Select Target Scope</h2>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Filter the households to include in this bulk operation.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= form.label "filter_params[status]", "Household Status", class: "block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5" %>
          <%= form.select "filter_params[status]", options_for_select([
                ["All Households", ""],
                ["Active Households Only", "active"],
                ["Suspended Households Only", "suspended"],
                ["Trialing Households Only", "trialing"]
              ], @filter_params[:status]), {}, class: "w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-xs font-medium text-slate-800 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200" %>
        </div>

        <div>
          <%= form.label "filter_params[promo_filter]", "Promotion Status", class: "block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5" %>
          <%= form.select "filter_params[promo_filter]", options_for_select([
                ["Any Promotion Status", ""],
                ["Without Any Promotion Code", "without_promo"],
                ["With A Promotion Code Applied", "with_promo"]
              ], @filter_params[:promo_filter]), {}, class: "w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-xs font-medium text-slate-800 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200" %>
        </div>

        <div>
          <%= form.label "filter_params[tag]", "Filter by Existing Tag (Optional)", class: "block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5" %>
          <%= form.text_field "filter_params[tag]", value: @filter_params[:tag], placeholder: "e.g. beta_tester", class: "w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-xs font-medium text-slate-800 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200" %>
        </div>

        <div>
          <%= form.label "filter_params[search]", "Search Filter (Optional)", class: "block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5" %>
          <%= form.text_field "filter_params[search]", value: @filter_params[:search], placeholder: "Match name or email query", class: "w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-xs font-medium text-slate-800 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200" %>
        </div>
      </div>
    </div>

    <!-- Step 2: Choose Operation -->
    <div class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm dark:border-slate-800 dark:bg-slate-900 space-y-6">
      <div class="border-b border-slate-100 pb-4 dark:border-slate-800">
        <h2 class="text-lg font-extrabold text-slate-900 dark:text-white">2. Choose Action & Parameters</h2>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Select what operation to perform on the eligible matching households.</p>
      </div>

      <div class="space-y-4">
        <!-- Add Tag -->
        <label class="flex items-start gap-3 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800/40 cursor-pointer transition-colors">
          <%= form.radio_button :bulk_action, "add_tag", checked: (@action == "add_tag"), class: "mt-1 text-primary-600 focus:ring-primary-500" %>
          <div class="space-y-2 flex-1">
            <span class="font-bold text-sm text-slate-900 dark:text-white block">Add Operational Tag</span>
            <span class="text-xs text-slate-500 dark:text-slate-400 block">Attaches an administrative tag to each eligible household.</span>
            <div class="pt-1">
              <%= form.text_field "operation_params[tag]", value: @operation_params[:tag], placeholder: "Tag name (e.g. priority_support, beta_tester)", class: "w-full max-w-sm rounded-xl border border-slate-300 px-3 py-2 text-xs dark:border-slate-700 dark:bg-slate-900" %>
            </div>
          </div>
        </label>

        <!-- Remove Tag -->
        <label class="flex items-start gap-3 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800/40 cursor-pointer transition-colors">
          <%= form.radio_button :bulk_action, "remove_tag", checked: (@action == "remove_tag"), class: "mt-1 text-primary-600 focus:ring-primary-500" %>
          <div class="space-y-2 flex-1">
            <span class="font-bold text-sm text-slate-900 dark:text-white block">Remove Operational Tag</span>
            <span class="text-xs text-slate-500 dark:text-slate-400 block">Detaches an administrative tag from households that currently have it.</span>
          </div>
        </label>

        <!-- Assign Promotion -->
        <label class="flex items-start gap-3 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800/40 cursor-pointer transition-colors">
          <%= form.radio_button :bulk_action, "assign_promotion", checked: (@action == "assign_promotion"), class: "mt-1 text-primary-600 focus:ring-primary-500" %>
          <div class="space-y-2 flex-1">
            <span class="font-bold text-sm text-slate-900 dark:text-white block">Assign Approved Promotion</span>
            <span class="text-xs text-slate-500 dark:text-slate-400 block">Attaches an active promotion program code to eligible households.</span>
            <div class="pt-1">
              <%= form.select "operation_params[promotion_code]", options_for_select(@available_promotions.map { |p| ["#{p.code} — #{p.name} (#{p.discount_percent}% off)", p.code] }, @operation_params[:promotion_code]), { include_blank: "Select a promotion..." }, class: "w-full max-w-sm rounded-xl border border-slate-300 px-3 py-2 text-xs dark:border-slate-700 dark:bg-slate-900" %>
            </div>
          </div>
        </label>

        <!-- Extend Trial -->
        <label class="flex items-start gap-3 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800/40 cursor-pointer transition-colors">
          <%= form.radio_button :bulk_action, "extend_trial", checked: (@action == "extend_trial"), class: "mt-1 text-primary-600 focus:ring-primary-500" %>
          <div class="space-y-2 flex-1">
            <span class="font-bold text-sm text-slate-900 dark:text-white block">Extend Free Trial</span>
            <span class="text-xs text-slate-500 dark:text-slate-400 block">Adds extra days to the household's free trial expiration date. (Automatically skips paid active subscribers).</span>
            <div class="pt-1">
              <%= form.number_field "operation_params[days]", value: (@operation_params[:days] || 14), min: 1, max: 90, class: "w-32 rounded-xl border border-slate-300 px-3 py-2 text-xs dark:border-slate-700 dark:bg-slate-900" %>
              <span class="text-xs text-slate-500 ml-1">days</span>
            </div>
          </div>
        </label>

        <!-- Send Service Announcement -->
        <label class="flex items-start gap-3 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800/40 cursor-pointer transition-colors">
          <%= form.radio_button :bulk_action, "send_announcement", checked: (@action == "send_announcement"), class: "mt-1 text-primary-600 focus:ring-primary-500" %>
          <div class="space-y-2 flex-1">
            <span class="font-bold text-sm text-slate-900 dark:text-white block">Send Service Announcement</span>
            <span class="text-xs text-slate-500 dark:text-slate-400 block">Dispatches a direct in-app support conversation from operator console to household inboxes.</span>
            <div class="pt-1 space-y-2 max-w-lg">
              <%= form.text_field "operation_params[subject]", value: @operation_params[:subject], placeholder: "Announcement Subject", class: "w-full rounded-xl border border-slate-300 px-3 py-2 text-xs dark:border-slate-700 dark:bg-slate-900" %>
              <%= form.text_area "operation_params[body]", value: @operation_params[:body], rows: 3, placeholder: "Announcement message text...", class: "w-full rounded-xl border border-slate-300 px-3 py-2 text-xs dark:border-slate-700 dark:bg-slate-900" %>
            </div>
          </div>
        </label>
      </div>
    </div>

    <!-- Step 3: Mandatory Operational Reason -->
    <div class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm dark:border-slate-800 dark:bg-slate-900 space-y-4">
      <div class="border-b border-slate-100 pb-4 dark:border-slate-800">
        <h2 class="text-lg font-extrabold text-slate-900 dark:text-white">3. Operational Justification</h2>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">A clear reason is required for platform auditing and accountability.</p>
      </div>

      <div>
        <%= form.label :reason, "Operational Reason / Ticket Reference", class: "block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5" %>
        <%= form.text_field :reason, value: @reason, required: true, placeholder: "e.g. Q4 Beta tester program kickoff, customer support campaign", class: "w-full rounded-xl border border-slate-300 px-3 py-2.5 text-xs font-medium dark:border-slate-700 dark:bg-slate-900" %>
      </div>
    </div>

    <!-- Submit Preview -->
    <div class="flex items-center justify-between pt-2">
      <%= link_to "Cancel", platform_admin_bulk_operations_path, class: "text-xs font-bold text-slate-500 hover:text-slate-700 dark:hover:text-slate-300" %>
      <%= form.submit "Preview Bulk Operation →", class: "rounded-xl bg-primary-600 px-6 py-3 text-sm font-bold text-white shadow-md hover:bg-primary-500 cursor-pointer transition-all" %>
    </div>
  <% end %>
</div>
