<% content_for :title, "Promotion programs | Platform Operator Console" %>

<div class="mx-auto max-w-6xl space-y-6 py-6 sm:py-8">
  <div class="border-b border-slate-200 pb-6 dark:border-slate-800">
    <%= link_to "← Console", platform_admin_root_path, class: "text-xs font-bold text-primary-600 hover:underline dark:text-primary-400" %>
    <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">Promotion programs</h1>
    <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">Track campaign codes and provider promotion-code IDs. Stripe remains authoritative for applied discounts and redemptions.</p>
  </div>

  <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
    <h2 class="font-extrabold text-slate-900 dark:text-white">Create a program</h2>
    <%= form_with model: @promotion_program, url: platform_admin_promotion_programs_path, class: "mt-4 grid gap-3 sm:grid-cols-2" do |form| %>
      <%= form.text_field :name, placeholder: "Program name", required: true, class: "rounded-xl border border-slate-300 px-3.5 py-2 text-sm dark:border-slate-700 dark:bg-slate-950 dark:text-white" %>
      <%= form.text_field :code, placeholder: "Customer-facing code", required: true, class: "rounded-xl border border-slate-300 px-3.5 py-2 text-sm dark:border-slate-700 dark:bg-slate-950 dark:text-white" %>
      <%= form.number_field :discount_percent, placeholder: "Discount %", min: 1, max: 100, class: "rounded-xl border border-slate-300 px-3.5 py-2 text-sm dark:border-slate-700 dark:bg-slate-950 dark:text-white" %>
      <%= form.text_field :provider_promotion_code_id, placeholder: "Stripe promotion-code ID", class: "rounded-xl border border-slate-300 px-3.5 py-2 text-sm dark:border-slate-700 dark:bg-slate-950 dark:text-white" %>
      <%= form.datetime_local_field :starts_at, class: "rounded-xl border border-slate-300 px-3.5 py-2 text-sm dark:border-slate-700 dark:bg-slate-950 dark:text-white" %>
      <%= form.datetime_local_field :ends_at, class: "rounded-xl border border-slate-300 px-3.5 py-2 text-sm dark:border-slate-700 dark:bg-slate-950 dark:text-white" %>
      <%= form.number_field :max_redemptions, placeholder: "Max redemptions", min: 1, class: "rounded-xl border border-slate-300 px-3.5 py-2 text-sm dark:border-slate-700 dark:bg-slate-950 dark:text-white" %>
      <%= form.submit "Create program", class: "rounded-xl bg-slate-900 px-4 py-2 text-sm font-bold text-white hover:bg-slate-700 cursor-pointer transition-colors" %>
    <% end %>
  </div>

  <div class="space-y-3">
    <% @promotion_programs.each do |program| %>
      <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div>
            <h2 class="font-extrabold text-slate-900 dark:text-white"><%= program.name %> <span class="ml-2 rounded-lg bg-slate-100 px-2 py-1 font-mono text-xs dark:bg-slate-800"><%= program.code %></span></h2>
            <p class="mt-2 text-xs text-slate-500 dark:text-slate-400"><%= program.discount_percent ? "#{program.discount_percent}% off" : "Provider-defined discount" %> · <%= program.redeemed_count %> redemptions<%= program.max_redemptions ? " of #{program.max_redemptions}" : "" %></p>
          </div>
          <%= form_with model: program, url: platform_admin_promotion_program_path(program), method: :patch, class: "flex items-center gap-2" do |form| %>
            <%= form.hidden_field :active, value: !program.active? %>
            <%= form.submit program.active? ? "Deactivate" : "Activate", class: "rounded-xl border border-slate-300 px-3 py-2 text-xs font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
