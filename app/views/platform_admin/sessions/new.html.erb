<% content_for :title, "Platform Admin Sign In | FamilyPlates" %>

<div class="max-w-md mx-auto py-12">
  <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-7 shadow-sm">
    <div class="mb-7">
      <p class="text-xs font-bold uppercase tracking-wider text-primary-600 dark:text-primary-400">FamilyPlates</p>
      <h1 class="mt-2 text-2xl font-extrabold text-slate-900 dark:text-white">Platform Admin Sign In</h1>
      <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">This area is for hosted-platform operations.</p>
    </div>

    <% if flash[:alert].present? %>
      <div class="mb-5 flex items-center gap-2 rounded-xl bg-rose-50 dark:bg-rose-950/60 border border-rose-200 dark:border-rose-800 p-3.5 text-sm text-rose-800 dark:text-rose-300">
        <span>⚠️</span>
        <p class="font-medium"><%= flash[:alert] %></p>
      </div>
    <% end %>

    <%= form_with url: platform_admin_session_path, method: :post, class: "space-y-5" do |form| %>
      <div>
        <%= form.label :email, "Email", class: "block text-sm font-semibold text-slate-700 dark:text-slate-300" %>
        <%= form.email_field :email, id: "admin_email", required: true, autocomplete: "username", autofocus: true, class: "mt-1.5 block w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm dark:border-slate-700 dark:bg-slate-950 dark:text-white" %>
      </div>
      <div>
        <%= form.label :password, "Password", class: "block text-sm font-semibold text-slate-700 dark:text-slate-300" %>
        <%= form.password_field :password, id: "admin_password", required: true, autocomplete: "current-password", class: "mt-1.5 block w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm dark:border-slate-700 dark:bg-slate-950 dark:text-white" %>
      </div>
      <div>
        <div class="flex items-center justify-between">
          <%= form.label :otp_code, "Authenticator code", class: "block text-sm font-semibold text-slate-700 dark:text-slate-300" %>
          <span class="text-xs text-slate-400">6 digits</span>
        </div>
        <%= form.text_field :otp_code, id: "admin_otp_code", required: true, inputmode: "numeric", pattern: "[0-9]{6}", maxlength: 6, placeholder: "000000", autocomplete: "one-time-code", class: "mt-1.5 block w-full rounded-xl border border-slate-300 px-4 py-2.5 text-base font-mono tracking-widest text-center dark:border-slate-700 dark:bg-slate-950 dark:text-white" %>
      </div>
      <%= form.submit "Sign in", class: "w-full rounded-xl bg-slate-900 px-4 py-3 text-sm font-bold text-white hover:bg-slate-700 cursor-pointer shadow-xs transition-colors" %>
    <% end %>

    <% if Rails.env.development? && (dev_admin = PlatformAdminAccount.find_by(email: "operator@familyplates.local")) %>
      <div class="mt-8 pt-6 border-t border-slate-100 dark:border-slate-800">
        <div class="p-3.5 rounded-2xl bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-900/50 text-xs text-amber-900 dark:text-amber-200">
          <p class="font-bold flex items-center gap-1.5 text-amber-800 dark:text-amber-300 mb-1.5">
            <span>⚙️</span> Development Operator Account
          </p>
          <div class="space-y-1 font-mono text-[11px]">
            <p><span class="font-semibold text-slate-500 dark:text-slate-400">Email:</span> operator@familyplates.local</p>
            <p><span class="font-semibold text-slate-500 dark:text-slate-400">Password:</span> OperatorPassword123!</p>
            <p><span class="font-semibold text-slate-500 dark:text-slate-400">Current Code:</span> <span class="font-bold tracking-wider text-amber-700 dark:text-amber-300"><%= PlatformAdminAccount::Totp.code(dev_admin.otp_secret) %></span></p>
          </div>
          <button type="button" onclick="document.getElementById('admin_email').value='operator@familyplates.local';document.getElementById('admin_password').value='OperatorPassword123!';document.getElementById('admin_otp_code').value='<%= PlatformAdminAccount::Totp.code(dev_admin.otp_secret) %>';" class="mt-3 w-full py-1.5 px-3 rounded-lg bg-amber-600 hover:bg-amber-700 text-white font-bold text-[11px] transition-colors cursor-pointer text-center">
            Fill Development Credentials
          </button>
        </div>
      </div>
    <% end %>
  </div>
</div>
