<% content_for :title, "Platform Admin Sign In | FamilyPlates" %>

<div class="max-w-md mx-auto py-12">
  <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-7 shadow-sm">
    <div class="mb-7">
      <p class="text-xs font-bold uppercase tracking-wider text-primary-600 dark:text-primary-400">FamilyPlates</p>
      <h1 class="mt-2 text-2xl font-extrabold text-slate-900 dark:text-white">Platform Admin Sign In</h1>
      <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">This area is for hosted-platform operations.</p>
    </div>

    <%= form_with url: platform_admin_session_path, method: :post, class: "space-y-5" do |form| %>
      <div>
        <%= form.label :email, "Email", class: "block text-sm font-semibold text-slate-700 dark:text-slate-300" %>
        <%= form.email_field :email, required: true, autocomplete: "username", autofocus: true, class: "mt-1.5 block w-full rounded-xl border-slate-300 dark:border-slate-700 dark:bg-slate-950" %>
      </div>
      <div>
        <%= form.label :password, "Password", class: "block text-sm font-semibold text-slate-700 dark:text-slate-300" %>
        <%= form.password_field :password, required: true, autocomplete: "current-password", class: "mt-1.5 block w-full rounded-xl border-slate-300 dark:border-slate-700 dark:bg-slate-950" %>
      </div>
      <div>
        <%= form.label :otp_code, "Authenticator code", class: "block text-sm font-semibold text-slate-700 dark:text-slate-300" %>
        <%= form.text_field :otp_code, required: true, inputmode: "numeric", pattern: "[0-9]{6}", autocomplete: "one-time-code", class: "mt-1.5 block w-full rounded-xl border-slate-300 dark:border-slate-700 dark:bg-slate-950" %>
      </div>
      <%= form.submit "Sign in", class: "w-full rounded-xl bg-slate-900 px-4 py-3 text-sm font-bold text-white hover:bg-slate-700" %>
    <% end %>
  </div>
</div>
