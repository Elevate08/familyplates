<% content_for :title, "#{@support_thread.subject} | Platform Support" %>

<div class="max-w-4xl mx-auto py-6 sm:py-8 space-y-7">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 border-b border-slate-200 pb-6 dark:border-slate-800">
    <div>
      <%= link_to "← Support inbox", platform_admin_support_threads_path, class: "text-xs font-bold text-primary-600 hover:underline dark:text-primary-400" %>
      <div class="mt-2 flex flex-wrap items-center gap-3">
        <h1 class="text-2xl font-black text-slate-900 dark:text-white"><%= @support_thread.subject %></h1>
        <%= support_thread_status_badge(@support_thread) %>
      </div>
      <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
        Household: <%= link_to @household.name, platform_admin_household_path(@household), class: "font-bold text-slate-700 dark:text-slate-300 hover:underline" %>
      </p>
    </div>

    <!-- Status Action Buttons -->
    <div class="flex flex-wrap items-center gap-2 self-start">
      <% if @support_thread.resolved? %>
        <%= button_to reopen_platform_admin_support_thread_path(@support_thread), method: :patch, class: "inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-bold bg-slate-900 hover:bg-slate-800 dark:bg-slate-700 dark:hover:bg-slate-600 text-white cursor-pointer transition-colors" do %>
          <span>↻</span>
          <span>Reopen conversation</span>
        <% end %>
      <% else %>
        <% if @support_thread.waiting_on_support? || @support_thread.status == "open" %>
          <%= button_to change_status_platform_admin_support_thread_path(@support_thread, status: :waiting_on_customer), method: :patch, class: "inline-flex items-center gap-1 px-3 py-2 rounded-xl text-xs font-bold text-sky-800 dark:text-sky-300 bg-sky-50 dark:bg-sky-950/60 border border-sky-200 dark:border-sky-800 hover:bg-sky-100 cursor-pointer transition-colors" do %>
            <span>Mark Waiting on Customer</span>
          <% end %>
        <% else %>
          <%= button_to change_status_platform_admin_support_thread_path(@support_thread, status: :waiting_on_support), method: :patch, class: "inline-flex items-center gap-1 px-3 py-2 rounded-xl text-xs font-bold text-amber-800 dark:text-amber-300 bg-amber-50 dark:bg-amber-950/60 border border-amber-200 dark:border-amber-800 hover:bg-amber-100 cursor-pointer transition-colors" do %>
            <span>Mark Waiting on Support</span>
          <% end %>
        <% end %>

        <%= button_to resolve_platform_admin_support_thread_path(@support_thread), method: :patch, class: "inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-bold text-emerald-800 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800 hover:bg-emerald-100 cursor-pointer transition-colors" do %>
          <span>✓</span>
          <span>Resolve Ticket</span>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Household Info Snippet Card -->
  <div class="rounded-2xl border border-slate-200/80 bg-slate-50/60 dark:border-slate-800 dark:bg-slate-950/40 p-4 flex flex-wrap items-center justify-between gap-4 text-xs">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-xl bg-primary-100 dark:bg-primary-950/80 text-primary-600 dark:text-primary-400 flex items-center justify-center font-bold">
        <%= icon_tag("users", css_class: "w-4 h-4") %>
      </div>
      <div>
        <span class="text-slate-500 dark:text-slate-400">Customer:</span>
        <span class="font-bold text-slate-800 dark:text-slate-200 ml-1"><%= @support_thread.created_by_user&.email || @household.email || "Unknown" %></span>
        <span class="mx-2 text-slate-300 dark:text-slate-700">&bull;</span>
        <span class="text-slate-500 dark:text-slate-400">Plan:</span>
        <span class="font-bold text-slate-800 dark:text-slate-200 ml-1"><%= @household.subscription_plan_name || @household.subscription_status.to_s.humanize %></span>
      </div>
    </div>
    <%= link_to "View full household profile →", platform_admin_household_path(@household), class: "font-bold text-primary-600 dark:text-primary-400 hover:underline" %>
  </div>

  <% if @support_thread.resolved? %>
    <div class="p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-200 dark:border-emerald-900 flex items-center gap-3 text-xs text-emerald-800 dark:text-emerald-300">
      <span class="text-base font-bold">✓</span>
      <div>
        <span class="font-bold">This support ticket is resolved.</span>
        <span class="ml-1">Closed <%= @support_thread.resolved_at ? "on #{@support_thread.resolved_at.strftime('%b %-d, %Y at %-I:%M %p')}" : "recently" %>. Sending a new reply will reopen it.</span>
      </div>
    </div>
  <% end %>

  <!-- Messages History -->
  <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xs dark:border-slate-800 dark:bg-slate-900 space-y-6">
    <div class="space-y-4">
      <% @support_thread.messages.order(:created_at, :id).each do |message| %>
        <div class="p-4 rounded-2xl <%= message.platform_admin? ? 'bg-slate-50 dark:bg-slate-800/70 border border-slate-200/60 dark:border-slate-700/60' : 'bg-primary-50/40 dark:bg-primary-950/30 border border-primary-100 dark:border-primary-900/40' %> space-y-2">
          <div class="flex items-center justify-between gap-4 text-xs">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-full flex items-center justify-center font-black text-[10px] uppercase <%= message.platform_admin? ? 'bg-slate-900 text-white dark:bg-white dark:text-slate-900' : 'bg-primary-600 text-white' %>">
                <%= message.platform_admin? ? "O" : "C" %>
              </span>
              <span class="font-bold text-slate-900 dark:text-white">
                <%= message.platform_admin? ? "FamilyPlates Support (Operator)" : (message.user&.email || "Customer") %>
              </span>
            </div>
            <time class="text-slate-400 text-[11px]" datetime="<%= message.created_at.iso8601 %>">
              <%= message.created_at.strftime("%b %-d, %Y at %-I:%M %p") %>
            </time>
          </div>
          <p class="whitespace-pre-wrap text-sm text-slate-800 dark:text-slate-200 pl-8"><%= message.body %></p>
        </div>
      <% end %>
    </div>

    <!-- Reply Box -->
    <div class="border-t border-slate-100 dark:border-slate-800 pt-6">
      <%= form_with url: reply_platform_admin_support_thread_path(@support_thread), scope: :support_message, class: "space-y-3" do |form| %>
        <label for="support_message_body" class="block text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Reply to Customer</label>
        <%= form.text_area :body, id: "support_message_body", required: true, maxlength: 10_000, rows: 4, placeholder: "Type your response to the customer...", class: "block w-full rounded-2xl border border-slate-300 p-4 text-sm dark:border-slate-700 dark:bg-slate-950 dark:text-white focus:ring-2 focus:ring-primary-500" %>
        <div class="flex items-center justify-between">
          <p class="text-[11px] text-slate-400">Sending a reply will update the ticket status to <strong class="text-slate-600 dark:text-slate-300">Waiting on customer</strong>.</p>
          <%= form.submit "Send reply", class: "rounded-xl bg-slate-900 px-5 py-2.5 text-xs font-bold text-white hover:bg-slate-800 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-100 cursor-pointer shadow-xs transition-colors" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
