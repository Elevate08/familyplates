<% content_for :title, "Support Inbox | Platform Operator Console" %>

<div class="max-w-6xl mx-auto py-6 sm:py-8 space-y-8">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-slate-200 pb-6 dark:border-slate-800">
    <div>
      <%= link_to "← Operator console", platform_admin_root_path, class: "text-xs font-bold text-primary-600 hover:underline dark:text-primary-400" %>
      <h1 class="mt-2 text-3xl font-black tracking-tight text-slate-900 dark:text-white">Support inbox</h1>
      <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Manage customer conversations, respond to inquiries, and track ticket resolutions.</p>
    </div>
    <%= link_to "All households →", platform_admin_households_path, class: "text-xs font-bold text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white transition-colors" %>
  </div>

  <!-- Status Filter Tabs -->
  <div class="flex flex-wrap items-center gap-2 border-b border-slate-200 dark:border-slate-800 pb-4">
    <%= link_to platform_admin_support_threads_path(status: :active), class: "inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all #{@filter == 'active' ? 'bg-slate-900 text-white dark:bg-white dark:text-slate-900 shadow-xs' : 'bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700'}" do %>
      <span>Active</span>
      <span class="px-1.5 py-0.2 rounded-full text-[11px] font-black #{@filter == 'active' ? 'bg-slate-800 text-white dark:bg-slate-200 dark:text-slate-900' : 'bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300'}"><%= @active_count %></span>
    <% end %>

    <%= link_to platform_admin_support_threads_path(status: :waiting_on_support), class: "inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all #{@filter == 'waiting_on_support' ? 'bg-amber-500 text-white shadow-xs' : 'bg-amber-50 text-amber-800 border border-amber-200 dark:bg-amber-950/40 dark:text-amber-300 dark:border-amber-800/60 hover:bg-amber-100'}" do %>
      <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
      <span>Waiting on support</span>
      <span class="px-1.5 py-0.2 rounded-full text-[11px] font-black bg-amber-200/80 dark:bg-amber-900/60 text-amber-900 dark:text-amber-200"><%= @waiting_on_support_count %></span>
    <% end %>

    <%= link_to platform_admin_support_threads_path(status: :waiting_on_customer), class: "inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all #{@filter == 'waiting_on_customer' ? 'bg-sky-600 text-white shadow-xs' : 'bg-sky-50 text-sky-800 border border-sky-200 dark:bg-sky-950/40 dark:text-sky-300 dark:border-sky-800/60 hover:bg-sky-100'}" do %>
      <span>Waiting on customer</span>
      <span class="px-1.5 py-0.2 rounded-full text-[11px] font-black bg-sky-200/80 dark:bg-sky-900/60 text-sky-900 dark:text-sky-200"><%= @waiting_on_customer_count %></span>
    <% end %>

    <%= link_to platform_admin_support_threads_path(status: :resolved), class: "inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all #{@filter == 'resolved' ? 'bg-emerald-600 text-white shadow-xs' : 'bg-emerald-50 text-emerald-800 border border-emerald-200 dark:bg-emerald-950/40 dark:text-emerald-300 dark:border-emerald-800/60 hover:bg-emerald-100'}" do %>
      <span>Resolved</span>
      <span class="px-1.5 py-0.2 rounded-full text-[11px] font-black bg-emerald-200/80 dark:bg-emerald-900/60 text-emerald-900 dark:text-emerald-200"><%= @resolved_count %></span>
    <% end %>

    <%= link_to "View All", platform_admin_support_threads_path(status: :all), class: "ml-auto text-xs font-semibold text-slate-500 hover:text-slate-800 dark:hover:text-slate-200 transition-colors" %>
  </div>

  <!-- Active Support Requests Section -->
  <% unless @filter == "resolved" %>
    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <h2 class="text-lg font-black text-slate-900 dark:text-white">Active Support Requests</h2>
          <span class="px-2 py-0.5 rounded-full text-xs font-black bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300"><%= @active_threads.respond_to?(:count) ? @active_threads.count : @active_threads.size %></span>
        </div>
      </div>

      <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-xs dark:border-slate-800 dark:bg-slate-900">
        <% if @active_threads.any? %>
          <div class="divide-y divide-slate-100 dark:divide-slate-800">
            <% @active_threads.each do |thread| %>
              <%= link_to platform_admin_support_thread_path(thread), class: "block p-5 sm:px-6 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors group" do %>
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                  <div class="space-y-1 min-w-0 flex-1">
                    <div class="flex items-center gap-3">
                      <p class="font-black text-slate-900 dark:text-white group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors truncate"><%= thread.subject %></p>
                      <%= support_thread_status_badge(thread) %>
                    </div>
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-500 dark:text-slate-400">
                      <span class="font-bold text-slate-700 dark:text-slate-300"><%= thread.household.name %></span>
                      <span>&bull;</span>
                      <span><%= thread.messages.last&.platform_admin? ? "Replied by operator" : (thread.created_by_user&.email || "Customer") %></span>
                      <span>&bull;</span>
                      <time datetime="<%= thread.last_message_at&.iso8601 %>"><%= time_ago_in_words(thread.last_message_at || thread.created_at) %> ago</time>
                    </div>
                    <% last_body = thread.messages.order(:created_at, :id).last&.body %>
                    <% if last_body.present? %>
                      <p class="text-xs text-slate-600 dark:text-slate-400 line-clamp-1 italic mt-1">"<%= truncate(last_body, length: 120) %>"</p>
                    <% end %>
                  </div>
                  <div class="shrink-0 sm:text-right">
                    <span class="inline-flex items-center text-xs font-bold text-primary-600 dark:text-primary-400 group-hover:translate-x-1 transition-transform">
                      Open thread →
                    </span>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <div class="py-12 px-6 text-center">
            <div class="w-12 h-12 rounded-2xl bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mx-auto text-xl mb-3">
              ✓
            </div>
            <h3 class="text-base font-bold text-slate-900 dark:text-white">All caught up!</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">There are no support requests requiring action in this view.</p>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <!-- Resolved Support Requests Section -->
  <% if @resolved_threads.present? || @filter == "resolved" %>
    <section class="space-y-4 pt-4 <%= 'border-t border-slate-200 dark:border-slate-800' unless @filter == 'resolved' %>">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <div class="w-2.5 h-2.5 rounded-full bg-emerald-500"></div>
          <h2 class="text-lg font-black text-slate-900 dark:text-white">Resolved Support Requests</h2>
          <span class="px-2 py-0.5 rounded-full text-xs font-black bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/80"><%= @resolved_threads.respond_to?(:count) ? @resolved_threads.count : @resolved_threads.size %></span>
        </div>
      </div>

      <div class="overflow-hidden rounded-3xl border border-slate-200/80 bg-white/70 shadow-2xs dark:border-slate-800 dark:bg-slate-900/60">
        <% if @resolved_threads.any? %>
          <div class="divide-y divide-slate-100 dark:divide-slate-800/70">
            <% @resolved_threads.each do |thread| %>
              <%= link_to platform_admin_support_thread_path(thread), class: "block p-5 sm:px-6 hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors group opacity-85 hover:opacity-100" do %>
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                  <div class="space-y-1 min-w-0 flex-1">
                    <div class="flex items-center gap-3">
                      <p class="font-bold text-slate-800 dark:text-slate-200 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors truncate"><%= thread.subject %></p>
                      <%= support_thread_status_badge(thread) %>
                    </div>
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-400 dark:text-slate-500">
                      <span><%= thread.household.name %></span>
                      <span>&bull;</span>
                      <span>Resolved <%= thread.resolved_at ? "#{time_ago_in_words(thread.resolved_at)} ago" : "recently" %></span>
                    </div>
                  </div>
                  <div class="shrink-0 text-xs font-medium text-slate-400 group-hover:text-slate-600 dark:group-hover:text-slate-300">
                    View transcript →
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <div class="py-10 px-6 text-center text-xs text-slate-500 dark:text-slate-400">
            No resolved support requests recorded yet.
          </div>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
