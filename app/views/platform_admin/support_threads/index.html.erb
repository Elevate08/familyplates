<% content_for :title, "Support Inbox | Platform Operator Console" %>

<div class="max-w-5xl mx-auto py-6 sm:py-8 space-y-7">
  <div class="flex items-end justify-between gap-4 border-b border-slate-200 pb-6 dark:border-slate-800">
    <div>
      <%= link_to "← Operator console", platform_admin_root_path, class: "text-xs font-bold text-primary-600 hover:underline dark:text-primary-400" %>
      <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">Support inbox</h1>
    </div>
    <%= link_to "All households", platform_admin_households_path, class: "text-sm font-bold text-primary-600 hover:underline dark:text-primary-400" %>
  </div>

  <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
    <div class="divide-y divide-slate-100 dark:divide-slate-800">
      <% @support_threads.each do |thread| %>
        <%= link_to platform_admin_support_thread_path(thread), class: "block px-6 py-5 hover:bg-slate-50 dark:hover:bg-slate-800/50" do %>
          <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <p class="font-bold text-slate-900 dark:text-white"><%= thread.subject %></p>
              <p class="mt-1 text-sm text-slate-500 dark:text-slate-400"><%= thread.household.name %></p>
            </div>
            <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-bold text-slate-600 dark:bg-slate-800 dark:text-slate-300"><%= thread.status.humanize %></span>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
