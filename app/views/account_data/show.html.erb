<% content_for :title, "Your data | FamilyPlates" %>

<div class="mx-auto max-w-2xl space-y-6 py-6 sm:py-8">
  <div>
    <p class="text-xs font-bold uppercase tracking-wider text-primary-600 dark:text-primary-400">Privacy</p>
    <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">Your data</h1>
    <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">Export your household data whenever you need it, or ask support to permanently delete this household.</p>
  </div>
  <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
    <h2 class="font-extrabold text-slate-900 dark:text-white">Download a copy</h2>
    <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">Includes your recipes, ingredients, pantry items, meal plans, and household members. Security tokens and credentials are never included.</p>
    <%= link_to "Export household data", export_account_data_path, class: "mt-4 inline-flex rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-bold text-white hover:bg-slate-700" %>
  </div>
  <div class="rounded-3xl border border-rose-200 bg-rose-50 p-6 dark:border-rose-900/60 dark:bg-rose-950/20">
    <h2 class="font-extrabold text-slate-900 dark:text-white">Request permanent deletion</h2>
    <p class="mt-2 text-sm text-slate-700 dark:text-slate-300">Support will review the request and permanently remove this household. This cannot be undone.</p>
    <% if FamilyPlates.config.hosted? %>
      <div class="mt-4 rounded-2xl border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900 dark:border-amber-800 dark:bg-amber-950/40 dark:text-amber-200" data-testid="deletion-billing-warning">
        <p class="font-bold">⚠️ Deleting your household cancels your subscription immediately.</p>
        <p class="mt-1">When support completes the deletion, your FamilyPlates subscription is cancelled on the spot - it does not run to the end of the current billing period. You will not be charged again, and you will not receive a refund for any time remaining in the period you have already paid for.</p>
      </div>
    <% end %>
    <% if @deletion_request %>
      <p class="mt-4 text-sm font-bold text-rose-800 dark:text-rose-300">A deletion request is already pending review.</p>
    <% else %>
      <%= button_to "Request deletion", request_deletion_account_data_path, method: :post, class: "mt-4 rounded-xl bg-rose-700 px-4 py-2.5 text-sm font-bold text-white hover:bg-rose-800", data: { turbo_confirm: FamilyPlates.config.hosted? ? "Send a permanent-deletion request to support? When it is completed your subscription is cancelled immediately: no further charges, and no refund for the rest of the current billing period." : "Send a permanent-deletion request to support?" } %>
    <% end %>
  </div>
</div>
