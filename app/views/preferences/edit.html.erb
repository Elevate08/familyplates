<div class="max-w-2xl mx-auto py-6 sm:py-10">
  <!-- Header -->
  <div class="mb-8">
    <div class="flex items-center gap-3 mb-2">
      <div class="w-10 h-10 rounded-2xl flex items-center justify-center text-white shadow-md transition-colors"
           style="background-color: <%= @family_member.avatar_color %>">
        <%= icon_tag(@family_member.avatar_icon.presence || "chef-hat", css_class: "w-5 h-5") %>
      </div>
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">My Preferences</h1>
        <p class="text-xs text-slate-500">Personalize your kitchen identity, icon, and app theme color.</p>
      </div>
    </div>
  </div>

  <!-- Main Card -->
  <div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm overflow-hidden p-6 sm:p-8">
    <%= form_with model: @family_member, url: preferences_path, method: :patch, class: "space-y-8" do |f| %>
      
      <% if @family_member.errors.any? %>
        <div class="p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-sm">
          <p class="font-bold mb-1">Please fix the following issues:</p>
          <ul class="list-disc list-inside text-xs space-y-1">
            <% @family_member.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <!-- Display Name -->
      <div>
        <%= f.label :name, "Display Name / Nickname", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2" %>
        <%= f.text_field :name, placeholder: "e.g. Dad, Sarah, Little Chef", required: true,
              class: "w-full px-4 py-3 rounded-2xl border border-slate-200 text-slate-900 font-semibold text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors" %>
        <p class="text-xs text-slate-400 mt-1.5">This name will appear on recipe requests, calendar notes, and meal plan chef badges.</p>
      </div>

      <!-- Avatar Icon Picker -->
      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Avatar Kitchen Icon</label>
        <div class="grid grid-cols-4 sm:grid-cols-8 gap-3">
          <% FamilyMember::AVATAR_ICONS.each do |icon_name| %>
            <label class="cursor-pointer group flex flex-col items-center">
              <%= f.radio_button :avatar_icon, icon_name, class: "sr-only peer" %>
              <div class="w-12 h-12 rounded-2xl border-2 border-slate-200 peer-checked:border-slate-900 peer-checked:bg-slate-900 peer-checked:text-white text-slate-600 flex items-center justify-center transition-all group-hover:border-slate-400 group-hover:scale-105 shadow-xs">
                <%= icon_tag(icon_name, css_class: "w-6 h-6") %>
              </div>
              <span class="text-[10px] font-medium text-slate-500 mt-1.5 capitalize text-center truncate max-w-full">
                <%= icon_name.tr("-", " ") %>
              </span>
            </label>
          <% end %>
        </div>
      </div>

      <!-- Theme Accent Color Palette -->
      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Theme Accent Color</label>
        <div class="grid grid-cols-4 sm:grid-cols-6 gap-3">
          <% [
            ["#F97316", "Carrot"],
            ["#3B82F6", "Ocean"],
            ["#10B981", "Sage"],
            ["#F59E0B", "Amber"],
            ["#EF4444", "Chili"],
            ["#8B5CF6", "Plum"],
            ["#EC4899", "Berry"],
            ["#14B8A6", "Mint"],
            ["#6366F1", "Twilight"],
            ["#84CC16", "Olive"],
            ["#06B6D4", "Sky"],
            ["#64748B", "Graphite"]
          ].each do |hex, label| %>
            <label class="cursor-pointer group flex flex-col items-center">
              <%= f.radio_button :avatar_color, hex, class: "sr-only peer" %>
              <div class="w-12 h-12 rounded-2xl shadow-sm peer-checked:ring-4 peer-checked:ring-offset-2 peer-checked:ring-slate-900 peer-checked:scale-110 transition-all flex items-center justify-center"
                   style="background-color: <%= hex %>">
                <span class="opacity-0 peer-checked:opacity-100 text-white font-bold text-sm">✓</span>
              </div>
              <span class="text-[10px] font-medium text-slate-500 mt-1.5 text-center truncate">
                <%= label %>
              </span>
            </label>
          <% end %>
        </div>
        <p class="text-xs text-slate-400 mt-2">When you're the active cook, the entire kitchen interface will tint with this color.</p>
      </div>

      <!-- Security / PIN Settings -->
      <% if @family_member.admin? %>
        <div class="pt-6 border-t border-slate-100">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-base">🔒</span>
            <label for="family_member_pin" class="block text-xs font-bold uppercase tracking-wider text-slate-700">Admin 4-Digit Security PIN</label>
          </div>
          <p class="text-xs text-slate-500 mb-3">
            As an <strong>Organizer / Admin</strong>, your 4-digit PIN is required to unlock administrative privileges and switch into this profile.
          </p>
          <div class="max-w-xs">
            <%= f.password_field :pin, value: @family_member.pin, maxlength: 4, placeholder: "••••", pattern: "[0-9]*", inputmode: "numeric", required: true,
                  class: "w-full px-4 py-3 rounded-2xl border border-slate-200 text-center text-lg font-mono tracking-widest focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors" %>
          </div>
        </div>
      <% else %>
        <div class="pt-6 border-t border-slate-100">
          <div class="flex items-start gap-3 p-4 rounded-2xl bg-slate-50 border border-slate-200/60 text-xs text-slate-600">
            <span class="text-base">✨</span>
            <div>
              <p class="font-bold text-slate-800 mb-0.5">Family Member Profile</p>
              <p>You can switch profiles with 1-tap on any shared kitchen screen. Only Admin profiles require PIN protection.</p>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Submit Actions -->
      <div class="pt-4 flex items-center justify-between border-t border-slate-100">
        <%= link_to "Cancel", root_path, class: "text-xs font-bold text-slate-500 hover:text-slate-900 px-4 py-2.5 rounded-xl transition-colors" %>
        <%= f.submit "Save Preferences", 
              class: "px-6 py-3 rounded-2xl bg-primary-600 hover:bg-primary-500 text-white font-bold text-sm shadow-md shadow-primary-500/20 cursor-pointer transition-all hover:scale-[1.02]" %>
      </div>

    <% end %>
  </div>
</div>
