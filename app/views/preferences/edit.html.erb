<div class="max-w-3xl mx-auto py-4 sm:py-8 space-y-8">
  <!-- Header & Active Cook Profile Status -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200 dark:border-slate-800 pb-6">
    <div class="flex items-center gap-3.5">
      <div class="w-12 h-12 rounded-2xl flex items-center justify-center text-white shadow-md font-black text-lg transition-colors shrink-0"
           style="background-color: <%= @family_member.avatar_color %>">
        <%= @family_member.initial %>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Family Hub & Settings</h1>
          <% if @family_member.admin? %>
            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-amber-100 dark:bg-amber-950/80 text-amber-800 dark:text-amber-300 border border-amber-200 dark:border-amber-800 uppercase">
              Admin
            </span>
          <% end %>
        </div>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
          Active Cook: <strong class="text-slate-800 dark:text-slate-200"><%= @family_member.name %></strong> &bull; Household: <span class="font-semibold"><%= @household&.name %></span>
        </p>
      </div>
    </div>
  </div>

  <!-- Quick Family Cook Switcher Strip -->
  <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/80 dark:border-slate-800 p-5 sm:p-6 shadow-xs">
    <div class="flex items-center justify-between mb-4">
      <div>
        <h2 class="text-sm font-extrabold text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
          <span>👥</span>
          <span>Switch Active Cook Profile</span>
        </h2>
        <p class="text-xs text-slate-400 dark:text-slate-500 mt-0.5">Tap any family member to switch who is planning and cooking.</p>
      </div>
      <% if @family_member.admin? %>
        <%= link_to "+ Add Member", admin_family_members_path, class: "text-xs font-bold text-primary-600 dark:text-primary-400 hover:underline" %>
      <% end %>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      <% @family_members.each do |member| %>
        <% is_active = (member.id == @family_member.id) %>
        <% if is_active %>
          <div class="p-3 rounded-2xl bg-primary-50 dark:bg-primary-950/50 border-2 border-primary-500 flex items-center gap-2.5 shadow-xs">
            <span class="w-8 h-8 rounded-xl flex items-center justify-center text-white text-xs font-black shrink-0 shadow-2xs"
                  style="background-color: <%= member.avatar_color %>">
              <%= member.initial %>
            </span>
            <div class="flex-1 min-w-0">
              <span class="block text-xs font-black text-primary-900 dark:text-primary-200 truncate"><%= member.name %></span>
              <span class="text-[9.5px] font-bold text-primary-600 dark:text-primary-400 uppercase">Active</span>
            </div>
            <%= icon_tag("check", css_class: "w-4 h-4 text-primary-600 dark:text-primary-400 shrink-0") %>
          </div>
        <% elsif member.requires_pin? %>
          <button type="button"
                  data-controller="pin-launcher" data-pin-launcher-modal-value="nav" data-pin-launcher-member-id-value="<%= member.id %>" data-pin-launcher-member-name-value="<%= member.name %>" data-pin-launcher-member-color-value="<%= member.avatar_color %>" data-pin-launcher-member-initial-value="<%= member.initial %>" data-action="click->pin-launcher#open"
                  class="p-3 rounded-2xl bg-slate-50 dark:bg-slate-800/80 hover:bg-slate-100 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700 flex items-center gap-2.5 transition-all cursor-pointer text-left shadow-2xs group">
            <span class="w-8 h-8 rounded-xl flex items-center justify-center text-white text-xs font-black shrink-0 group-hover:scale-105 transition-transform"
                  style="background-color: <%= member.avatar_color %>">
              <%= member.initial %>
            </span>
            <div class="flex-1 min-w-0">
              <span class="block text-xs font-bold text-slate-800 dark:text-slate-200 truncate"><%= member.name %></span>
              <span class="text-[9.5px] text-slate-400 font-semibold uppercase">🔒 PIN</span>
            </div>
          </button>
        <% else %>
          <%= button_to switch_family_member_path(member), method: :post,
                class: "w-full p-3 rounded-2xl bg-slate-50 dark:bg-slate-800/80 hover:bg-slate-100 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700 flex items-center gap-2.5 transition-all cursor-pointer text-left shadow-2xs group" do %>
            <span class="w-8 h-8 rounded-xl flex items-center justify-center text-white text-xs font-black shrink-0 group-hover:scale-105 transition-transform"
                  style="background-color: <%= member.avatar_color %>">
              <%= member.initial %>
            </span>
            <div class="flex-1 min-w-0">
              <span class="block text-xs font-bold text-slate-800 dark:text-slate-200 truncate"><%= member.name %></span>
              <span class="text-[9.5px] text-slate-400 font-semibold uppercase">1-Tap</span>
            </div>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- SECTION 1: Personal Preferences Form -->
  <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/80 dark:border-slate-800 p-6 sm:p-8 shadow-xs">
    <div class="flex items-center gap-2 pb-4 mb-6 border-b border-slate-100 dark:border-slate-800">
      <span class="text-xl">🎨</span>
      <div>
        <h2 class="text-lg font-extrabold text-slate-900 dark:text-white tracking-tight">Personalize <%= @family_member.name %>'s Profile</h2>
        <p class="text-xs text-slate-500 dark:text-slate-400">Choose your avatar icon and kitchen theme color.</p>
      </div>
    </div>

    <%= form_with model: @family_member, url: preferences_path, method: :patch, class: "space-y-6" do |f| %>
      <% if @family_member.errors.any? %>
        <div class="p-4 rounded-2xl bg-rose-50 dark:bg-rose-950/60 border border-rose-200 dark:border-rose-800 text-rose-800 dark:text-rose-300 text-xs">
          <p class="font-bold mb-1">Please fix the following:</p>
          <ul class="list-disc list-inside space-y-0.5">
            <% @family_member.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <!-- Display Name -->
      <div>
        <%= f.label :name, "Display Name / Nickname", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5" %>
        <%= f.text_field :name, placeholder: "e.g. Dad, Sarah, Little Chef", required: true,
              class: "w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white font-semibold text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" %>
      </div>

      <!-- Avatar Icon Picker -->
      <div>
        <span class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2.5">Avatar Kitchen Icon</span>
        <div class="grid grid-cols-4 sm:grid-cols-8 gap-x-2.5 gap-y-3.5">
          <% FamilyMember::AVATAR_ICONS.each do |icon_name| %>
            <label class="cursor-pointer group flex flex-col items-center">
              <%= f.radio_button :avatar_icon, icon_name, class: "sr-only peer" %>
              <div class="w-10 h-10 rounded-xl border-2 border-slate-200 dark:border-slate-700 peer-checked:border-slate-900 dark:peer-checked:border-white peer-checked:bg-slate-900 dark:peer-checked:bg-white peer-checked:text-white dark:peer-checked:text-slate-900 text-slate-600 dark:text-slate-300 flex items-center justify-center transition-all group-hover:scale-105 shadow-2xs">
                <%= icon_tag(icon_name, css_class: "w-5 h-5") %>
              </div>
              <span class="text-[9.5px] font-medium text-slate-500 dark:text-slate-400 mt-1.5 capitalize text-center truncate max-w-full">
                <%= icon_name.tr("-", " ") %>
              </span>
            </label>
          <% end %>
        </div>
      </div>

      <!-- Theme Accent Color Palette -->
      <div>
        <span class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2.5">Kitchen Theme Accent Color</span>
        <div class="grid grid-cols-4 sm:grid-cols-6 gap-x-3 gap-y-4">
          <% [
            ["#F97316", "Carrot"],
            ["#3B82F6", "Ocean"],
            ["#10B981", "Sage"],
            ["#F59E0B", "Amber"],
            ["#EF4444", "Chili"],
            ["#8B5CF6", "Plum"],
            ["#EC4899", "Berry"],
            ["#14B8A6", "Mint"],
            ["#6366F1", "Twilight"],
            ["#84CC16", "Olive"],
            ["#06B6D4", "Sky"],
            ["#64748B", "Graphite"]
          ].each do |hex, label| %>
            <label class="cursor-pointer group flex flex-col items-center">
              <%= f.radio_button :avatar_color, hex, class: "sr-only peer" %>
              <div class="w-10 h-10 rounded-xl shadow-2xs border border-black/10 dark:border-white/10 peer-checked:ring-2 peer-checked:ring-offset-2 dark:peer-checked:ring-offset-slate-900 peer-checked:ring-slate-900 dark:peer-checked:ring-white transition-all flex items-center justify-center group-hover:scale-105"
                   style="background-color: <%= hex %>">
                <span class="opacity-0 peer-checked:opacity-100 text-white font-black text-xs drop-shadow-sm">✓</span>
              </div>
              <span class="text-[10px] font-semibold text-slate-600 dark:text-slate-400 mt-2 text-center truncate max-w-full">
                <%= label %>
              </span>
            </label>
          <% end %>
        </div>
      </div>

      <!-- Security / PIN Settings -->
      <% if @family_member.admin? %>
        <div class="pt-4 border-t border-slate-100 dark:border-slate-800">
          <div class="flex items-center gap-2 mb-1">
            <span class="text-sm">🔒</span>
            <label for="family_member_pin" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Admin 4-Digit Security PIN</label>
          </div>
          <p class="text-xs text-slate-500 dark:text-slate-400 mb-2">
            Your 4-digit PIN is required to unlock administrative privileges and switch into this profile.
            Leave this blank to keep your current PIN.
          </p>
          <div class="max-w-xs relative" data-controller="configured-field">
            <%= f.password_field :pin, value: nil, maxlength: 4, placeholder: "••••", pattern: "[0-9]*", inputmode: "numeric", autocomplete: "new-password",
                  data: { configured_field_target: "input", action: "focus->configured-field#hide blur->configured-field#update input->configured-field#update" },
                  class: "w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-center text-lg font-mono tracking-widest focus:outline-none focus:ring-2 focus:ring-primary-500" %>
            <% if @family_member.pin_digest.present? %>
              <span data-configured-field-target="indicator"
                    class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-[11px] font-bold text-emerald-600 dark:text-emerald-400">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5"></span>Configured
              </span>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Submit Button -->
      <div class="pt-4 flex items-center justify-end border-t border-slate-100 dark:border-slate-800">
        <%= f.submit "Save Preferences", 
              class: "px-6 py-2.5 rounded-xl bg-primary-600 hover:bg-primary-500 text-white font-bold text-xs shadow-sm cursor-pointer transition-all hover:scale-105" %>
      </div>
    <% end %>
  </div>

  <!-- SECTION 2: Passkeys & Connected Devices -->
  <% if current_user && !Current.session&.kiosk? %>
    <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/80 dark:border-slate-800 p-6 sm:p-8 shadow-xs">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-2xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
            🔑
          </div>
          <div>
            <h2 class="text-base font-extrabold text-slate-900 dark:text-white tracking-tight">Passkeys & Connected Devices</h2>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
              Manage Face ID / Touch ID passkeys (<%= current_user.passkeys.count %> configured) and inspect active device sessions.
            </p>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <%= link_to "Passkeys", passkeys_path, class: "px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 text-xs font-bold transition-colors" %>
          <%= link_to "Devices", devices_path, class: "px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 text-xs font-bold transition-colors" %>
        </div>
      </div>
    </div>
  <% end %>

  <!-- SECTION 3: Household & Family Roster Management Link -->
  <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/80 dark:border-slate-800 p-6 sm:p-8 shadow-xs">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 flex items-center justify-center shrink-0">
          <%= icon_tag("cog", css_class: "w-5 h-5") %>
        </div>
        <div>
          <h2 class="text-base font-extrabold text-slate-900 dark:text-white tracking-tight">Household & Calendar Settings</h2>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
            Manage household name, meal schedule hours, Google Calendar sync, and full roster.
          </p>
        </div>
      </div>

      <div>
        <% if Current.session&.kiosk? %>
          <span class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 text-xs font-semibold">
            <span>📺 Kitchen Kiosk Mode</span>
          </span>
        <% elsif @family_member.admin? %>
          <%= link_to admin_root_path, class: "inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-900 dark:bg-slate-800 hover:bg-slate-800 dark:hover:bg-slate-700 text-white text-xs font-bold shadow-xs transition-colors" do %>
            <span>Open Admin Dashboard →</span>
          <% end %>
        <% else %>
          <% admin_member = @family_members.find(&:admin?) %>
          <% if admin_member %>
            <button type="button"
                    data-controller="pin-launcher" data-pin-launcher-modal-value="nav" data-pin-launcher-member-id-value="<%= admin_member.id %>" data-pin-launcher-member-name-value="<%= admin_member.name %>" data-pin-launcher-member-color-value="<%= admin_member.avatar_color %>" data-pin-launcher-member-initial-value="<%= admin_member.initial %>" data-action="click->pin-launcher#open"
                    class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-white text-xs font-bold shadow-xs transition-colors cursor-pointer">
              <span>🔒 Unlock Admin as <%= admin_member.name %></span>
            </button>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
