<!DOCTYPE html>
<html class="h-full bg-slate-50 dark:bg-slate-950 antialiased">
  <head>
    <title><%= content_for(:title) || "FamilyPlates | 5-Minute Family Meal Planner" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover">
    
    <!-- PWA & Mobile Web App Meta -->
    <meta name="application-name" content="FamilyPlates">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="FamilyPlates">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="format-detection" content="telephone=no">
    
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ea580c">
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0f172a">
    
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <!-- Immediate Theme Initialization (Follows System Setting by Default without FOUC) -->
    <script>
      (function() {
        const theme = localStorage.getItem('familyplates_theme') || 'system';
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (theme === 'dark' || (theme === 'system' && prefersDark)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <script>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/service-worker.js").catch(() => {});
        });
      }
    </script>

    <style>
      :root {
        --user-accent: <%= current_family_member&.avatar_color || '#ea580c' %>;
      }
      /* Prevent iOS tap highlight gray box */
      * {
        -webkit-tap-highlight-color: transparent;
      }
    </style>
  </head>

  <body class="min-h-full flex flex-col font-sans text-slate-900 dark:text-slate-100 bg-slate-50 dark:bg-slate-950 selection:bg-primary-500 selection:text-white pb-[calc(5.5rem+env(safe-area-inset-bottom))] md:pb-12 transition-colors duration-150">
    <%= render "shared/navbar" %>

    <main class="flex-1 max-w-7xl w-full mx-auto px-3.5 sm:px-6 lg:px-8 py-5 sm:py-8">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>

    <%= render "shared/nav_pin_modal" %>
    <%= render "shared/confirm_modal" %>
  </body>
</html>
