<!DOCTYPE html>
<html class="h-full bg-slate-100 dark:bg-slate-950 text-slate-900 dark:text-slate-100 antialiased">
  <head>
    <title><%= content_for(:title) || "FamilyPlates | Fridge Calendar" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Immediate Theme Initialization (Follows System Setting by Default) -->
    <script nonce="<%= content_security_policy_nonce %>">
      (function() {
        const theme = localStorage.getItem('familyplates_theme') || 'system';
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (theme === 'dark' || (theme === 'system' && prefersDark)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    
    <style>
      @page {
        size: letter landscape;
        margin: 0.3in;
      }
      @media print {
        html, body {
          background: white !important;
          color: #0f172a !important;
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
          padding: 0 !important;
          margin: 0 !important;
          width: 100% !important;
          height: 100% !important;
        }
        .no-print {
          display: none !important;
        }
        .page-container {
          max-width: 100% !important;
          width: 100% !important;
          height: 100vh !important;
          margin: 0 !important;
          padding: 0 !important;
          box-shadow: none !important;
          page-break-inside: avoid !important;
          page-break-after: avoid !important;
        }
      }
    </style>
  </head>

  <body class="bg-slate-100 dark:bg-slate-950 p-4 sm:p-6 font-sans min-h-screen text-slate-900 dark:text-slate-100">
    <div class="page-container max-w-6xl w-full mx-auto flex flex-col justify-between">
      <%= yield %>
    </div>
  </body>
</html>
