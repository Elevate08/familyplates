<div class="min-h-[75vh] flex flex-col items-center justify-center py-6 sm:py-12 px-2 sm:px-4" data-controller="dropdown">
  <div class="text-center mb-8 sm:mb-10">
    <div class="inline-flex items-center justify-center w-14 h-14 sm:w-16 sm:h-16 rounded-3xl bg-primary-100 dark:bg-primary-950/80 text-primary-600 dark:text-primary-400 mb-3 sm:mb-4 shadow-sm">
      <%= icon_tag("chef-hat", css_class: "w-7 h-7 sm:w-8 sm:h-8") %>
    </div>
    <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
      Who's in the kitchen today?
    </h1>
    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1.5 sm:mt-2">
      Select your profile to customize your planner theme and submit cravings
    </p>
  </div>

  <!-- Profile Responsive Grid -->
  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 sm:gap-6 max-w-3xl w-full justify-items-center mb-8">
    <% @family_members.each do |member| %>
      <div class="group relative flex flex-col items-center w-full max-w-[160px]">
        <% if member.requires_pin? %>
          <!-- Trigger PIN Modal -->
          <button type="button" 
                  data-controller="pin-launcher" data-pin-launcher-modal-value="select" data-pin-launcher-member-id-value="<%= member.id %>" data-pin-launcher-member-name-value="<%= member.name %>" data-pin-launcher-member-color-value="<%= member.avatar_color %>" data-pin-launcher-member-initial-value="<%= member.initial %>" data-action="click->pin-launcher#open"
                  class="w-full flex flex-col items-center p-3 rounded-3xl hover:bg-slate-50 dark:hover:bg-slate-800/60 transition-all cursor-pointer">
            <div class="relative w-20 h-20 sm:w-28 sm:h-28 rounded-3xl flex items-center justify-center shadow-lg transition-transform group-hover:scale-105 group-hover:shadow-xl"
                 style="background-color: <%= member.avatar_color %>">
              <span class="text-white text-2xl sm:text-3xl font-extrabold drop-shadow-sm"><%= member.initial %></span>
              <!-- Lock Badge -->
              <span class="absolute -top-1 -right-1 w-6 h-6 sm:w-7 sm:h-7 bg-slate-900 text-white rounded-full flex items-center justify-center text-[10px] sm:text-xs shadow-md border-2 border-white dark:border-slate-900">
                🔒
              </span>
            </div>
            <span class="mt-2.5 sm:mt-3 font-bold text-xs sm:text-sm text-slate-800 dark:text-slate-200 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors truncate max-w-full text-center">
              <%= member.name %>
            </span>
            <span class="text-[9.5px] sm:text-[10px] text-slate-400 dark:text-slate-500 font-semibold uppercase">PIN Protected</span>
          </button>
        <% else %>
          <%= button_to set_profile_path(member), method: :post,
                class: "w-full flex flex-col items-center p-3 rounded-3xl hover:bg-slate-50 dark:hover:bg-slate-800/60 transition-all cursor-pointer" do %>
            <div class="relative w-20 h-20 sm:w-28 sm:h-28 rounded-3xl flex items-center justify-center shadow-lg transition-transform group-hover:scale-105 group-hover:shadow-xl"
                 style="background-color: <%= member.avatar_color %>">
              <span class="text-white text-2xl sm:text-3xl font-extrabold drop-shadow-sm"><%= member.initial %></span>
              <% if member.admin? %>
                <span class="absolute -top-1 -right-1 w-6 h-6 sm:w-7 sm:h-7 bg-amber-500 text-white rounded-full flex items-center justify-center text-[10px] sm:text-xs shadow-md border-2 border-white dark:border-slate-900" title="Admin">
                  ⭐
                </span>
              <% end %>
            </div>
            <span class="mt-2.5 sm:mt-3 font-bold text-xs sm:text-sm text-slate-800 dark:text-slate-200 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors truncate max-w-full text-center">
              <%= member.name %>
            </span>
            <span class="text-[9.5px] sm:text-[10px] text-slate-400 dark:text-slate-500 font-semibold uppercase"><%= member.role %></span>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# Both links need a session - /preferences edits the signed-in member - so
      the whole row is for someone who has already picked a profile and has come
      back here to switch. A stranger following My Preferences was redirected
      straight back to this page. %>
  <% if current_family_member %>
    <!-- Profile Settings & Admin Links -->
    <div class="w-full text-center flex items-center justify-center gap-3 sm:gap-4 flex-wrap">
      <%= link_to "🎨 My Preferences", preferences_path, class: "text-xs font-bold text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors" %>
      <% if current_family_member.admin? %>
        <span class="text-slate-300 dark:text-slate-700">&bull;</span>
        <%= link_to "⚙️ Admin Control Center", admin_root_path, class: "text-xs font-bold text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors" %>
      <% end %>
    </div>
  <% end %>

  <!-- PIN Entry Modal -->
  <div id="pin-modal" class="hidden fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-6 sm:p-8 max-w-sm w-full shadow-2xl animate-in fade-in zoom-in-95 text-slate-900 dark:text-slate-100">
      <div class="text-center mb-5">
        <div id="select-pin-avatar" class="relative w-14 h-14 rounded-2xl flex items-center justify-center text-white text-2xl font-extrabold shadow-md mx-auto mb-3 transition-colors"
             style="background-color: #3B82F6;">
          <span id="select-pin-avatar-initial">?</span>
          <span class="absolute -bottom-1 -right-1 w-5 h-5 bg-slate-900 text-white rounded-full flex items-center justify-center text-[10px] shadow-sm border-2 border-white dark:border-slate-900">🔒</span>
        </div>
        <h3 class="text-lg font-extrabold text-slate-900 dark:text-white" id="pin-modal-title">Enter Admin PIN</h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Enter the 4-digit security PIN for this profile</p>
      </div>

      <form id="pin-form" method="post" action="">
        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
        <div class="mb-5">
          <input type="password" name="pin" id="pin-input" maxlength="4" autofocus pattern="[0-9]*" inputmode="numeric" placeholder="••••" required
                 class="w-full text-center text-2xl tracking-[0.5em] font-mono py-3 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none transition-all">
        </div>

        <div class="flex items-center gap-3">
          <button type="button" data-controller="pin-launcher" data-pin-launcher-modal-value="select" data-action="click->pin-launcher#close" class="w-1/2 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 text-xs font-bold text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 cursor-pointer">
            Cancel
          </button>
          <button type="submit" id="select-pin-submit" class="w-1/2 py-2.5 rounded-xl text-white text-xs font-bold shadow-sm transition-all hover:brightness-110 cursor-pointer"
                  style="background-color: #3B82F6;">
            Unlock Profile
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script nonce="<%= content_security_policy_nonce %>">
  function openPinModal(memberId, memberName, memberColor, memberInitial) {
    const modal = document.getElementById('pin-modal');
    const form = document.getElementById('pin-form');
    const title = document.getElementById('pin-modal-title');
    const input = document.getElementById('pin-input');
    const avatar = document.getElementById('select-pin-avatar');
    const avatarInitial = document.getElementById('select-pin-avatar-initial');
    const submitBtn = document.getElementById('select-pin-submit');

    const color = memberColor || '#3B82F6';
    const initial = memberInitial || (memberName ? memberName.trim()[0].toUpperCase() : '?');

    if (form && modal && title && input) {
      form.action = '/set_profile/' + memberId;
      title.textContent = 'Enter PIN for ' + memberName;

      if (avatar) avatar.style.backgroundColor = color;
      if (avatarInitial) avatarInitial.textContent = initial;
      if (submitBtn) {
        submitBtn.style.backgroundColor = color;
        submitBtn.style.boxShadow = '0 4px 14px ' + color + '40';
      }
      if (input) {
        input.style.borderColor = color;
        input.onfocus = () => { input.style.boxShadow = '0 0 0 3px ' + color + '33'; };
        input.onblur = () => { input.style.boxShadow = 'none'; };
      }

      modal.classList.remove('hidden');
      input.value = '';
      setTimeout(() => input.focus(), 100);
    }
  }

  function closePinModal() {
    document.getElementById('pin-modal').classList.add('hidden');
  }

  <% if params[:pin_member_id].present? && (pin_member = @family_members.find_by(id: params[:pin_member_id])) %>
    document.addEventListener("DOMContentLoaded", function() {
      openPinModal('<%= pin_member.id %>', '<%= j pin_member.name %>', '<%= pin_member.avatar_color %>', '<%= pin_member.initial %>');
    });
  <% end %>
</script>
