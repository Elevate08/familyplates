<div class="min-h-[75vh] flex flex-col items-center justify-center py-12 px-4" data-controller="dropdown">
  <div class="text-center mb-10">
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-3xl bg-orange-100 text-orange-600 mb-4 shadow-sm">
      <%= icon_tag("chef-hat", css_class: "w-8 h-8") %>
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
      Who's in the kitchen today?
    </h1>
    <p class="text-sm text-slate-500 mt-2">
      Select your profile to customize your planner theme and submit cravings
    </p>
  </div>

  <!-- Profile Grid -->
  <div class="flex flex-wrap items-center justify-center gap-6 max-w-3xl">
    <% @family_members.each do |member| %>
      <div class="group relative flex flex-col items-center">
        <% if member.requires_pin? %>
          <!-- Trigger PIN Modal -->
          <button type="button" 
                  onclick="openPinModal('<%= member.id %>', '<%= j member.name %>')"
                  class="flex flex-col items-center p-3 rounded-3xl hover:bg-slate-50 transition-all cursor-pointer">
            <div class="relative w-24 h-24 sm:w-28 sm:h-28 rounded-3xl flex items-center justify-center shadow-lg transition-transform group-hover:scale-105 group-hover:shadow-xl"
                 style="background-color: <%= member.avatar_color %>">
              <span class="text-white text-3xl font-extrabold drop-shadow-sm"><%= member.initial %></span>
              <!-- Lock Badge -->
              <span class="absolute -top-1 -right-1 w-7 h-7 bg-slate-900 text-white rounded-full flex items-center justify-center text-xs shadow-md border-2 border-white">
                🔒
              </span>
            </div>
            <span class="mt-3 font-bold text-sm text-slate-800 group-hover:text-orange-600 transition-colors">
              <%= member.name %>
            </span>
            <span class="text-[10px] text-slate-400 font-semibold uppercase">PIN Protected</span>
          </button>
        <% else %>
          <%= button_to set_profile_path(member), method: :post,
                class: "flex flex-col items-center p-3 rounded-3xl hover:bg-slate-50 transition-all cursor-pointer" do %>
            <div class="relative w-24 h-24 sm:w-28 sm:h-28 rounded-3xl flex items-center justify-center shadow-lg transition-transform group-hover:scale-105 group-hover:shadow-xl"
                 style="background-color: <%= member.avatar_color %>">
              <span class="text-white text-3xl font-extrabold drop-shadow-sm"><%= member.initial %></span>
              <% if member.admin? %>
                <span class="absolute -top-1 -right-1 w-7 h-7 bg-amber-500 text-white rounded-full flex items-center justify-center text-xs shadow-md border-2 border-white" title="Admin">
                  ⭐
                </span>
              <% end %>
            </div>
            <span class="mt-3 font-bold text-sm text-slate-800 group-hover:text-orange-600 transition-colors">
              <%= member.name %>
            </span>
            <span class="text-[10px] text-slate-400 font-semibold uppercase"><%= member.role %></span>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <!-- Manage Profiles Link -->
    <div class="w-full text-center mt-6">
      <%= link_to "Manage Family Profiles →", family_members_path, class: "text-xs font-bold text-slate-500 hover:text-slate-900 transition-colors" %>
    </div>
  </div>

  <!-- PIN Entry Modal -->
  <div id="pin-modal" class="hidden fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 max-w-sm w-full shadow-2xl animate-in fade-in zoom-in-95">
      <div class="text-center mb-5">
        <div class="w-12 h-12 rounded-2xl bg-amber-100 text-amber-700 flex items-center justify-center mx-auto mb-2 text-xl">
          🔒
        </div>
        <h3 class="text-lg font-bold text-slate-900" id="pin-modal-title">Enter Admin PIN</h3>
        <p class="text-xs text-slate-500 mt-0.5">Enter the 4-digit security PIN for this profile</p>
      </div>

      <form id="pin-form" method="post" action="">
        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
        <div class="mb-5">
          <input type="password" name="pin" id="pin-input" maxlength="4" autofocus pattern="[0-9]*" inputmode="numeric" placeholder="••••" required
                 class="w-full text-center text-2xl tracking-[0.5em] font-mono py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-orange-500 focus:outline-none">
        </div>

        <div class="flex items-center gap-3">
          <button type="button" onclick="closePinModal()" class="w-1/2 py-2.5 rounded-xl border border-slate-200 text-xs font-bold text-slate-600 hover:bg-slate-50">
            Cancel
          </button>
          <button type="submit" class="w-1/2 py-2.5 rounded-xl bg-orange-600 hover:bg-orange-500 text-white text-xs font-bold shadow-sm transition-colors">
            Unlock Profile
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function openPinModal(memberId, memberName) {
    const modal = document.getElementById('pin-modal');
    const form = document.getElementById('pin-form');
    const title = document.getElementById('pin-modal-title');
    const input = document.getElementById('pin-input');

    form.action = '/set_profile/' + memberId;
    title.textContent = 'Enter PIN for ' + memberName;
    modal.classList.remove('hidden');
    input.value = '';
    setTimeout(() => input.focus(), 100);
  }

  function closePinModal() {
    document.getElementById('pin-modal').classList.add('hidden');
  }
</script>
