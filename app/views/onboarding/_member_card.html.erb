<div id="member-<%= member.id %>" class="p-4 sm:p-5 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/70 dark:border-slate-700 flex items-center justify-between gap-4 transition-all">
  <div class="flex items-center gap-3.5">
    <div class="w-12 h-12 rounded-2xl flex items-center justify-center text-white shadow-xs font-bold"
         style="background-color: <%= member.avatar_color %>">
      <%= icon_tag(member.avatar_icon.presence || "chef-hat", css_class: "w-6 h-6") %>
    </div>
    <div>
      <div class="flex items-center gap-2">
        <h3 class="font-bold text-slate-900 dark:text-white text-base"><%= member.name %></h3>
        <% if member.admin? %>
          <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-amber-100 dark:bg-amber-950/80 text-amber-800 dark:text-amber-300">Admin</span>
        <% else %>
          <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300">Member</span>
        <% end %>
        <% if member == current_family_member %>
          <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-primary-100 dark:bg-primary-950/80 text-primary-700 dark:text-primary-300">Organizer</span>
        <% end %>
      </div>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
        <% if member.admin? %>
          <span class="text-emerald-700 dark:text-emerald-400 font-medium">🔒 4-digit PIN Active</span>
        <% else %>
          <span>Standard Profile (1-Tap Switch)</span>
        <% end %>
      </p>
    </div>
  </div>

  <% if current_household.family_members.count > 1 && (!member.admin? || current_household.family_members.where(role: "admin").count > 1) %>
    <%= button_to onboarding_remove_member_path(member), method: :delete,
          data: { turbo_confirm: "Remove #{member.name} from the family roster?" },
          class: "p-2 rounded-xl text-slate-400 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-colors cursor-pointer" do %>
      <%= icon_tag("trash", css_class: "w-4 h-4") %>
    <% end %>
  <% end %>
</div>
