<div id="add-member-form-container" class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/80 dark:border-slate-800 p-6 sm:p-8 shadow-sm mb-10" data-controller="onboarding-avatar">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-5">
    <h2 class="text-base font-extrabold text-slate-900 dark:text-white flex items-center gap-2">
      <%= icon_tag("plus", css_class: "w-5 h-5 text-primary-500") %>
      <span>Add Another Family Member</span>
    </h2>

    <% if local_assigns[:status_message].present? %>
      <div id="member-added-status" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-emerald-50 dark:bg-emerald-950/80 border border-emerald-200 dark:border-emerald-700 text-xs font-bold text-emerald-800 dark:text-emerald-300 shadow-xs animate-in fade-in zoom-in-95 duration-200" role="status">
        <span class="text-emerald-600 dark:text-emerald-400"><%= icon_tag("check", css_class: "w-4 h-4") %></span>
        <span><%= status_message %></span>
      </div>
    <% end %>
  </div>

  <%= form_with model: new_member, url: onboarding_add_member_path, id: "new-member-form", class: "space-y-6" do |f| %>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :name, "Name or Nickname", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5" %>
        <%= f.text_field :name, value: "", placeholder: "e.g. Mom, Maya, Leo, Alex", required: true, autofocus: true,
              data: { onboarding_avatar_target: "nameInput", action: "input->onboarding-avatar#updatePreview" },
              class: "w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" %>
      </div>

      <div>
        <%= f.label :role, "Kitchen Role", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5" %>
        <%= f.select :role, [["Family Member (1-Tap Switching)", "member"], ["Organizer / Parent (Admin)", "admin"]], {},
              data: { onboarding_avatar_target: "roleSelect", action: "change->onboarding-avatar#toggleRolePin" },
              class: "themed-select w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" %>
      </div>
    </div>

    <!-- Icon Picker -->
    <div>
      <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">Avatar Icon</label>
      <div class="grid grid-cols-4 sm:grid-cols-8 gap-2">
        <% FamilyMember::AVATAR_ICONS.each_with_index do |icon_name, idx| %>
          <% is_selected = (new_member.avatar_icon == icon_name) || (new_member.avatar_icon.blank? && idx == 0) %>
          <label class="cursor-pointer group flex flex-col items-center">
            <%= f.radio_button :avatar_icon, icon_name, checked: is_selected, class: "sr-only peer", data: { action: "change->onboarding-avatar#changeIcon" } %>
            <div class="w-11 h-11 rounded-2xl border-2 border-slate-200 dark:border-slate-700 peer-checked:border-slate-900 dark:peer-checked:border-white peer-checked:bg-slate-900 dark:peer-checked:bg-white peer-checked:text-white dark:peer-checked:text-slate-900 text-slate-600 dark:text-slate-300 flex items-center justify-center transition-all group-hover:scale-105 shadow-xs">
              <%= icon_tag(icon_name, css_class: "w-5 h-5") %>
            </div>
            <span class="text-[10px] font-medium text-slate-400 dark:text-slate-500 mt-1 capitalize text-center truncate max-w-full">
              <%= icon_name.tr("-", " ") %>
            </span>
          </label>
        <% end %>
      </div>
    </div>

    <!-- Color Swatches -->
    <div>
      <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">Profile Accent Color</label>
      <div class="flex flex-wrap items-center gap-2.5">
        <% FamilyMember::AVATAR_COLORS.each_with_index do |color, idx| %>
          <% is_selected = (new_member.avatar_color == color) || (new_member.avatar_color.blank? && idx == 0) %>
          <label class="cursor-pointer">
            <%= f.radio_button :avatar_color, color, checked: is_selected, class: "sr-only peer", data: { action: "change->onboarding-avatar#changeColor" } %>
            <span class="inline-block w-8 h-8 rounded-full shadow-xs peer-checked:ring-4 peer-checked:ring-offset-2 dark:peer-checked:ring-offset-slate-900 peer-checked:ring-slate-900 dark:peer-checked:ring-white peer-checked:scale-110 transition-all"
                  style="background-color: <%= color %>"></span>
          </label>
        <% end %>
      </div>
    </div>

    <div data-onboarding-avatar-target="pinSection" class="hidden">
      <%= f.label :pin, "4-Digit PIN (Required for Admin Role)", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5" %>
      <div class="max-w-xs">
        <%= f.password_field :pin, maxlength: 4, placeholder: "••••", pattern: "[0-9]*", inputmode: "numeric",
              class: "w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-sm font-mono tracking-widest focus:outline-none focus:ring-2 focus:ring-primary-500" %>
      </div>
      <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">Locks admin profile switching.</p>
    </div>

    <div class="pt-2">
      <%= f.submit "+ Add to Family", class: "py-2.5 px-6 rounded-xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-bold text-xs shadow-sm cursor-pointer transition-all hover:scale-105" %>
    </div>
  <% end %>
</div>
