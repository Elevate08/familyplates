<% is_admin = Current.family_member&.admin? %>
<% planner_week_path = meal_plans_path(week: @range.from.iso8601) %>
<% used_item_ids = Set.new %>
<div class="max-w-3xl mx-auto py-4" data-controller="checklist"
     data-checklist-from-value="<%= @range.from.iso8601 %>"
     data-checklist-to-value="<%= @range.to.iso8601 %>"
     data-checklist-range-label-value="<%= @range.label %>"
     data-checklist-ticks-url-value="<%= grocery_ticks_path %>"
     data-checklist-read-only-value="<%= !is_admin %>">
  <div class="bg-white/95 dark:bg-slate-900/95 backdrop-blur-md p-3.5 sm:p-6 rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-xs mb-6 sticky top-16 sm:top-20 z-30">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-2">
          <h1 class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white tracking-tight">
            Grocery List
          </h1>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-100 dark:bg-emerald-950/80 text-emerald-800 dark:text-emerald-300">
            <span data-checklist-target="remaining"><%= @total_shopping_count %></span>&nbsp;left to buy
          </span>
          <span data-checklist-target="offlineBadge" class="hidden items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-extrabold bg-amber-100 dark:bg-amber-950/80 text-amber-900 dark:text-amber-300 border border-amber-300 dark:border-amber-800">
            <span>⚡ Offline Mode</span>
          </span>
          <% unless is_admin %>
            <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 border border-slate-200 dark:border-slate-700">
              Read-Only
            </span>
          <% end %>
        </div>
        <p class="text-xs text-slate-500 dark:text-slate-400 font-medium mt-0.5">
          <%= @range.label %> • <%= pluralize(@meal_count, "meal") %> • <span class="text-amber-700 dark:text-amber-400 font-semibold"><%= @total_pantry_count %> items already on hand</span>
          <% if @total_restock_count.to_i > 0 %>
            • <span class="text-rose-700 dark:text-rose-400 font-semibold"><%= @total_restock_count %> to restock</span>
          <% end %>
        </p>
      </div>

      <div class="flex items-center gap-2">
        <button type="button" 
                data-action="click->checklist#copyList"
                data-checklist-target="copyButton"
                class="inline-flex items-center gap-1.5 text-xs font-bold px-3 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 transition-all cursor-pointer">
          <%= icon_tag("link", css_class: "w-3.5 h-3.5") %>
          <span data-checklist-target="copyButtonText">Copy Plain Text</span>
        </button>

        <% if is_admin %>
          <button type="button" 
                  data-action="click->checklist#resetAll"
                  class="text-xs font-semibold px-3 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 transition-colors cursor-pointer">
            Reset
          </button>
        <% end %>
        <%= link_to "Planner →", planner_week_path, class: "text-xs font-bold px-3.5 py-1.5 rounded-xl bg-primary-50 dark:bg-primary-950/60 text-primary-700 dark:text-primary-400 hover:bg-primary-100 dark:hover:bg-primary-900/60 transition-colors" %>
      </div>
    </div>

    <div class="mt-3 pt-3 border-t border-slate-100 dark:border-slate-800 flex flex-col gap-2" data-testid="grocery-range-bar">
      <div class="flex items-center gap-1 bg-slate-100 dark:bg-slate-800 p-1 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-2xs w-fit max-w-full">
        <%= link_to grocery_list_path(@range.previous.params),
              class: "p-2 rounded-xl text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-white dark:hover:bg-slate-700 transition-all cursor-pointer active:scale-95",
              title: "Previous #{@range.calendar_month? ? 'month' : 'period'}",
              aria: { label: "Previous #{@range.calendar_month? ? 'month' : 'period'}" } do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
        <% end %>
        <span class="px-3 py-1.5 rounded-xl bg-white dark:bg-slate-700 text-slate-900 dark:text-white text-xs sm:text-sm font-extrabold shadow-2xs border border-slate-200/80 dark:border-slate-600 truncate" data-testid="grocery-range-label"><%= @range.label %></span>
        <%= link_to grocery_list_path(@range.following.params),
              class: "p-2 rounded-xl text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-white dark:hover:bg-slate-700 transition-all cursor-pointer active:scale-95",
              title: "Next #{@range.calendar_month? ? 'month' : 'period'}",
              aria: { label: "Next #{@range.calendar_month? ? 'month' : 'period'}" } do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
        <% end %>
      </div>

      <div role="group" aria-label="Shopping period" class="flex items-center gap-1.5 overflow-x-auto -mx-1 px-1 pb-0.5">
        <% active_preset = @range.active_preset %>
        <% @range.presets.each do |key, name, preset_range| %>
          <%= link_to name, grocery_list_path(preset_range.params),
                aria: { current: (key == active_preset ? "true" : nil) },
                class: "shrink-0 text-xs font-bold px-3 py-1.5 rounded-full border transition-colors #{key == active_preset ? 'bg-primary-600 text-white border-primary-600' : 'bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border-slate-200 dark:border-slate-700 hover:bg-slate-200 dark:hover:bg-slate-700'}" %>
        <% end %>
      </div>

      <details class="text-xs" <%= "open" if active_preset.nil? %>>
        <summary class="cursor-pointer font-bold text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white select-none">Custom dates</summary>
        <%= form_with url: grocery_list_path, method: :get, local: true, class: "mt-2 flex flex-wrap items-end gap-2" do %>
          <label class="flex flex-col gap-0.5 font-semibold text-slate-600 dark:text-slate-400">From
            <input type="date" name="from" value="<%= @range.from.iso8601 %>" required
                   class="rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 px-2 py-1.5 text-xs">
          </label>
          <label class="flex flex-col gap-0.5 font-semibold text-slate-600 dark:text-slate-400">To
            <input type="date" name="to" value="<%= @range.to.iso8601 %>" required
                   class="rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 px-2 py-1.5 text-xs">
          </label>
          <button type="submit" class="text-xs font-bold px-3.5 py-2 rounded-xl bg-primary-600 hover:bg-primary-500 text-white transition-colors cursor-pointer">Show list</button>
        <% end %>
      </details>
    </div>
  </div>

  <% if @range.clamped? %>
    <p class="mb-4 px-4 py-2.5 rounded-2xl bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800 text-xs font-semibold text-amber-900 dark:text-amber-300" data-testid="grocery-range-clamped">
      A grocery list covers at most <%= GroceryRange::MAX_DAYS %> days, so this one stops at <%= @range.to.strftime("%b %-d, %Y") %>.
    </p>
  <% end %>

  <% if @aisles.present? && @aisles.any? %>
    <div class="space-y-6 mb-10">
      <% @aisles.each do |aisle, items| %>
        <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/80 dark:border-slate-800 p-5 shadow-2xs">
          <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800 mb-3">
            <h2 class="text-xs font-extrabold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
              <span><%= aisle %></span>
            </h2>
            <span class="text-xs font-semibold text-slate-400 dark:text-slate-500">
              <%= items.count %> <%= "item".pluralize(items.count) %>
            </span>
          </div>

          <div class="space-y-2.5">
            <% items.each do |item| %>
              <%# Stable across reloads (not the loop index), so a saved tick finds its row again. %>
              <% base_id = [ aisle, item[:name], item[:unit] ].map { |part| part.to_s.parameterize }.join("_") %>
              <% item_id = base_id %>
              <% item_id = "#{base_id}_#{used_item_ids.size}" while used_item_ids.include?(item_id) %>
              <% used_item_ids << item_id %>
              <%# A tick saved for this list (from any of the household's devices) beats the default; staples default to checked. %>
              <% ticked = @ticks.key?(item_id) %>
              <% checked = ticked ? @ticks[item_id] : item[:is_staple] %>
              <% row_style = if item[:restock]
                   "bg-rose-50/40 dark:bg-rose-950/25 border-rose-200 dark:border-rose-900 hover:border-rose-300 dark:hover:border-rose-800"
                 elsif item[:is_staple]
                   "bg-amber-50/30 dark:bg-amber-950/30 border-amber-200/80 dark:border-amber-800/80 hover:border-amber-300 dark:hover:border-amber-700"
                 else
                   "bg-white dark:bg-slate-800 border-slate-200/70 dark:border-slate-700 hover:border-slate-300 dark:hover:border-slate-600"
                 end %>
              <div data-checklist-target="item"
                   data-item-id="<%= item_id %>"
                   data-is-staple="<%= item[:is_staple] %>"
                   <%# Ticking a restock line is what tells the pantry the thing
                       was actually bought. The two URLs are both idempotent, so
                       a double tap or a retry costs nothing. %>
                   <% if item[:restock] && item[:pantry_item_id].present? %>
                     data-pantry-item-id="<%= item[:pantry_item_id] %>"
                     data-restock-url="<%= restock_pantry_item_path(item[:pantry_item_id]) %>"
                     data-mark-low-url="<%= mark_low_pantry_item_path(item[:pantry_item_id]) %>"
                   <% end %>
                   <% if is_admin %>data-action="click->checklist#toggle"<% end %>
                   class="flex items-center justify-between p-3.5 rounded-2xl border transition-all <%= is_admin ? 'cursor-pointer' : 'cursor-default select-none' %> <%= row_style %> <%= 'opacity-50' if ticked && checked %>">
                
                <div class="flex items-center gap-3">
                  <input type="checkbox" 
                         value="<%= item_id %>"
                         <%= 'checked' if checked %>
                         <%= 'disabled' unless is_admin %>
                         id="grocery_item_<%= item_id %>"
                         aria-labelledby="grocery_item_<%= item_id %>_name"
                         data-checklist-target="checkbox"
                         data-is-staple="<%= item[:is_staple] %>"
                         class="w-5 h-5 rounded-lg text-emerald-600 focus:ring-emerald-500 border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 <%= is_admin ? 'cursor-pointer' : 'cursor-not-allowed opacity-60' %>">
                  
                  <div class="flex items-center gap-2.5">
                    <div class="w-6 h-6 flex items-center justify-center shrink-0">
                      <%= pantry_icon_tag(item[:name], aisle, css_class: "w-5 h-5") %>
                    </div>
                    <div>
                      <div class="flex items-center gap-2">
                        <span id="grocery_item_<%= item_id %>_name" class="item-label text-sm font-bold text-slate-800 dark:text-slate-200 <%= 'line-through text-slate-400 dark:text-slate-500' if checked %> transition-all">
                          <%= item[:name] %>
                        </span>
                        <% if item[:restock] %>
                          <span class="text-[10px] font-black uppercase tracking-wider px-1.5 py-0.5 rounded bg-rose-100 dark:bg-rose-950/80 text-rose-800 dark:text-rose-300 border border-rose-200 dark:border-rose-800">
                            Restock
                          </span>
                        <% elsif item[:is_staple] %>
                          <span class="text-[10px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded bg-amber-100 dark:bg-amber-950/80 text-amber-800 dark:text-amber-300 border border-amber-200 dark:border-amber-800">
                            On Hand
                          </span>
                        <% end %>
                      </div>

                      <% if item[:quantity].present? && item[:quantity] > 0 %>
                        <span class="item-qty text-xs font-semibold text-slate-500 dark:text-slate-400">
                          <%= item[:quantity] %><% if item[:unit].present? %> <%= item[:unit] %><% end %>
                        </span>
                      <% end %>
                    </div>
                  </div>
                </div>

                <div class="text-[10px] text-slate-400 dark:text-slate-500 font-medium truncate max-w-[140px] text-right">
                  <%# An item flagged low is on the list because someone said
                      so, not because a recipe called for it. %>
                  <%= item[:sources].any? ? item[:sources].first(2).join(", ") : ("Pantry item" if item[:restock]) %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-16 bg-white dark:bg-slate-900 rounded-3xl border border-dashed border-slate-300 dark:border-slate-800 p-8 mb-8">
      <div class="w-12 h-12 rounded-2xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mx-auto mb-3">
        <%= icon_tag("shopping-cart", css_class: "w-6 h-6") %>
      </div>
      <% if @meal_count.zero? %>
        <h3 class="font-bold text-slate-800 dark:text-slate-200 text-lg">No meals planned between <%= @range.from.strftime("%b %-d") %> and <%= @range.to.strftime("%b %-d, %Y") %></h3>
        <p class="text-slate-500 dark:text-slate-400 text-xs mt-1">Schedule breakfast, lunch, or dinner in the planner to automatically compile this list.</p>
      <% else %>
        <h3 class="font-bold text-slate-800 dark:text-slate-200 text-lg">No grocery items needed!</h3>
        <p class="text-slate-500 dark:text-slate-400 text-xs mt-1">The meals planned for this period call for no ingredients.</p>
      <% end %>
      <%= link_to "Go to Planner", planner_week_path, class: "mt-4 inline-block px-5 py-2.5 rounded-xl bg-primary-600 hover:bg-primary-500 text-white font-bold text-xs shadow-sm transition-colors" %>
    </div>
  <% end %>
</div>
