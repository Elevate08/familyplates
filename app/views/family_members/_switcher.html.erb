<div class="relative" data-controller="dropdown">
  <button type="button" 
          data-action="click->dropdown#toggle click@window->dropdown#hide"
          class="flex items-center gap-2 px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-2xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 text-sm font-semibold transition-all border border-slate-200/80 dark:border-slate-700 cursor-pointer shadow-2xs hover:shadow-xs"
          title="Active Profile & Kitchen Settings">
    <% if current_family_member %>
      <span class="inline-flex items-center justify-center w-7 h-7 sm:w-8 sm:h-8 rounded-xl text-xs sm:text-sm font-black text-white shadow-xs shrink-0"
            style="background-color: <%= current_family_member.avatar_color %>">
        <%= current_family_member.initial %>
      </span>
      <div class="flex flex-col text-left leading-tight min-w-0">
        <span class="max-w-[85px] sm:max-w-[120px] truncate font-bold text-xs sm:text-sm text-slate-900 dark:text-white"><%= current_family_member.name %></span>
        <span class="text-[9px] text-slate-400 dark:text-slate-500 font-semibold uppercase tracking-wider"><%= current_family_member.role %></span>
      </div>
    <% else %>
      <span class="inline-flex items-center justify-center w-7 h-7 rounded-xl bg-slate-400 text-xs font-bold text-white shrink-0">
        👤
      </span>
      <span class="font-bold text-xs sm:text-sm">Select Cook</span>
    <% end %>
    <%= icon_tag("chevron-down", css_class: "w-3.5 h-3.5 sm:w-4 sm:h-4 text-slate-400 dark:text-slate-500 shrink-0 ml-0.5") %>
  </button>

  <div data-dropdown-target="menu" 
       class="hidden absolute right-0 mt-2 w-72 rounded-3xl bg-white dark:bg-slate-800 shadow-2xl border border-slate-200/90 dark:border-slate-700 py-3 z-50 animate-in fade-in zoom-in-95 duration-100">
    
    <!-- Active Cook & Account Header (clickable to select_profile_path) -->
    <div class="border-b border-slate-100 dark:border-slate-700/80">
      <%= link_to select_profile_path, class: "group block px-4 py-3 hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors" do %>
        <div class="flex items-center justify-between mb-2">
          <p class="text-[10px] text-slate-400 dark:text-slate-500 font-bold uppercase tracking-wider">Active Cook Profile</p>
          <span class="text-[11px] font-bold text-primary-600 dark:text-primary-400 group-hover:underline flex items-center gap-0.5">
            Switch Profile →
          </span>
        </div>
        <div class="flex items-center gap-2.5">
          <span class="inline-flex items-center justify-center w-9 h-9 rounded-2xl text-sm font-black text-white shadow-sm shrink-0"
                style="background-color: <%= current_family_member&.avatar_color || '#ea580c' %>">
            <%= current_family_member&.initial || '?' %>
          </span>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-1.5">
              <p class="text-sm font-extrabold text-slate-900 dark:text-white truncate group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors"><%= current_family_member&.name || "Default" %></p>
              <% if current_family_member&.admin? %>
                <span class="text-[9.5px] bg-amber-100 dark:bg-amber-950/80 text-amber-800 dark:text-amber-300 font-extrabold px-1.5 py-0.5 rounded-md uppercase">Admin</span>
              <% end %>
            </div>
            <% if current_household %>
              <p class="text-[11px] text-slate-500 dark:text-slate-400 truncate mt-0.5"><%= current_household.name %></p>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Quick Switcher Roster -->
    <% if current_household && current_household.family_members.count > 1 %>
      <div class="py-2 border-b border-slate-100 dark:border-slate-700/80">
        <div class="px-4 pb-1.5 flex items-center justify-between">
          <span class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Quick Switch</span>
        </div>
        <div class="max-h-48 overflow-y-auto themed-scrollbar space-y-0.5 px-1">
          <% current_household.family_members.order(:created_at).each do |member| %>
            <% if member == current_family_member %>
              <div class="w-full flex items-center justify-between px-3 py-1.5 rounded-xl text-xs font-bold text-primary-900 dark:text-primary-300 bg-primary-50/60 dark:bg-primary-950/40">
                <div class="flex items-center gap-2">
                  <span class="inline-flex items-center justify-center w-5 h-5 rounded-lg text-[10px] font-bold text-white shadow-2xs"
                        style="background-color: <%= member.avatar_color %>">
                    <%= member.initial %>
                  </span>
                  <span class="truncate"><%= member.name %></span>
                  <% if member.requires_pin? %>
                    <span class="text-[10px]" title="PIN Protected">🔒</span>
                  <% end %>
                </div>
                <span class="text-primary-600 dark:text-primary-400"><%= icon_tag("check", css_class: "w-3.5 h-3.5") %></span>
              </div>
            <% elsif member.requires_pin? %>
              <button type="button"
                      data-controller="pin-launcher" data-pin-launcher-modal-value="nav" data-pin-launcher-member-id-value="<%= member.id %>" data-pin-launcher-member-name-value="<%= member.name %>" data-pin-launcher-member-color-value="<%= member.avatar_color %>" data-pin-launcher-member-initial-value="<%= member.initial %>" data-action="click->pin-launcher#open"
                      class="w-full text-left flex items-center justify-between px-3 py-1.5 rounded-xl text-xs text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700/60 transition-colors cursor-pointer">
                <div class="flex items-center gap-2">
                  <span class="inline-flex items-center justify-center w-5 h-5 rounded-lg text-[10px] font-bold text-white shadow-2xs"
                        style="background-color: <%= member.avatar_color %>">
                    <%= member.initial %>
                  </span>
                  <span class="truncate"><%= member.name %></span>
                  <span class="text-[10px]" title="PIN Protected">🔒</span>
                </div>
                <span class="text-[9.5px] text-slate-400 dark:text-slate-500 font-semibold uppercase">PIN</span>
              </button>
            <% else %>
              <%= button_to switch_family_member_path(member), 
                            method: :post,
                            class: "w-full text-left flex items-center justify-between px-3 py-1.5 rounded-xl text-xs text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700/60 transition-colors cursor-pointer" do %>
                <div class="flex items-center gap-2">
                  <span class="inline-flex items-center justify-center w-5 h-5 rounded-lg text-[10px] font-bold text-white shadow-2xs"
                        style="background-color: <%= member.avatar_color %>">
                    <%= member.initial %>
                  </span>
                  <span class="truncate"><%= member.name %></span>
                </div>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Kitchen / Household Switcher (for multi-household users) -->
    <% if current_user && current_user.households.distinct.count > 1 %>
      <div class="py-2 border-b border-slate-100 dark:border-slate-700/80">
        <div class="px-4 pb-1.5 flex items-center justify-between">
          <span class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Your Kitchens</span>
        </div>
        <div class="space-y-0.5 px-1">
          <% current_user.family_members.includes(:household).each do |m| %>
            <% is_active_kitchen = (m.household_id == current_household&.id) %>
            <% if is_active_kitchen %>
              <div class="w-full flex items-center justify-between px-3 py-1.5 rounded-xl text-xs font-bold text-primary-900 dark:text-primary-300 bg-primary-50/60 dark:bg-primary-950/40">
                <div class="flex items-center gap-2 truncate">
                  <span class="text-xs">🏠</span>
                  <div class="truncate">
                    <span class="truncate"><%= m.household.name %></span>
                    <span class="text-[10px] text-slate-400 dark:text-slate-500 font-normal ml-1">(as <%= m.name %>)</span>
                  </div>
                </div>
                <span class="text-emerald-600 dark:text-emerald-400 text-[10px] font-extrabold uppercase">Active</span>
              </div>
            <% elsif m.requires_pin? %>
              <button type="button"
                      data-controller="pin-launcher" data-pin-launcher-modal-value="nav" data-pin-launcher-member-id-value="<%= m.id %>" data-pin-launcher-member-name-value="<%= m.name %> (<%= m.household.name %>)" data-pin-launcher-member-color-value="<%= m.avatar_color %>" data-pin-launcher-member-initial-value="<%= m.initial %>" data-action="click->pin-launcher#open"
                      class="w-full text-left flex items-center justify-between px-3 py-1.5 rounded-xl text-xs text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700/60 transition-colors cursor-pointer">
                <div class="flex items-center gap-2 truncate">
                  <span class="text-xs">🏠</span>
                  <div class="truncate">
                    <span class="truncate font-semibold"><%= m.household.name %></span>
                    <span class="text-[10px] text-slate-400 dark:text-slate-500 font-normal ml-1">(as <%= m.name %>)</span>
                  </div>
                </div>
                <span class="text-[9.5px] text-slate-400 dark:text-slate-500 font-semibold uppercase">PIN 🔒</span>
              </button>
            <% else %>
              <%= button_to switch_family_member_path(m), 
                            method: :post,
                            class: "w-full text-left flex items-center justify-between px-3 py-1.5 rounded-xl text-xs text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700/60 transition-colors cursor-pointer" do %>
                <div class="flex items-center gap-2 truncate">
                  <span class="text-xs">🏠</span>
                  <div class="truncate">
                    <span class="truncate font-semibold"><%= m.household.name %></span>
                    <span class="text-[10px] text-slate-400 dark:text-slate-500 font-normal ml-1">(as <%= m.name %>)</span>
                  </div>
                </div>
                <span class="text-primary-600 dark:text-primary-400 text-xs font-semibold">Switch →</span>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Navigation & Settings Links -->
    <div class="pt-2 px-2 space-y-0.5">
      <%= link_to preferences_path, class: "flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700/60 transition-colors" do %>
        <%= icon_tag("sparkles", css_class: "w-4 h-4 text-primary-500") %>
        <span>My Preferences</span>
      <% end %>

      <% if current_family_member&.admin? && !Current.session&.kiosk? %>
        <%= link_to admin_root_path, class: "flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700/60 transition-colors" do %>
          <%= icon_tag("cog", css_class: "w-4 h-4 text-slate-500 dark:text-slate-400") %>
          <span>Admin Dashboard</span>
        <% end %>
      <% end %>
    </div>

    <!-- Sign Out -->
    <div class="border-t border-slate-100 dark:border-slate-700 mt-2 pt-1 px-2">
      <%= button_to session_path, method: :delete, class: "w-full text-left flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-colors cursor-pointer" do %>
        <%= icon_tag("trash", css_class: "w-4 h-4 text-rose-500 dark:text-rose-400") %>
        <span>Sign Out</span>
      <% end %>
    </div>

  </div>
</div>
