<div class="max-w-3xl mx-auto py-6">
  <!-- Header -->
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight flex items-center gap-3">
        <span>Family Members & Kitchen Profiles</span>
        <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-orange-100 text-orange-700">
          <%= @family_members.count %> members
        </span>
      </h1>
      <p class="mt-1 text-sm text-slate-500">
        Personalize display colors, assign cooking duties, and secure organizer profiles with a PIN.
      </p>
    </div>
  </div>

  <!-- Members Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-10">
    <% @family_members.each do |member| %>
      <div class="p-5 rounded-3xl bg-white border border-slate-200/80 shadow-xs flex items-center justify-between hover:border-slate-300 transition-colors">
        <div class="flex items-center gap-3.5">
          <span class="inline-flex items-center justify-center w-12 h-12 rounded-2xl text-base font-bold text-white shadow-sm"
                style="background-color: <%= member.avatar_color %>">
            <%= member.initial %>
          </span>
          <div>
            <div class="flex items-center gap-2">
              <h3 class="font-bold text-slate-900"><%= member.name %></h3>
              <% if member == current_family_member %>
                <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-orange-100 text-orange-700">
                  Active
                </span>
              <% end %>
              <% if member.requires_pin? %>
                <span class="text-xs" title="Protected by 4-digit PIN">🔒</span>
              <% end %>
            </div>
            <p class="text-xs text-slate-400 capitalize"><%= member.role %></p>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <% unless member == current_family_member %>
            <%= button_to "Switch", switch_family_member_path(member), method: :post, 
                  class: "text-xs font-semibold px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors cursor-pointer" %>
          <% end %>

          <% if @family_members.count > 1 %>
            <%= button_to family_member_path(member), method: :delete, data: { turbo_confirm: "Remove #{member.name} from household?" },
                  class: "p-1.5 rounded-xl text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition-colors cursor-pointer" do %>
              <%= icon_tag("trash", css_class: "w-4 h-4") %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Add Member Card -->
  <div class="bg-white p-6 sm:p-8 rounded-3xl border border-slate-200/80 shadow-sm">
    <h2 class="text-lg font-bold text-slate-900 mb-4 flex items-center gap-2">
      <%= icon_tag("plus", css_class: "w-5 h-5 text-orange-500") %>
      <span>Add Family Member</span>
    </h2>

    <%= form_with model: @new_member, url: family_members_path, class: "space-y-5" do |f| %>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <%= f.label :name, "Name or Nickname", class: "block text-xs font-semibold text-slate-700 mb-1" %>
          <%= f.text_field :name, placeholder: "e.g. Leo, Alex, Grandma", required: true,
                class: "w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-orange-500" %>
        </div>

        <div>
          <%= f.label :role, "Role", class: "block text-xs font-semibold text-slate-700 mb-1" %>
          <%= f.select :role, [["Family Member", "member"], ["Organizer / Parent", "admin"]], {},
                class: "w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-orange-500 bg-white" %>
        </div>

        <div>
          <%= f.label :pin, "4-Digit PIN (optional)", class: "block text-xs font-semibold text-slate-700 mb-1" %>
          <%= f.password_field :pin, maxlength: 4, placeholder: "e.g. 1234", pattern: "[0-9]*", inputmode: "numeric",
                class: "w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-orange-500" %>
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-2">Display & Theme Color</label>
        <div class="flex flex-wrap items-center gap-2.5">
          <% FamilyMember::AVATAR_COLORS.each_with_index do |color, idx| %>
            <label class="cursor-pointer">
              <%= f.radio_button :avatar_color, color, checked: (idx == 0), class: "sr-only peer" %>
              <span class="inline-block w-8 h-8 rounded-full shadow-xs peer-checked:ring-4 peer-checked:ring-offset-2 peer-checked:ring-slate-900 peer-checked:scale-110 transition-all"
                    style="background-color: <%= color %>"></span>
            </label>
          <% end %>
        </div>
        <p class="text-[11px] text-slate-400 mt-1.5">Choosing this profile will tint the app with their color.</p>
      </div>

      <div class="pt-2">
        <%= f.submit "Add to Family", class: "py-2.5 px-6 rounded-xl bg-orange-600 hover:bg-orange-500 text-white font-bold text-sm shadow-sm cursor-pointer transition-all" %>
      </div>
    <% end %>
  </div>
</div>
