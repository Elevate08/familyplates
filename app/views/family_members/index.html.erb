<div class="max-w-3xl mx-auto py-6">
  <!-- Header -->
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight flex items-center gap-3">
        <span>Family Members & Kitchen Profiles</span>
        <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-primary-100 text-primary-700">
          <%= @family_members.count %> members
        </span>
      </h1>
      <p class="mt-1 text-sm text-slate-500">
        Personalize display colors, assign cooking duties, and secure organizer profiles with a PIN.
      </p>
    </div>
  </div>

  <!-- Members Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-10">
    <% @family_members.each do |member| %>
      <div class="p-5 rounded-3xl bg-white border border-slate-200/80 shadow-xs flex items-center justify-between hover:border-slate-300 transition-colors">
        <div class="flex items-center gap-3.5">
          <span class="inline-flex items-center justify-center w-12 h-12 rounded-2xl text-base font-bold text-white shadow-sm"
                style="background-color: <%= member.avatar_color %>">
            <%= member.initial %>
          </span>
          <div>
            <div class="flex items-center gap-2">
              <h3 class="font-bold text-slate-900"><%= member.name %></h3>
              <% if member == current_family_member %>
                <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-primary-100 text-primary-700">
                  Active
                </span>
              <% end %>
              <% if member.requires_pin? %>
                <span class="text-xs" title="Protected by 4-digit PIN">🔒</span>
              <% end %>
            </div>
            <p class="text-xs text-slate-400 capitalize"><%= member.role %></p>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <% unless member == current_family_member %>
            <%= button_to "Switch", switch_family_member_path(member), method: :post, 
                  class: "text-xs font-semibold px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors cursor-pointer" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Roster management lives in the Admin Control Center -->
  <% if current_family_member&.admin? %>
    <div class="bg-white p-6 sm:p-8 rounded-3xl border border-slate-200/80 shadow-sm flex items-center justify-between gap-4">
      <div>
        <h2 class="text-lg font-bold text-slate-900 mb-1 flex items-center gap-2">
          <%= icon_tag("plus", css_class: "w-5 h-5 text-primary-500") %>
          <span>Manage the roster</span>
        </h2>
        <p class="text-xs text-slate-500 leading-relaxed">
          Add or remove family members, change roles, and reset organizer PINs.
        </p>
      </div>
      <%= link_to "Open Control Center", admin_family_members_path,
            class: "shrink-0 py-2.5 px-6 rounded-xl bg-primary-600 hover:bg-primary-500 text-white font-bold text-sm shadow-sm transition-all" %>
    </div>
  <% else %>
    <div class="bg-white p-6 rounded-3xl border border-slate-200/80 shadow-sm">
      <p class="text-xs text-slate-500 leading-relaxed">
        Ask a household organizer to add, remove, or change a family member.
        You can update your own name and colors in
        <%= link_to "Preferences", edit_preferences_path, class: "font-semibold text-primary-600 hover:text-primary-500" %>.
      </p>
    </div>
  <% end %>
</div>
