<% @slots_by_key ||= @meal_plan.meal_plan_slots.includes(:recipe, :family_member, :leftover_source_slot).index_by { |s| [s.date, s.meal_type] } %>
<% @leftover_sources ||= @meal_plan.preloaded_leftover_sources %>

<% @meal_plan.days.each do |day| %>
  <% %w[breakfast lunch dinner].each do |meal_type| %>
    <% slot = @slots_by_key[[day, meal_type]] %>
    <% cands = @meal_plan.available_leftovers_for(day, meal_type, current_slot: slot, preloaded_sources: @leftover_sources) %>
    <%= turbo_stream.replace "slot_#{day}_#{meal_type}" do %>
      <%= render "meal_plans/slot",
            meal_plan: @meal_plan,
            date: day,
            meal_type: meal_type,
            slot: slot,
            recipes: @recipes,
            recipes_map: @recipes_map,
            family_members: @family_members,
            leftover_candidates: cands %>
    <% end %>
  <% end %>
<% end %>
