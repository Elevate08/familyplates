<% if @old_date && @old_meal_type && @slot.meal_plan_id != @meal_plan.id %>
  <%= turbo_stream.replace "slot_#{@old_date}_#{@old_meal_type}" do %>
    <%= render "meal_plans/slot", meal_plan: @meal_plan, date: @old_date, meal_type: @old_meal_type %>
  <% end %>
<% end %>

<% plan_to_render = @slot.meal_plan || @meal_plan %>
<% plan_to_render.days.each do |day| %>
  <% %w[breakfast lunch dinner].each do |meal_type| %>
    <%= turbo_stream.replace "slot_#{day}_#{meal_type}" do %>
      <%= render "meal_plans/slot", meal_plan: plan_to_render, date: day, meal_type: meal_type %>
    <% end %>
  <% end %>
<% end %>
