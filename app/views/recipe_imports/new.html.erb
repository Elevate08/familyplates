<div class="max-w-xl mx-auto py-10">
  <div class="text-center mb-8">
    <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-primary-100 text-primary-600 mb-4 shadow-xs">
      <%= icon_tag("link", css_class: "w-7 h-7") %>
    </div>
    <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Import Recipe from Web</h1>
    <p class="mt-2 text-sm text-slate-600">
      Paste a link from your favorite food blog or recipe website. We'll extract the title, prep times, ingredients, and instructions instantly.
    </p>
  </div>

  <div class="bg-white p-8 rounded-3xl border border-slate-200/80 shadow-sm">
    <%= form_with url: recipe_imports_path, method: :post, class: "space-y-5" do |f| %>
      <div>
        <%= f.label :url, "Recipe Web Address (URL)", class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= f.url_field :url, placeholder: "https://www.allrecipes.com/recipe/... or any blog URL", required: true, autofocus: true,
              class: "w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-slate-900" %>
        <p class="text-[11px] text-slate-400 mt-1.5">Supports AllRecipes, NYT Cooking, Serious Eats, Budget Bytes, Food Network, Sally's Baking, and hundreds of independent food blogs.</p>
      </div>

      <%= f.submit "Extract & Preview Recipe ⚡", class: "w-full py-3.5 px-4 rounded-xl bg-primary-600 hover:bg-primary-500 text-white font-bold shadow-md shadow-primary-500/20 cursor-pointer transition-all hover:scale-[1.01]" %>
    <% end %>

    <div class="mt-6 text-center">
      <%= link_to "Cancel and return to Recipe Box", recipes_path, class: "text-xs font-semibold text-slate-500 hover:text-slate-800" %>
    </div>
  </div>
</div>
