<%# The page reloads itself until RecipeImportJob is done; #show then answers with the recipe form or the error. %>
<% content_for :head do %>
  <meta http-equiv="refresh" content="3">
  <%# Without this Turbo merges the tag into the page it is already showing instead of loading this one,
      and a refresh scheduled here could fire after the person has left. %>
  <meta name="turbo-visit-control" content="reload">
<% end %>

<div class="max-w-xl mx-auto py-10">
  <div class="bg-white dark:bg-slate-900 p-8 rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-sm text-center" role="status" aria-live="polite">
    <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-primary-100 dark:bg-primary-950/80 text-primary-600 dark:text-primary-400 mb-4 shadow-xs">
      <span class="block w-7 h-7 rounded-full border-4 border-primary-200 dark:border-primary-900 border-t-primary-600 dark:border-t-primary-400 motion-safe:animate-spin" aria-hidden="true"></span>
    </div>
    <h1 class="text-2xl font-extrabold text-slate-900 dark:text-white tracking-tight">Importing your recipe...</h1>
    <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
      We're reading the recipe from <span class="font-semibold break-all"><%= @import.url %></span>. This page updates by itself and opens the recipe when it's ready.
      The recipe will appear in your recipe box when the import finishes, even if you leave this page.
    </p>
  </div>

  <div class="mt-6 text-center">
    <%= link_to "Back to Recipe Box", recipes_path, class: "text-xs font-semibold text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-white transition-colors" %>
  </div>
</div>
