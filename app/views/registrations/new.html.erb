<div class="max-w-md mx-auto py-8">
  <div class="text-center mb-8">
    <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-gradient-to-tr from-amber-500 to-primary-500 text-white shadow-lg shadow-primary-500/30 mb-4">
      <%= icon_tag("chef-hat", css_class: "w-8 h-8") %>
    </div>
    <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Start Your Family Kitchen</h1>
    <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">Create your household space in seconds.</p>
  </div>

  <div class="bg-white dark:bg-slate-900 p-8 rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-sm">
    <%= form_with url: registration_path, method: :post, class: "space-y-5" do |f| %>
      <div>
        <%= label_tag "household[name]", "Household / Family Name", class: "block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-1" %>
        <%= text_field_tag "household[name]", nil, placeholder: "e.g. The Spencer Family", required: true, autofocus: true,
              class: "w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-slate-900 dark:text-white transition-colors" %>
      </div>

      <div>
        <%= label_tag "family_member_name", "Your Name / Nickname", class: "block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-1" %>
        <%= text_field_tag "family_member_name", nil, placeholder: "e.g. Dad, Sarah, Cook #1", required: true,
              class: "w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-slate-900 dark:text-white transition-colors" %>
        <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">This will be your initial Organizer (Admin) family profile.</p>
      </div>

      <div>
        <%= label_tag "family_member_pin", "Admin 4-Digit Security PIN", class: "block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-1" %>
        <%= password_field_tag "family_member_pin", nil, placeholder: "e.g. 1234", required: true, maxlength: 4, pattern: "[0-9]*", inputmode: "numeric",
              class: "w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-slate-900 dark:text-white font-mono tracking-widest transition-colors" %>
        <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">Used to unlock your Admin profile when switching cooks.</p>
      </div>

      <div>
        <%= label_tag "user[email_address]", "Email Address", class: "block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-1" %>
        <%= email_field_tag "user[email_address]", nil, placeholder: "you@example.com", required: true, autocomplete: "username",
              class: "w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-slate-900 dark:text-white transition-colors" %>
      </div>

      <div>
        <%= label_tag "user[password]", "Password", class: "block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-1" %>
        <%= password_field_tag "user[password]", nil, placeholder: "••••••••", required: true, autocomplete: "new-password", maxlength: 72,
              class: "w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-slate-900 dark:text-white transition-colors" %>
      </div>

      <div>
        <%= label_tag "user[password_confirmation]", "Confirm Password", class: "block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-1" %>
        <%= password_field_tag "user[password_confirmation]", nil, placeholder: "••••••••", required: true, autocomplete: "new-password", maxlength: 72,
              class: "w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-slate-900 dark:text-white transition-colors" %>
      </div>

      <%= f.submit "Create Household Account", class: "w-full py-3.5 px-4 rounded-xl bg-primary-600 hover:bg-primary-500 text-white font-bold shadow-md shadow-primary-500/20 cursor-pointer transition-all hover:scale-[1.01]" %>
    <% end %>

    <div class="mt-6 text-center text-sm text-slate-500 dark:text-slate-400">
      Already have a kitchen? 
      <%= link_to "Sign In", new_session_path, class: "font-semibold text-primary-600 dark:text-primary-400 hover:text-primary-500 underline" %>
    </div>
  </div>
</div>
