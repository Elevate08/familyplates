<div id="<%= dom_id(recipe) %>" class="group relative flex flex-col justify-between rounded-3xl bg-white border border-slate-200/80 hover:border-primary-300 hover:shadow-md transition-all overflow-hidden">
  <!-- Recipe Image Banner -->
  <div class="relative h-44 w-full bg-slate-100 overflow-hidden">
    <img src="<%= recipe.display_image_url %>" alt="<%= recipe.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent"></div>

    <!-- Multi-select checkbox top left -->
    <div class="absolute top-3 left-3 z-10">
      <label class="inline-flex items-center justify-center p-1.5 rounded-xl bg-white/90 backdrop-blur-xs shadow-md border border-white/60 cursor-pointer hover:scale-110 transition-transform">
        <input type="checkbox"
               value="<%= recipe.id %>"
               data-meal-types="<%= recipe.meal_types_list.join(',') %>"
               data-tags="<%= recipe.tag_list.join(',') %>"
               data-bulk-select-target="checkbox"
               data-action="change->bulk-select#toggle"
               class="rounded text-primary-600 focus:ring-primary-500 w-4 h-4 cursor-pointer">
      </label>
    </div>

    <!-- Tags & Meal Types overlay on image -->
    <div class="absolute bottom-3 left-3 right-12 flex flex-wrap gap-1">
      <% recipe.meal_types_list.each do |mt| %>
        <% icon = case mt; when "breakfast" then "☀️"; when "lunch" then "🥪"; else "🍽️"; end %>
        <span class="text-[10px] font-bold px-1.5 py-0.5 rounded-md bg-slate-900/80 backdrop-blur-xs text-white shadow-2xs">
          <%= icon %>
        </span>
      <% end %>
      <% recipe.tag_list.first(2).each do |tag| %>
        <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-white/90 backdrop-blur-xs text-slate-800 shadow-2xs">
          <%= tag %>
        </span>
      <% end %>
    </div>

    <!-- Craving Heart overlay on image top right -->
    <div class="absolute top-3 right-3 bg-white/90 backdrop-blur-xs p-1 rounded-full shadow-md">
      <%= render "recipe_requests/heart_button", recipe: recipe %>
    </div>
  </div>

  <!-- Card Body -->
  <div class="p-5 flex-1 flex flex-col justify-between">
    <div>
      <%= link_to recipe_path(recipe), class: "block" do %>
        <h3 class="text-base font-bold text-slate-900 group-hover:text-primary-600 transition-colors leading-snug">
          <%= recipe.title %>
        </h3>
        <% if recipe.description.present? %>
          <p class="text-xs text-slate-500 line-clamp-2 mt-1.5 leading-relaxed">
            <%= recipe.description %>
          </p>
        <% end %>
      <% end %>
    </div>

    <!-- Footer Meta -->
    <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
      <div class="flex items-center gap-3">
        <span>⏱️ <%= recipe.total_time %>m</span>
        <span>🍽️ <%= recipe.servings %></span>
        <span>🥗 <%= recipe.recipe_ingredients.count %> items</span>
      </div>
      <%= link_to recipe_path(recipe), class: "font-semibold text-primary-600 group-hover:translate-x-0.5 transition-transform" do %>
        View →
      <% end %>
    </div>
  </div>
</div>
