<div id="<%= dom_id(recipe) %>" class="group relative flex flex-col justify-between rounded-3xl bg-white dark:bg-slate-800 border border-slate-200/80 dark:border-slate-700/80 hover:border-primary-300 dark:hover:border-primary-500 hover:shadow-md transition-all overflow-hidden">
  <!-- Recipe Image Banner -->
    <%= link_to recipe_path(recipe), class: "block w-full h-full cursor-pointer relative", aria: { label: "View #{recipe.title}" } do %>
      <img src="<%= recipe.display_image_url %>" alt="<%= recipe.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" onerror="this.style.display='none'; this.nextElementSibling.classList.remove('hidden');">
      <div class="hidden absolute inset-0 flex flex-col items-center justify-center bg-gradient-to-tr from-amber-500/20 via-primary-500/15 to-orange-500/20 dark:from-slate-800 dark:to-slate-700 p-4 text-center">
        <div class="w-10 h-10 rounded-2xl bg-white/80 dark:bg-slate-800/80 backdrop-blur-xs flex items-center justify-center text-primary-600 dark:text-primary-400 shadow-sm mb-1">
          <%= icon_tag("utensils", css_class: "w-5 h-5") %>
        </div>
        <span class="text-xs font-bold text-slate-800 dark:text-slate-200 line-clamp-1"><%= recipe.title %></span>
      </div>
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent pointer-events-none"></div>
    <% end %>

    <!-- Multi-select checkbox top left (Admins only) -->
    <% if current_family_member&.admin? %>
      <div class="absolute top-3 left-3 z-10" onclick="event.stopPropagation()">
        <label class="inline-flex items-center justify-center p-1.5 rounded-xl bg-white/90 dark:bg-slate-900/90 backdrop-blur-xs shadow-md border border-white/60 dark:border-slate-700 cursor-pointer hover:scale-110 transition-transform">
          <input type="checkbox"
                 value="<%= recipe.id %>"
                 data-meal-types="<%= recipe.meal_types_list.join(',') %>"
                 data-tags="<%= recipe.tag_list.join(',') %>"
                 data-bulk-select-target="checkbox"
                 data-action="change->bulk-select#toggle"
                 class="rounded text-primary-600 focus:ring-primary-500 w-4 h-4 cursor-pointer">
        </label>
      </div>
    <% end %>

    <!-- Tags & Meal Types overlay on image -->
    <%= link_to recipe_path(recipe), class: "absolute bottom-3 left-3 right-12 flex flex-wrap gap-1 cursor-pointer" do %>
      <% recipe.meal_types_list.each do |mt| %>
        <% icon = case mt; when "breakfast" then "☀️"; when "lunch" then "🥪"; else "🍽️"; end %>
        <span class="text-[10px] font-bold px-1.5 py-0.5 rounded-md bg-slate-900/80 backdrop-blur-xs text-white shadow-2xs">
          <%= icon %>
        </span>
      <% end %>
      <% recipe.tag_list.first(2).each do |tag| %>
        <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-white/90 dark:bg-slate-800/90 backdrop-blur-xs text-slate-800 dark:text-slate-200 shadow-2xs">
          <%= tag %>
        </span>
      <% end %>
      <% if recipe.yields_leftovers? %>
        <span class="text-[10px] font-bold px-1.5 py-0.5 rounded-md bg-purple-900/80 backdrop-blur-xs text-white shadow-2xs" title="Yields Leftovers">
          🍱
        </span>
      <% end %>
    <% end %>

    <!-- Craving Heart overlay on image top right -->
    <div class="absolute top-3 right-3 z-10" onclick="event.stopPropagation()">
      <%= render "recipe_requests/heart_button", recipe: recipe %>
    </div>
  </div>

  <!-- Card Body -->
  <div class="p-5 flex-1 flex flex-col justify-between">
    <div>
      <%= link_to recipe_path(recipe), class: "block group/title" do %>
        <h3 class="text-base font-bold text-slate-900 dark:text-white group-hover/title:text-primary-600 dark:group-hover/title:text-primary-400 transition-colors leading-snug">
          <%= recipe.title %>
        </h3>
        <% if recipe.description.present? %>
          <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-2 mt-1.5 leading-relaxed">
            <%= recipe.description %>
          </p>
        <% end %>
      <% end %>
    </div>

    <!-- Footer Meta -->
    <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-700/80 flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
      <div class="flex items-center gap-3">
        <span>⏱️ <%= recipe.total_time %>m</span>
        <span>🍽️ <%= recipe.servings %></span>
        <span>🥗 <%= recipe.recipe_ingredients.count %> items</span>
      </div>
      <%= link_to recipe_path(recipe), class: "font-semibold text-primary-600 dark:text-primary-400 group-hover:translate-x-0.5 transition-transform" do %>
        View →
      <% end %>
    </div>
  </div>
</div>
