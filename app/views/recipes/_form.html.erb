<%= form_with model: recipe, class: "space-y-8" do |f| %>
  <% if recipe.errors.any? %>
    <div class="p-4 rounded-2xl bg-rose-50 dark:bg-rose-950/60 border border-rose-200 dark:border-rose-800 text-rose-800 dark:text-rose-300 text-sm">
      <p class="font-bold mb-1"><%= pluralize(recipe.errors.count, "error") %> prohibited this recipe from being saved:</p>
      <ul class="list-disc list-inside text-xs">
        <% recipe.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Basic Info -->
  <div class="bg-white dark:bg-slate-900 p-6 sm:p-8 rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-xs space-y-5">
    <h2 class="text-lg font-bold text-slate-900 dark:text-white border-b border-slate-100 dark:border-slate-800 pb-3">Recipe Details</h2>

    <div>
      <%= f.label :title, "Recipe Title", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1" %>
      <%= f.text_field :title, placeholder: "e.g. Crispy Honey Garlic Chicken", required: true,
            class: "w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-base font-semibold focus:outline-none focus:ring-2 focus:ring-primary-500" %>
    </div>

    <div>
      <%= f.label :description, "Short Description", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1" %>
      <%= f.text_area :description, rows: 2, placeholder: "Why your family loves this dish...",
            class: "w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" %>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      <div>
        <%= f.label :prep_time, "Prep Time (mins)", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1" %>
        <%= f.number_field :prep_time, min: 0, class: "w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" %>
      </div>
      <div>
        <%= f.label :cook_time, "Cook Time (mins)", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1" %>
        <%= f.number_field :cook_time, min: 0, class: "w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" %>
      </div>
      <div>
        <%= f.label :total_time, "Total Time (mins)", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1" %>
        <%= f.number_field :total_time, min: 0, placeholder: "Auto or exact", class: "w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" %>
      </div>
      <div>
        <%= f.label :servings, "Servings", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1" %>
        <%= f.number_field :servings, min: 1, class: "w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" %>
      </div>
    </div>

    <div>
      <%= f.label :equipment, "Equipment & Materials Needed (optional)", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1" %>
      <%= f.text_field :equipment, placeholder: "e.g. 8x8-inch baking pan, Dutch oven, 6-qt slow cooker, cast iron skillet",
            class: "w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" %>
      <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-1">Baking dish sizes, special pans, or appliances required for this recipe.</p>
    </div>

    <div>
      <fieldset>
        <legend class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">Can be planned for (Meal Types):</legend>
        <div class="flex flex-wrap items-center gap-3">
          <% [["breakfast", "☀️ Breakfast"], ["lunch", "🥪 Lunch"], ["dinner", "🍽️ Dinner"]].each do |type, label| %>
            <label class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-700/80 cursor-pointer text-xs font-bold text-slate-800 dark:text-slate-200 transition-colors">
              <%= check_box_tag "recipe[meal_types][]", type, recipe.for_meal_type?(type), class: "rounded text-primary-600 focus:ring-primary-500 w-4 h-4 cursor-pointer" %>
              <span><%= label %></span>
            </label>
          <% end %>
        </div>
        <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-1.5">Determines which meal slots this recipe appears in when planning your schedule.</p>
      </fieldset>
    </div>

    <!-- Yields Leftovers Setting -->
    <div class="p-4 rounded-2xl bg-purple-50/70 dark:bg-purple-950/40 border border-purple-200/80 dark:border-purple-800 flex items-start gap-3.5">
      <div class="pt-0.5">
        <%= f.check_box :yields_leftovers, class: "rounded text-purple-600 focus:ring-purple-500 w-5 h-5 cursor-pointer" %>
      </div>
      <div>
        <label for="recipe_yields_leftovers" class="text-sm font-bold text-purple-900 dark:text-purple-300 cursor-pointer block">
          🍱 Yields Leftovers / Makes Extra Servings
        </label>
        <p class="text-xs text-purple-700/90 dark:text-purple-400 mt-0.5 leading-relaxed">
          When scheduled for any meal (Breakfast, Lunch, or Dinner), this recipe will automatically be highlighted as an available 1-tap leftover for upcoming meals on your weekly planner.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :image, "Upload Custom Image (optional)", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1" %>
        <%= f.file_field :image, accept: "image/*",
              class: "w-full px-3.5 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs text-slate-600 dark:text-slate-300 focus:outline-none focus:ring-2 focus:ring-primary-500 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-primary-50 dark:file:bg-primary-950/60 file:text-primary-700 dark:file:text-primary-300 hover:file:bg-primary-100 dark:hover:file:bg-primary-900/60 cursor-pointer" %>
        <% if recipe.image.attached? %>
          <p class="text-[11px] text-emerald-600 dark:text-emerald-400 mt-1">✓ Custom image currently uploaded</p>
        <% end %>
      </div>
      <div>
        <%= f.label :image_url, "Or Image URL (optional)", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1" %>
        <%= f.url_field :image_url, placeholder: "https://images.unsplash.com/... or blog photo URL",
              class: "w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" %>
      </div>
    </div>

    <div>
      <%= f.label :source_url, "Original Web Link (optional)", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1" %>
      <%= f.url_field :source_url, placeholder: "https://example.com/recipe",
            class: "w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" %>
    </div>

    <!-- Interactive Search & Creation Tag Picker -->
    <div data-controller="tag-picker" 
         data-tag-picker-available-tags-value="<%= (@available_tags || Recipe::POPULAR_TAGS).to_json %>"
         class="space-y-2 relative">
      <div class="flex items-center justify-between">
        <%= f.label :tags, "Recipe Tags", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider" %>
        <span class="text-xs text-slate-400 dark:text-slate-500">Search existing tags or type to create new</span>
      </div>

      <!-- Hidden input submitted with the form -->
      <%= f.hidden_field :tags, data: { "tag-picker-target": "hiddenInput" } %>

      <!-- Interactive Badges & Search Box Input Container -->
      <div class="min-h-[46px] p-2 rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 focus-within:ring-2 focus-within:ring-primary-500 focus-within:border-transparent transition-all flex flex-wrap items-center gap-1.5 shadow-2xs">
        
        <!-- Rendered Selected Tag Badges -->
        <div data-tag-picker-target="badgesContainer" class="flex flex-wrap items-center gap-1.5"></div>

        <!-- Inline Tag Search / Typing Input -->
        <div class="flex-1 min-w-[140px] relative">
          <label for="recipe_tag_search" class="sr-only">Search or add a recipe tag</label>
          <input type="text"
                 id="recipe_tag_search"
                 data-tag-picker-target="textInput"
                 data-action="input->tag-picker#onInput keydown->tag-picker#onKeydown focus->tag-picker#onFocus"
                 placeholder="Type a tag..."
                 class="w-full bg-transparent border-none p-1 text-sm text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none font-medium">
        </div>
      </div>

      <!-- Real-time Suggestions & Instant Create Dropdown Menu -->
      <div data-tag-picker-target="suggestionsMenu"
           class="hidden absolute left-0 top-full mt-1.5 z-30 w-72 max-w-full overflow-hidden rounded-2xl bg-white dark:bg-slate-900 shadow-2xl border border-slate-200/80 dark:border-slate-800 p-2 animate-in fade-in zoom-in-95 duration-100">
        
        <!-- Create New Tag Action (when typing un-matched tag) -->
        <div data-tag-picker-target="createOption" class="hidden mb-1 pb-1 border-b border-slate-100 dark:border-slate-800">
          <button type="button"
                  data-action="click->tag-picker#createCustomTag"
                  class="w-full text-left px-3 py-2 rounded-xl text-xs font-bold text-primary-600 dark:text-primary-400 bg-primary-50 dark:bg-primary-950/60 hover:bg-primary-100 dark:hover:bg-primary-900/60 flex items-center justify-between transition-colors cursor-pointer">
            <span class="flex items-center gap-1.5">
              <span>✨</span>
              <span>Create new tag: "<strong data-tag-picker-target="createOptionText" class="underline"></strong>"</span>
            </span>
            <span class="text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded bg-primary-200 dark:bg-primary-800 text-primary-800 dark:text-primary-200 font-extrabold">Press Enter</span>
          </button>
        </div>

        <!-- Matching Existing Tags List -->
        <div data-tag-picker-target="suggestionsList" class="max-h-52 overflow-y-auto overflow-x-hidden themed-scrollbar space-y-0.5 overscroll-contain"></div>
      </div>
    </div>
  </div>

  <!-- Ingredients Section with Dynamic Add/Remove and Smart Aisle Learning -->
  <div data-controller="recipe-ingredients-form"
       data-ingredient-catalogue
       data-ingredient-catalogue-ingredients="<%= (@available_ingredients || IngredientAisleMapping.available_ingredients_with_aisles(current_household)).to_json %>"
       data-ingredient-catalogue-units="<%= (@available_units || RecipeIngredient.available_units(current_household)).to_json %>" class="bg-white dark:bg-slate-900 p-6 sm:p-8 rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-xs space-y-4">
    <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-3">
      <div>
        <h2 class="text-lg font-bold text-slate-900 dark:text-white">Ingredients</h2>
        <p class="text-xs text-slate-400 dark:text-slate-500 mt-0.5">Quantity, unit, and auto-mapped grocery aisle for instant shopping list consolidation.</p>
      </div>
      <button type="button"
              data-action="click->recipe-ingredients-form#addRow"
              class="px-3.5 py-1.5 rounded-xl bg-primary-50 dark:bg-primary-950/60 hover:bg-primary-100 dark:hover:bg-primary-900/60 text-primary-700 dark:text-primary-300 font-bold text-xs border border-primary-200 dark:border-primary-800 transition-colors flex items-center gap-1.5 cursor-pointer shadow-2xs">
        <span>+ Add Ingredient</span>
      </button>
    </div>

    <!-- Datalist for common units -->
    <datalist id="common-ingredient-units">
      <% RecipeIngredient::COMMON_UNITS.reject(&:blank?).each do |u| %>
        <option value="<%= u %>"></option>
      <% end %>
    </datalist>

    <!-- Table Header for desktop -->
    <div class="hidden sm:flex items-center gap-2 px-3 text-[10.5px] font-black uppercase tracking-wider text-slate-400 dark:text-slate-500">
      <div class="w-24 shrink-0">Qty</div>
      <div class="w-32 shrink-0">Measurement</div>
      <div class="flex-1">Ingredient Name</div>
      <div class="w-44 shrink-0">Grocery Aisle</div>
      <div class="w-8 shrink-0"></div>
    </div>

    <!-- Ingredients List Container -->
    <div data-recipe-ingredients-form-target="container" class="space-y-2.5">
      <%= f.fields_for :recipe_ingredients do |ing_f| %>
        <%= render "recipes/recipe_ingredient_fields", f: ing_f %>
      <% end %>
    </div>

    <!-- Template for adding new ingredient rows -->
    <template data-recipe-ingredients-form-target="template">
      <%= f.fields_for :recipe_ingredients, RecipeIngredient.new, child_index: "NEW_RECORD" do |ing_f| %>
        <%= render "recipes/recipe_ingredient_fields", f: ing_f %>
      <% end %>
    </template>

    <div class="pt-2 flex items-center justify-between">
      <button type="button"
              data-action="click->recipe-ingredients-form#addRow"
              class="px-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 font-bold text-xs transition-colors flex items-center gap-1.5 cursor-pointer">
        <svg class="w-4 h-4 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        <span>Add another ingredient</span>
      </button>
      <span class="text-[11px] text-slate-400 dark:text-slate-500">Aisle mappings are saved and learned for future recipes.</span>
    </div>
  </div>

  <!-- Instructions Section -->
  <div class="bg-white dark:bg-slate-900 p-6 sm:p-8 rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-xs space-y-4">
    <h2 class="text-lg font-bold text-slate-900 dark:text-white border-b border-slate-100 dark:border-slate-800 pb-3">Cooking Instructions</h2>
    <div>
      <%= f.text_area :instructions, rows: 6, placeholder: "1. Heat oil in skillet...\n2. Add garlic and onions...\n3. Simmer for 15 minutes.",
            class: "w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" %>
    </div>
  </div>

  <!-- Submit Buttons -->
  <div class="flex items-center justify-end gap-3 pt-4">
    <%= link_to "Cancel", recipes_path, class: "px-5 py-3 rounded-xl text-sm font-semibold text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors" %>
    <%= f.submit "Save Recipe to Vault", class: "py-3 px-6 rounded-xl bg-primary-600 hover:bg-primary-500 text-white font-bold text-sm shadow-md shadow-primary-500/20 cursor-pointer transition-all hover:scale-105" %>
  </div>
<% end %>
