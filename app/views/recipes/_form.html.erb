<%= form_with model: recipe, class: "space-y-8" do |f| %>
  <% if recipe.errors.any? %>
    <div class="p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-sm">
      <p class="font-bold mb-1"><%= pluralize(recipe.errors.count, "error") %> prohibited this recipe from being saved:</p>
      <ul class="list-disc list-inside text-xs">
        <% recipe.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Basic Info -->
  <div class="bg-white p-6 sm:p-8 rounded-3xl border border-slate-200/80 shadow-xs space-y-5">
    <h2 class="text-lg font-bold text-slate-900 border-b border-slate-100 pb-3">Recipe Details</h2>

    <div>
      <%= f.label :title, "Recipe Title", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1" %>
      <%= f.text_field :title, placeholder: "e.g. Crispy Honey Garlic Chicken", required: true,
            class: "w-full px-4 py-3 rounded-xl border border-slate-200 text-base font-semibold focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500" %>
    </div>

    <div>
      <%= f.label :description, "Short Description", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1" %>
      <%= f.text_area :description, rows: 2, placeholder: "Why your family loves this dish...",
            class: "w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500" %>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      <div>
        <%= f.label :prep_time, "Prep Time (mins)", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1" %>
        <%= f.number_field :prep_time, min: 0, class: "w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" %>
      </div>
      <div>
        <%= f.label :cook_time, "Cook Time (mins)", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1" %>
        <%= f.number_field :cook_time, min: 0, class: "w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" %>
      </div>
      <div>
        <%= f.label :total_time, "Total Time (mins)", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1" %>
        <%= f.number_field :total_time, min: 0, placeholder: "Auto or exact", class: "w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" %>
      </div>
      <div>
        <%= f.label :servings, "Servings", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1" %>
        <%= f.number_field :servings, min: 1, class: "w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" %>
      </div>
    </div>

    <div>
      <%= f.label :equipment, "Equipment & Materials Needed (optional)", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1" %>
      <%= f.text_field :equipment, placeholder: "e.g. 8x8-inch baking pan, Dutch oven, 6-qt slow cooker, cast iron skillet",
            class: "w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500" %>
      <p class="text-[11px] text-slate-400 mt-1">Baking dish sizes, special pans, or appliances required for this recipe.</p>
    </div>

    <div>
      <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Can be planned for (Meal Types):</label>
      <div class="flex flex-wrap items-center gap-3">
        <% [["breakfast", "☀️ Breakfast"], ["lunch", "🥪 Lunch"], ["dinner", "🍽️ Dinner"]].each do |type, label| %>
          <label class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl border border-slate-200 bg-slate-50 hover:bg-slate-100 cursor-pointer text-xs font-bold text-slate-800 transition-colors">
            <%= check_box_tag "recipe[meal_types][]", type, recipe.for_meal_type?(type), class: "rounded text-primary-600 focus:ring-primary-500 w-4 h-4" %>
            <span><%= label %></span>
          </label>
        <% end %>
      </div>
      <p class="text-[11px] text-slate-400 mt-1.5">Determines which meal slots this recipe appears in when planning your schedule.</p>
    </div>

    <!-- Yields Leftovers Setting -->
    <div class="p-4 rounded-2xl bg-purple-50/70 border border-purple-200/80 flex items-start gap-3.5">
      <div class="pt-0.5">
        <%= f.check_box :yields_leftovers, class: "rounded text-purple-600 focus:ring-purple-500 w-5 h-5 cursor-pointer" %>
      </div>
      <div>
        <label for="recipe_yields_leftovers" class="text-sm font-bold text-purple-900 cursor-pointer block">
          🍱 Yields Leftovers / Makes Extra Servings
        </label>
        <p class="text-xs text-purple-700/90 mt-0.5 leading-relaxed">
          When scheduled for any meal (Breakfast, Lunch, or Dinner), this recipe will automatically be highlighted as an available 1-tap leftover for upcoming meals on your weekly planner.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :image, "Upload Custom Image (optional)", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1" %>
        <%= f.file_field :image, accept: "image/*",
              class: "w-full px-3.5 py-2 rounded-xl border border-slate-200 text-xs text-slate-600 focus:outline-none focus:ring-2 focus:ring-primary-500 bg-white file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-primary-50 file:text-primary-700 hover:file:bg-primary-100 cursor-pointer" %>
        <% if recipe.image.attached? %>
          <p class="text-[11px] text-emerald-600 mt-1">✓ Custom image currently uploaded</p>
        <% end %>
      </div>
      <div>
        <%= f.label :image_url, "Or Image URL (optional)", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1" %>
        <%= f.url_field :image_url, placeholder: "https://images.unsplash.com/... or blog photo URL",
              class: "w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" %>
      </div>
    </div>

    <div>
      <%= f.label :source_url, "Original Web Link (optional)", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1" %>
      <%= f.url_field :source_url, placeholder: "https://example.com/recipe",
            class: "w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" %>
    </div>

    <!-- Clickable Tag Picker -->
    <div data-controller="tag-picker" class="space-y-2">
      <div class="flex items-center justify-between">
        <%= f.label :tags, "Recipe Tags", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider" %>
        <span class="text-xs text-slate-400">Click pills below or type custom tags</span>
      </div>

      <div class="flex flex-wrap gap-1.5 pt-1">
        <% Recipe::POPULAR_TAGS.each do |tag| %>
          <button type="button" 
                  data-tag-picker-target="tag"
                  data-tag-value="<%= tag %>"
                  data-action="click->tag-picker#toggle"
                  class="text-xs font-semibold px-2.5 py-1 rounded-full border border-slate-200 bg-slate-100 text-slate-700 hover:border-primary-300 transition-colors cursor-pointer">
            + <%= tag %>
          </button>
        <% end %>
      </div>

      <%= f.text_field :tags, 
            data: { "tag-picker-target": "input", action: "input->tag-picker#inputChanged" },
            placeholder: "Quick (<30m), Mexican, Kid Friendly",
            class: "w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 mt-2" %>
    </div>
  </div>

  <!-- Ingredients Section -->
  <div class="bg-white p-6 sm:p-8 rounded-3xl border border-slate-200/80 shadow-xs space-y-4">
    <div class="flex items-center justify-between border-b border-slate-100 pb-3">
      <h2 class="text-lg font-bold text-slate-900">Ingredients</h2>
      <span class="text-xs text-slate-400">Include quantity and unit for shopping list consolidation</span>
    </div>

    <div class="space-y-3">
      <%= f.fields_for :recipe_ingredients do |ing_f| %>
        <div class="flex flex-col sm:flex-row items-center gap-2.5 p-3 rounded-2xl bg-slate-50 border border-slate-200/60">
          <div class="flex-1 w-full">
            <%= ing_f.text_field :raw_text, placeholder: "Full line (e.g. 2 lbs chicken breasts, diced)",
                  class: "w-full px-3 py-2 rounded-xl border border-slate-200 text-xs bg-white focus:outline-none focus:ring-2 focus:ring-primary-500" %>
          </div>
          <div class="w-full sm:w-44">
            <%= ing_f.text_field :name, placeholder: "Item name (e.g. Chicken)",
                  class: "w-full px-3 py-2 rounded-xl border border-slate-200 text-xs bg-white focus:outline-none focus:ring-2 focus:ring-primary-500" %>
          </div>
          <div class="w-full sm:w-40">
            <%= ing_f.select :aisle_category, RecipeIngredient::AISLE_CATEGORIES.map { |c| [c, c] }, {},
                  class: "w-full px-3 py-2 rounded-xl border border-slate-200 text-xs bg-white focus:outline-none focus:ring-2 focus:ring-primary-500" %>
          </div>
          <% if ing_f.object.persisted? %>
            <label class="flex items-center gap-1 text-xs text-rose-500">
              <%= ing_f.check_box :_destroy %>
              <span>Delete</span>
            </label>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Instructions Section -->
  <div class="bg-white p-6 sm:p-8 rounded-3xl border border-slate-200/80 shadow-xs space-y-4">
    <h2 class="text-lg font-bold text-slate-900 border-b border-slate-100 pb-3">Cooking Instructions</h2>
    <div>
      <%= f.text_area :instructions, rows: 6, placeholder: "1. Heat oil in skillet...\n2. Add garlic and onions...\n3. Simmer for 15 minutes.",
            class: "w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" %>
    </div>
  </div>

  <!-- Submit Buttons -->
  <div class="flex items-center justify-end gap-3 pt-4">
    <%= link_to "Cancel", recipes_path, class: "px-5 py-3 rounded-xl text-sm font-semibold text-slate-600 hover:text-slate-900" %>
    <%= f.submit "Save Recipe to Vault", class: "py-3 px-6 rounded-xl bg-primary-600 hover:bg-primary-500 text-white font-bold text-sm shadow-md shadow-primary-500/20 cursor-pointer transition-all hover:scale-105" %>
  </div>
<% end %>
