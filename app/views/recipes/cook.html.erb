<% content_for :title, "Cook: #{@recipe.title} | FamilyPlates" %>

<div class="flex min-h-dvh flex-col"
     data-controller="cook-mode"
     data-cook-mode-storage-key-value="familyplates_cook_<%= @recipe.id %>"
     data-action="touchstart->cook-mode#touchStart touchend->cook-mode#touchEnd">

  <!-- Header: way out, where you are, screen state, ingredients -->
  <header class="shrink-0 border-b border-white/10 bg-slate-950/95">
    <div class="flex items-center gap-3 px-4 py-3 sm:px-6">
      <%= link_to recipe_path(@recipe),
            class: "flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-white/5 text-xl text-slate-300 transition-colors hover:bg-white/10 hover:text-white" do %>
        <span aria-hidden="true">&times;</span>
        <span class="sr-only">Leave cook mode</span>
      <% end %>

      <div class="min-w-0 flex-1">
        <h1 class="truncate text-base font-bold text-white sm:text-lg"><%= @recipe.title %></h1>
        <p data-cook-mode-target="counter" class="text-[11px] font-bold uppercase tracking-[0.15em] text-slate-400">
          <%= @steps.any? ? "Step 1 of #{@steps.size}" : "No steps yet" %>
        </p>
      </div>

      <div data-controller="wake-lock" class="flex shrink-0 items-center gap-2 rounded-2xl bg-white/5 px-3 py-2">
        <span data-wake-lock-target="indicator" class="text-slate-500" aria-hidden="true">&#9679;</span>
        <span data-wake-lock-target="label" class="hidden text-[11px] font-bold uppercase tracking-wider text-slate-400 sm:inline">
          Screen may dim
        </span>
      </div>

      <% if @recipe.recipe_ingredients.any? %>
        <button type="button" data-action="cook-mode#toggleDrawer"
                class="flex h-12 shrink-0 items-center gap-2 rounded-2xl bg-white/5 px-4 font-bold text-slate-200 transition-colors hover:bg-white/10 hover:text-white">
          <%= icon_tag("shopping-cart", css_class: "w-5 h-5") %>
          <span class="hidden sm:inline">Ingredients</span>
          <span class="rounded-full bg-primary-600 px-2 py-0.5 text-xs font-black text-white"
                data-cook-mode-target="remaining"><%= @recipe.recipe_ingredients.size %></span>
        </button>
      <% end %>
    </div>

    <div class="h-1.5 w-full bg-white/10" role="progressbar" aria-label="Cooking progress"
         aria-valuemin="0" aria-valuemax="<%= @steps.size %>" aria-valuenow="<%= @steps.any? ? 1 : 0 %>">
      <div data-cook-mode-target="progressBar" class="h-full bg-primary-500 transition-[width] duration-300"></div>
    </div>
  </header>

  <!-- One step at a time, sized to be read from across the counter -->
  <main class="flex flex-1 flex-col justify-center px-5 py-10 sm:px-10">
    <% if @steps.empty? %>
      <div class="mx-auto w-full max-w-2xl text-center">
        <p class="text-2xl font-bold text-white sm:text-3xl">This recipe has no steps written down yet.</p>
        <p class="mt-3 text-base text-slate-400">Add instructions to it and Cook Mode will walk through them one at a time.</p>
        <%= link_to "Back to #{@recipe.title}", recipe_path(@recipe),
              class: "mt-8 inline-flex min-h-14 items-center rounded-2xl bg-primary-600 px-8 font-bold text-white transition-colors hover:bg-primary-500" %>
      </div>
    <% else %>
      <% @steps.each_with_index do |step, index| %>
        <section data-cook-mode-target="step" <%= "hidden" if index.positive? %> class="mx-auto w-full max-w-3xl">
          <% if step.section? %>
            <p class="mb-4 text-sm font-black uppercase tracking-[0.2em] text-primary-400"><%= step.section %></p>
          <% end %>

          <p class="text-2xl font-semibold leading-snug text-white sm:text-4xl lg:text-5xl lg:leading-tight">
            <%= step.text %>
          </p>

          <% if step.timers? %>
            <div class="mt-10 flex flex-wrap gap-4">
              <% step.timers.each do |timer| %>
                <div class="cook-timer" data-controller="step-timer" data-step-timer-seconds-value="<%= timer.seconds %>">
                  <button type="button" data-action="step-timer#toggle"
                          class="cook-timer-face min-h-24 rounded-3xl border-2 border-white/15 bg-white/5 px-7 py-4 text-left transition-colors hover:bg-white/10">
                    <span class="block text-[11px] font-bold uppercase tracking-widest text-slate-400"><%= timer.label %></span>
                    <span data-step-timer-target="display" class="block text-4xl font-black tabular-nums text-white"><%= timer.clock %></span>
                    <span data-step-timer-target="state" class="block text-[11px] font-semibold uppercase tracking-wider text-slate-400">Tap to start</span>
                  </button>
                  <button type="button" data-action="step-timer#reset" data-step-timer-target="reset" hidden
                          class="mt-2 w-full rounded-xl px-3 py-2 text-[11px] font-bold uppercase tracking-wider text-slate-400 transition-colors hover:bg-white/5 hover:text-white">
                    Reset
                  </button>
                </div>
              <% end %>
            </div>
          <% end %>
        </section>
      <% end %>
    <% end %>
  </main>

  <!-- Giant tap targets: reachable with a knuckle, a wet hand, or a keyboard -->
  <% if @steps.any? %>
    <footer class="shrink-0 border-t border-white/10 bg-slate-950/95 px-4 py-4 sm:px-6">
      <div class="mx-auto flex max-w-3xl items-stretch gap-3">
        <button type="button" data-cook-mode-target="previousButton" data-action="cook-mode#previous"
                class="flex min-h-24 flex-1 items-center justify-center rounded-3xl bg-white/5 text-lg font-bold text-slate-200 transition-colors hover:bg-white/10 disabled:cursor-not-allowed disabled:opacity-30">
          <span aria-hidden="true" class="mr-2">&larr;</span> Back
        </button>

        <button type="button" data-cook-mode-target="nextButton" data-action="cook-mode#next"
                class="flex min-h-24 flex-[2] items-center justify-center rounded-3xl bg-primary-600 text-xl font-black text-white transition-colors hover:bg-primary-500">
          Next Step <span aria-hidden="true" class="ml-2">&rarr;</span>
        </button>

        <%= link_to recipe_path(@recipe), hidden: true, data: { cook_mode_target: "finishLink" },
              class: "flex min-h-24 flex-[2] items-center justify-center rounded-3xl bg-emerald-600 text-xl font-black text-white transition-colors hover:bg-emerald-500" do %>
          Finish <span aria-hidden="true" class="ml-2">&#127881;</span>
        <% end %>
      </div>

      <p class="mt-3 text-center text-[11px] font-semibold uppercase tracking-wider text-slate-600">
        Swipe or use the arrow keys
      </p>
    </footer>
  <% end %>

  <!-- Ingredients drawer -->
  <% if @recipe.recipe_ingredients.any? %>
    <div data-cook-mode-target="drawer" hidden class="fixed inset-0 z-50">
      <div data-cook-mode-target="drawerBackdrop" data-action="click->cook-mode#closeDrawer"
           class="absolute inset-0 bg-slate-950/80 opacity-0 transition-opacity duration-200"></div>

      <aside data-cook-mode-target="drawerPanel" aria-label="Ingredients"
             class="absolute inset-y-0 right-0 flex w-full max-w-md translate-x-full flex-col bg-slate-900 shadow-2xl transition-transform duration-200">
        <div class="flex items-center justify-between border-b border-white/10 px-5 py-4">
          <div>
            <h2 class="text-lg font-black text-white">Ingredients</h2>
            <p class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Tap one as you add it</p>
          </div>
          <button type="button" data-action="cook-mode#closeDrawer"
                  class="flex h-12 w-12 items-center justify-center rounded-2xl bg-white/5 text-xl text-slate-300 transition-colors hover:bg-white/10 hover:text-white">
            <span aria-hidden="true">&times;</span>
            <span class="sr-only">Close ingredients</span>
          </button>
        </div>

        <ul class="themed-scrollbar flex-1 divide-y divide-white/5 overflow-y-auto">
          <% @recipe.recipe_ingredients.each do |ing| %>
            <li class="transition-opacity">
              <label class="flex cursor-pointer items-start gap-4 px-5 py-4">
                <input type="checkbox" id="cook_ingredient_<%= ing.id %>" value="<%= ing.id %>"
                       data-cook-mode-target="ingredient" data-action="cook-mode#toggleIngredient"
                       class="mt-1 h-7 w-7 shrink-0 rounded-lg border-white/20 bg-white/5 text-primary-500 focus:ring-primary-500">
                <span class="ingredient-label text-base leading-snug text-slate-200">
                  <% formatted_qty = [ ing.display_quantity, ing.unit ].reject(&:blank?).join(" ") %>
                  <% if formatted_qty.present? %>
                    <strong class="font-black text-white"><%= formatted_qty %></strong>
                  <% end %>
                  <%= ing.name.presence || ing.raw_text %>
                </span>
              </label>
            </li>
          <% end %>
        </ul>

        <div class="border-t border-white/10 p-4">
          <button type="button" data-action="cook-mode#resetIngredients"
                  class="min-h-14 w-full rounded-2xl bg-white/5 font-bold text-slate-300 transition-colors hover:bg-white/10 hover:text-white">
            Clear all ticks
          </button>
        </div>
      </aside>
    </div>
  <% end %>
</div>
