<div class="max-w-4xl mx-auto py-6">
  <!-- Back Link & Action Bar -->
  <div class="flex items-center justify-between mb-6">
    <%= link_to "← Back to Recipe Box", recipes_path, class: "text-sm font-semibold text-slate-600 hover:text-slate-900 transition-colors" %>
    <div class="flex items-center gap-2">
      <%= link_to "Edit Recipe", edit_recipe_path(@recipe), class: "text-xs font-semibold px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors" %>
      <%= button_to "Delete", recipe_path(@recipe), method: :delete, data: { turbo_confirm: "Are you sure you want to delete #{@recipe.title}?" },
            class: "text-xs font-semibold px-3.5 py-2 rounded-xl text-rose-600 hover:bg-rose-50 transition-colors cursor-pointer" %>
    </div>
  </div>

  <!-- Hero Card with Photo Banner -->
  <div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm mb-8 overflow-hidden">
    <% if @recipe.image_url.present? %>
      <div class="relative h-64 sm:h-80 w-full bg-slate-100 overflow-hidden">
        <img src="<%= @recipe.display_image_url %>" alt="<%= @recipe.title %>" class="w-full h-full object-cover">
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-950/20 to-transparent"></div>
        <div class="absolute bottom-6 left-6 right-6 text-white">
          <div class="flex flex-wrap gap-2 mb-2">
            <% @recipe.tag_list.each do |tag| %>
              <span class="text-xs font-bold px-3 py-1 rounded-full bg-white/90 backdrop-blur-xs text-slate-900 shadow-xs">
                <%= tag %>
              </span>
            <% end %>
          </div>
          <h1 class="text-3xl sm:text-4xl font-black text-white tracking-tight leading-tight drop-shadow-sm">
            <%= @recipe.title %>
          </h1>
        </div>
      </div>
    <% end %>

    <div class="p-6 sm:p-8">
      <div class="flex flex-col md:flex-row md:items-start justify-between gap-6">
        <div class="flex-1">
          <% unless @recipe.image_url.present? %>
            <div class="flex flex-wrap gap-2 mb-3">
              <% @recipe.tag_list.each do |tag| %>
                <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-primary-50 text-primary-700 border border-primary-200/60">
                  <%= tag %>
                </span>
              <% end %>
            </div>

            <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
              <%= @recipe.title %>
            </h1>
          <% end %>

          <% if @recipe.description.present? %>
            <p class="text-slate-600 text-base leading-relaxed">
              <%= @recipe.description %>
            </p>
          <% end %>

          <% if @recipe.source_url.present? %>
            <div class="mt-3">
              <%= link_to @recipe.source_url, target: "_blank", rel: "noopener", class: "inline-flex items-center gap-1.5 text-xs text-primary-600 hover:underline font-medium" do %>
                <%= icon_tag("link", css_class: "w-3.5 h-3.5") %>
                <span>Original Recipe Source</span>
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- Craving / Vote Widget -->
        <%= render "recipe_requests/show_widget", recipe: @recipe %>
      </div>

      <!-- Quick Stats Grid -->
      <div class="mt-8 pt-6 border-t border-slate-100 grid grid-cols-2 <%= @recipe.additional_time > 0 ? 'sm:grid-cols-5' : 'sm:grid-cols-4' %> gap-3 text-center">
        <div class="p-3.5 rounded-2xl bg-amber-50/70 border border-amber-200/60">
          <span class="block text-[11px] font-bold uppercase tracking-wider text-amber-700">Total Time</span>
          <span class="text-base sm:text-lg font-black text-slate-900">
            <% total_m = @recipe.total_time %>
            <% if total_m >= 60 %>
              <%= "#{total_m / 60} hr #{total_m % 60}m" %>
            <% else %>
              <%= "#{total_m} mins" %>
            <% end %>
          </span>
        </div>
        <div class="p-3.5 rounded-2xl bg-primary-50/50 border border-primary-100/80">
          <span class="block text-[11px] font-bold uppercase tracking-wider text-slate-500">Prep Time</span>
          <span class="text-base sm:text-lg font-bold text-slate-900"><%= @recipe.prep_time || 0 %> mins</span>
        </div>
        <div class="p-3.5 rounded-2xl bg-primary-50/50 border border-primary-100/80">
          <span class="block text-[11px] font-bold uppercase tracking-wider text-slate-500">Cook Time</span>
          <span class="text-base sm:text-lg font-bold text-slate-900"><%= @recipe.cook_time || 0 %> mins</span>
        </div>
        <% if @recipe.additional_time > 0 %>
          <div class="p-3.5 rounded-2xl bg-teal-50/60 border border-teal-200/60">
            <span class="block text-[11px] font-bold uppercase tracking-wider text-teal-700">Rest / Stand</span>
            <span class="text-base sm:text-lg font-bold text-slate-900"><%= @recipe.additional_time %> mins</span>
          </div>
        <% end %>
        <div class="p-3.5 rounded-2xl bg-primary-50/50 border border-primary-100/80">
          <span class="block text-[11px] font-bold uppercase tracking-wider text-slate-500">Servings</span>
          <span class="text-base sm:text-lg font-bold text-slate-900"><%= @recipe.servings || 4 %></span>
        </div>
      </div>

      <!-- Equipment & Materials Callout -->
      <% if @recipe.equipment.present? %>
        <div class="mt-4 p-4 rounded-2xl bg-slate-50 border border-slate-200/80 flex items-center gap-3">
          <span class="text-xl">🍳</span>
          <div class="text-xs">
            <span class="font-extrabold text-slate-900">Materials / Equipment Needed:</span>
            <span class="text-slate-700 font-semibold ml-1"><%= @recipe.equipment %></span>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Quick Schedule & Plan Card -->
  <div class="bg-white rounded-3xl border border-slate-200/80 p-6 shadow-sm mb-8">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-4 mb-4 border-b border-slate-100">
      <div>
        <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
          <%= icon_tag("calendar", css_class: "w-5 h-5 text-primary-500") %>
          <span>Schedule This Dish on Your Meal Plan</span>
        </h3>
        <p class="text-xs text-slate-500">Pick a day and meal type to put this dish on your household calendar.</p>
      </div>
      <div class="flex items-center gap-1.5">
        <% @recipe.meal_types_list.each do |mt| %>
          <% icon = case mt; when "breakfast" then "☀️"; when "lunch" then "🥪"; else "🍽️"; end %>
          <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700 capitalize">
            <%= icon %> <%= mt %>
          </span>
        <% end %>
      </div>
    </div>

    <%= form_with url: meal_plan_slots_path, method: :post, class: "grid grid-cols-1 sm:grid-cols-2 md:grid-cols-5 gap-3 items-end" do |f| %>
      <%= hidden_field_tag :return_to, "recipe" %>
      <%= f.hidden_field "meal_plan_slot[recipe_id]", value: @recipe.id %>

      <div>
        <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Pick Date</label>
        <%= f.date_field "meal_plan_slot[date]", value: Date.current, min: Date.current - 1.month,
              class: "w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs font-semibold text-slate-800 focus:ring-2 focus:ring-primary-500 focus:outline-none bg-white" %>
      </div>

      <div>
        <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Meal Type</label>
        <%= f.select "meal_plan_slot[meal_type]", 
              @recipe.meal_types_list.map { |mt| [mt.capitalize, mt] },
              { selected: @recipe.meal_types_list.first },
              class: "w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs font-semibold text-slate-800 focus:ring-2 focus:ring-primary-500 focus:outline-none bg-white" %>
      </div>

      <div>
        <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Cook / Chef</label>
        <%= f.collection_select "meal_plan_slot[family_member_id]", current_household.family_members.order(:name), :id, :name,
              { prompt: "-- Anyone --", selected: current_family_member&.id },
              class: "w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs font-semibold text-slate-800 focus:ring-2 focus:ring-primary-500 focus:outline-none bg-white" %>
      </div>

      <div>
        <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Note (optional)</label>
        <%= f.text_field "meal_plan_slot[notes]", placeholder: "e.g. 6:30 PM",
              class: "w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs font-semibold text-slate-800 focus:ring-2 focus:ring-primary-500 focus:outline-none bg-white" %>
      </div>

      <div>
        <%= f.submit "Schedule Meal 📅", class: "w-full py-2.5 rounded-xl bg-primary-600 hover:bg-primary-500 text-white font-bold text-xs shadow-sm cursor-pointer transition-all" %>
      </div>
    <% end %>
  </div>

  <!-- Content Split: Ingredients & Instructions -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    <!-- Ingredients Column (1 col) -->
    <div class="bg-white p-6 rounded-3xl border border-slate-200/80 shadow-xs h-fit">
      <h2 class="text-lg font-bold text-slate-900 mb-4 flex items-center gap-2">
        <%= icon_tag("shopping-cart", css_class: "w-5 h-5 text-primary-500") %>
        <span>Ingredients (<%= @recipe.recipe_ingredients.count %>)</span>
      </h2>

      <ul class="space-y-2.5">
        <% @recipe.recipe_ingredients.each do |ing| %>
          <li class="flex items-start gap-2.5 text-sm text-slate-700">
            <span class="text-base"><%= PantryItem.emoji_for(ing.name, ing.aisle_category) %></span>
            <div>
              <span class="font-medium"><%= ing.raw_text.presence || "#{ing.quantity} #{ing.unit} #{ing.name}" %></span>
              <span class="block text-[10px] text-slate-400"><%= ing.aisle_category %></span>
            </div>
          </li>
        <% end %>
      </ul>
    </div>

    <!-- Instructions Column (2 cols) -->
    <div class="md:col-span-2 bg-white p-6 sm:p-8 rounded-3xl border border-slate-200/80 shadow-xs">
      <h2 class="text-lg font-bold text-slate-900 mb-4 flex items-center gap-2">
        <%= icon_tag("chef-hat", css_class: "w-5 h-5 text-primary-500") %>
        <span>Instructions</span>
      </h2>

      <div class="prose prose-slate max-w-none text-sm leading-relaxed whitespace-pre-line text-slate-700">
        <%= @recipe.instructions.presence || "No step-by-step instructions entered yet." %>
      </div>
    </div>
  </div>
</div>
