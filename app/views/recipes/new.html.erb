<div class="max-w-4xl mx-auto py-6">
  <div class="mb-8">
    <%= link_to "← Back to Recipes", recipes_path, class: "text-xs font-semibold text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 transition-colors" %>
    <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-2">Add New Recipe</h1>
    <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Enter your custom or family heirloom recipe.</p>
  </div>

  <%= render "recipes/form", recipe: @recipe %>
</div>
