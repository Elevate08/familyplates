<% current_view = params[:view] == "list" ? "list" : "grid" %>

<div class="max-w-6xl mx-auto py-6" data-controller="bulk-select">
  <!-- Header & Actions -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight flex items-center gap-3">
        <span>Family Recipe Vault</span>
        <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-primary-100 dark:bg-primary-950/80 text-primary-800 dark:text-primary-300">
          <%= @recipes.count %> <%= "recipe".pluralize(@recipes.count) %>
        </span>
      </h1>
      <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
        Your household's curated favorites. Family members can tap the heart on dishes they're craving for next week!
      </p>
    </div>

    <div class="flex items-center gap-3">
      <%= link_to new_recipe_import_path, class: "inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-slate-300 dark:hover:border-slate-600 text-slate-700 dark:text-slate-300 text-sm font-semibold shadow-2xs hover:bg-slate-50 dark:hover:bg-slate-700/60 transition-colors" do %>
        <%= icon_tag("link", css_class: "w-4 h-4 text-primary-500") %>
        <span>Import from Web</span>
      <% end %>

      <%= link_to new_recipe_path, class: "inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-primary-600 hover:bg-primary-500 text-white text-sm font-bold shadow-sm shadow-primary-500/20 transition-all hover:scale-105" do %>
        <%= icon_tag("plus", css_class: "w-4 h-4") %>
        <span>Add Recipe</span>
      <% end %>
    </div>
  </div>

  <!-- Search & Primary Filters Bar -->
  <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-3 bg-white dark:bg-slate-900 p-3 rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-xs">
    <!-- Filter Tabs -->
    <div class="flex items-center gap-1.5 w-full sm:w-auto overflow-x-auto pb-1 sm:pb-0">
      <%= link_to "All Recipes", recipes_path(view: current_view), 
            class: "px-3 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition-colors #{params[:filter].blank? && params[:query].blank? ? 'bg-primary-500 text-white' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800'}" %>
      <%= link_to "☀️ Breakfast", recipes_path(filter: "breakfast", view: current_view), 
            class: "px-3 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition-colors #{params[:filter] == 'breakfast' ? 'bg-amber-500 text-white' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800'}" %>
      <%= link_to "🥪 Lunch", recipes_path(filter: "lunch", view: current_view), 
            class: "px-3 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition-colors #{params[:filter] == 'lunch' ? 'bg-teal-600 text-white' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800'}" %>
      <%= link_to "🍽️ Dinner", recipes_path(filter: "dinner", view: current_view), 
            class: "px-3 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition-colors #{params[:filter] == 'dinner' ? 'bg-primary-600 text-white' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800'}" %>
      <%= link_to "❤️ Cravings", recipes_path(filter: "requested", view: current_view), 
            class: "px-3 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition-colors #{params[:filter] == 'requested' ? 'bg-rose-500 text-white' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800'}" %>
      <%= link_to "⚡ Quick (<30m)", recipes_path(filter: "quick", view: current_view), 
            class: "px-3 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition-colors #{params[:filter] == 'quick' ? 'bg-emerald-600 text-white' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800'}" %>
    </div>

    <!-- Search Bar & View Mode Toggle -->
    <div class="flex items-center gap-2.5 w-full sm:w-auto">
      <%= form_with url: recipes_path, method: :get, class: "w-full sm:w-64" do %>
        <%= hidden_field_tag :filter, params[:filter] if params[:filter].present? %>
        <%= hidden_field_tag :view, current_view %>
        <div class="relative">
          <%= text_field_tag :query, params[:query], placeholder: "Search recipes or tags...", 
                class: "w-full pl-3 pr-8 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs focus:outline-none focus:ring-2 focus:ring-primary-500 text-slate-800 dark:text-slate-100" %>
          <% if params[:query].present? %>
            <%= link_to "&times;".html_safe, recipes_path(filter: params[:filter], view: current_view), class: "absolute right-2.5 top-1 text-sm text-slate-400 dark:text-slate-500 hover:text-slate-600 dark:hover:text-slate-300" %>
          <% end %>
        </div>
      <% end %>

      <!-- Gallery vs List Toggle -->
      <div class="flex items-center bg-slate-100 dark:bg-slate-800 p-1 rounded-xl border border-slate-200 dark:border-slate-700 shrink-0">
        <%= link_to recipes_path(filter: params[:filter], query: params[:query], view: "grid"),
              title: "Gallery Grid View",
              class: "p-1.5 rounded-lg text-xs font-bold transition-all flex items-center gap-1 #{current_view == 'grid' ? 'bg-white dark:bg-slate-700 shadow-2xs text-slate-900 dark:text-white' : 'text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-white'}" do %>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
          </svg>
          <span class="hidden md:inline text-[11px]">Gallery</span>
        <% end %>

        <%= link_to recipes_path(filter: params[:filter], query: params[:query], view: "list"),
              title: "List Table View",
              class: "p-1.5 rounded-lg text-xs font-bold transition-all flex items-center gap-1 #{current_view == 'list' ? 'bg-white dark:bg-slate-700 shadow-2xs text-slate-900 dark:text-white' : 'text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-white'}" do %>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <span class="hidden md:inline text-[11px]">List</span>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Tag Filter Bar & Select All Bar -->
  <div class="flex items-center justify-between gap-4 mb-5 flex-wrap">
    <div class="flex items-center gap-1.5 overflow-x-auto pb-1 text-xs text-slate-500 dark:text-slate-400">
      <span class="font-bold text-slate-400 dark:text-slate-500 uppercase text-[10px] tracking-wider shrink-0">Tags:</span>
      <% Recipe::POPULAR_TAGS.first(8).each do |tag| %>
        <% is_selected = (params[:query] == tag) %>
        <%= link_to tag, recipes_path(query: is_selected ? nil : tag, filter: params[:filter], view: current_view), 
              class: "px-2.5 py-1 rounded-full text-xs font-medium shrink-0 transition-colors #{is_selected ? 'bg-primary-600 text-white font-bold' : 'bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:border-primary-300 dark:hover:border-primary-500'}" %>
      <% end %>
    </div>

    <!-- Select All Checkbox Control (Admins only) -->
    <% if current_family_member&.admin? && @recipes.any? %>
      <label class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-bold text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700/60 cursor-pointer shadow-2xs select-none">
        <input type="checkbox"
               data-bulk-select-target="selectAllCheckbox"
               data-action="change->bulk-select#toggleAll"
               class="rounded text-primary-600 focus:ring-primary-500 w-4 h-4 cursor-pointer">
        <span>Select All (<%= @recipes.count %>)</span>
      </label>
    <% end %>
  </div>

  <!-- Floating Sticky Bulk Actions Toolbar (Admins only) -->
  <% if current_family_member&.admin? %>
    <div data-bulk-select-target="toolbar"
         class="hidden fixed bottom-6 left-1/2 -translate-x-1/2 z-40 bg-slate-900 dark:bg-slate-800 text-white px-5 py-3.5 rounded-3xl shadow-2xl border border-slate-700 dark:border-slate-600 flex items-center gap-3 animate-in fade-in slide-in-from-bottom-4 duration-200 max-w-2xl w-[92%] sm:w-auto justify-between sm:justify-start">
      
      <div class="flex items-center gap-2 pr-2 border-r border-slate-700 dark:border-slate-600">
        <span class="w-2.5 h-2.5 rounded-full bg-primary-400 animate-pulse"></span>
        <span data-bulk-select-target="count" class="text-xs font-extrabold whitespace-nowrap text-white">
          0 selected
        </span>
      </div>

      <div class="flex items-center gap-2 flex-wrap">
        <!-- Edit Meal Types Button -->
        <button type="button"
                data-action="click->bulk-select#openMealTypesModal"
                class="px-3.5 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-bold transition-colors cursor-pointer flex items-center gap-1.5">
          <span>☀️/🥪/🍽️</span>
          <span>Meal Types</span>
        </button>

        <!-- Edit Tags Button -->
        <button type="button"
                data-action="click->bulk-select#openTagsModal"
                class="px-3.5 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-bold transition-colors cursor-pointer flex items-center gap-1.5">
          <span>🏷️</span>
          <span>Tags</span>
        </button>

        <!-- Bulk Delete Button (Uses theme styling) -->
        <button type="button"
                data-action="click->bulk-select#confirmBulkDelete"
                class="px-3.5 py-1.5 rounded-xl bg-primary-600 hover:bg-primary-500 text-white text-xs font-bold transition-all shadow-sm cursor-pointer flex items-center gap-1.5">
          <span>🗑️</span>
          <span>Delete</span>
        </button>

        <!-- Deselect All Button -->
        <button type="button"
                data-action="click->bulk-select#clearAll"
                class="p-1.5 rounded-lg text-slate-400 hover:text-white transition-colors cursor-pointer text-xs ml-1"
                title="Deselect All">
          ✕
        </button>
      </div>
    </div>
  <% end %>

  <!-- Recipes Content: Grid View or List View -->
  <% if @recipes.any? %>
    <% if current_view == "list" %>
      <!-- List View Rows -->
      <div class="space-y-3">
        <% @recipes.each do |recipe| %>
          <%= render "recipes/recipe_row", recipe: recipe %>
        <% end %>
      </div>
    <% else %>
      <!-- Gallery Grid View -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        <% @recipes.each do |recipe| %>
          <%= render "recipes/recipe_card", recipe: recipe %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="text-center py-16 bg-white dark:bg-slate-900 rounded-3xl border border-dashed border-slate-300 dark:border-slate-800 p-8">
      <div class="w-12 h-12 rounded-2xl bg-primary-50 dark:bg-primary-950/60 text-primary-500 dark:text-primary-400 flex items-center justify-center mx-auto mb-3">
        <%= icon_tag("book-open", css_class: "w-6 h-6") %>
      </div>
      <h3 class="font-bold text-slate-800 dark:text-slate-200 text-lg">No recipes found</h3>
      <p class="text-slate-500 dark:text-slate-400 text-xs mt-1">Try adjusting your filters or import a new recipe.</p>
      <div class="mt-4 flex items-center justify-center gap-3">
        <%= link_to "Import from URL", new_recipe_import_path, class: "text-xs font-bold text-primary-600 dark:text-primary-400 hover:underline" %>
        <span class="text-slate-300 dark:text-slate-600">•</span>
        <%= link_to "Add Manually", new_recipe_path, class: "text-xs font-bold text-primary-600 dark:text-primary-400 hover:underline" %>
      </div>
    </div>
  <% end %>

  <% if current_family_member&.admin? %>
    <!-- ============================================== -->
    <!-- MODAL: Bulk Edit Meal Types                     -->
    <!-- ============================================== -->
    <%= render "shared/modal",
               data: { "bulk-select-target": "mealTypesModal" },
               backdrop_action: "bulk-select#closeOnBackdrop",
               title: "Bulk Update Meal Types",
               subtitle: "Set meal periods for all selected recipes. Shared meal types are prepopulated.",
               icon: "☀️",
               close_action: "bulk-select#closeMealTypesModal" do %>
      
      <%= form_with url: bulk_update_recipes_path, method: :post, data: { "bulk-select-target": "mealTypesForm", action: "submit->bulk-select#beforeFormSubmit" }, class: "space-y-4" do |f| %>
        <%= hidden_field_tag :filter, params[:filter] %>
        <%= hidden_field_tag :query, params[:query] %>
        <%= hidden_field_tag :view, current_view %>
        <%= hidden_field_tag :update_meal_types, "1" %>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">Assigned Meal Periods:</label>
          <div class="space-y-2">
            <% [["breakfast", "☀️ Breakfast"], ["lunch", "🥪 Lunch"], ["dinner", "🍽️ Dinner"]].each do |type, label| %>
              <label class="flex items-center gap-3 p-3 rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 hover:bg-slate-100/80 dark:hover:bg-slate-700 cursor-pointer text-xs font-bold text-slate-800 dark:text-slate-200 transition-colors">
                <%= check_box_tag "meal_types[]", type, false, class: "rounded text-primary-600 focus:ring-primary-500 w-4 h-4 cursor-pointer" %>
                <span class="text-sm"><%= label %></span>
              </label>
            <% end %>
          </div>
          <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-2">Checked meal periods will be applied to all selected recipes.</p>
        </div>

        <div class="flex items-center justify-end gap-2.5 pt-3 border-t border-slate-100 dark:border-slate-700">
          <button type="button" data-action="click->bulk-select#closeMealTypesModal" class="px-4 py-2 rounded-xl border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 font-bold text-xs hover:bg-slate-50 dark:hover:bg-slate-800 cursor-pointer">Cancel</button>
          <%= f.submit "Save Meal Types", class: "px-5 py-2 rounded-xl bg-primary-600 hover:bg-primary-500 text-white font-bold text-xs cursor-pointer shadow-md shadow-primary-500/20" %>
        </div>
      <% end %>
    <% end %>

    <!-- ============================================== -->
    <!-- MODAL: Bulk Edit Tags                           -->
    <!-- ============================================== -->
    <%= render "shared/modal",
               data: { "bulk-select-target": "tagsModal" },
               backdrop_action: "bulk-select#closeOnBackdrop",
               title: "Bulk Update Tags",
               subtitle: "Set tags for all selected recipes. Shared tags are prepopulated.",
               icon: "🏷️",
               close_action: "bulk-select#closeTagsModal" do %>

      <%= form_with url: bulk_update_recipes_path, method: :post, data: { "bulk-select-target": "tagsForm", action: "submit->bulk-select#beforeFormSubmit" }, class: "space-y-4" do |f| %>
        <%= hidden_field_tag :filter, params[:filter] %>
        <%= hidden_field_tag :query, params[:query] %>
        <%= hidden_field_tag :view, current_view %>
        <%= hidden_field_tag :update_tags, "1" %>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">Tags (comma-separated):</label>
          <%= text_field_tag :tags, "", placeholder: "e.g. Kid Friendly, Quick (<30m), Italian",
                data: { "bulk-select-target": "tagsInput" },
                class: "w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 text-xs focus:ring-2 focus:ring-primary-500 focus:outline-none" %>
          
          <div class="mt-3">
            <span class="block text-[10.5px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-1.5">Popular Tags (click to toggle):</span>
            <div class="flex flex-wrap gap-1.5">
              <% Recipe::POPULAR_TAGS.first(8).each do |popular_tag| %>
                <button type="button"
                        data-action="click->bulk-select#addTag"
                        data-tag="<%= popular_tag %>"
                        class="text-[10px] font-semibold px-2.5 py-1 rounded-full bg-slate-100 dark:bg-slate-800 hover:bg-primary-50 dark:hover:bg-primary-950/60 text-slate-600 dark:text-slate-300 hover:text-primary-700 dark:hover:text-primary-400 border border-slate-200 dark:border-slate-700 transition-colors cursor-pointer">
                  + <%= popular_tag %>
                </button>
              <% end %>
            </div>
          </div>
        </div>

        <div class="flex items-center justify-end gap-2.5 pt-3 border-t border-slate-100 dark:border-slate-700">
          <button type="button" data-action="click->bulk-select#closeTagsModal" class="px-4 py-2 rounded-xl border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 font-bold text-xs hover:bg-slate-50 dark:hover:bg-slate-800 cursor-pointer">Cancel</button>
          <%= f.submit "Save Tags", class: "px-5 py-2 rounded-xl bg-primary-600 hover:bg-primary-500 text-white font-bold text-xs cursor-pointer shadow-md shadow-primary-500/20" %>
        </div>
      <% end %>
    <% end %>

    <!-- ============================================== -->
    <!-- HIDDEN FORM: Bulk Delete Form                  -->
    <!-- ============================================== -->
    <%= form_with url: bulk_destroy_recipes_path, method: :post, data: { "bulk-select-target": "deleteForm" }, class: "hidden" do %>
      <%= hidden_field_tag :filter, params[:filter] %>
      <%= hidden_field_tag :query, params[:query] %>
      <%= hidden_field_tag :view, current_view %>
    <% end %>
  <% end %>

</div>
