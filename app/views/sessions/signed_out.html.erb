<div class="min-h-[75vh] flex flex-col items-center justify-center py-6 sm:py-12 px-4">
  <div class="max-w-md w-full bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-6 sm:p-8 shadow-xl text-center">
    <% is_kiosk = (@kind == "kiosk") %>

    <!-- Header Icon -->
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl <%= is_kiosk ? 'bg-amber-100 dark:bg-amber-950 text-amber-600 dark:text-amber-400' : 'bg-primary-100 dark:bg-primary-950 text-primary-600 dark:text-primary-400' %> mb-4 shadow-sm">
      <%= icon_tag(is_kiosk ? "tv" : "lock", css_class: "w-8 h-8") %>
    </div>

    <h1 class="text-2xl font-extrabold text-slate-900 dark:text-white tracking-tight">
      <%= is_kiosk ? "Kitchen Display Signed Out" : "Device Signed Out" %>
    </h1>

    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-2 mb-6 leading-relaxed">
      <%= is_kiosk ? "This kitchen display is no longer connected to your household. Tap below to sign in and display a new pairing code." : "Your session has ended or device access was revoked. Sign in to reconnect to your household." %>
    </p>

    <!-- Primary Action Buttons -->
    <div class="space-y-3">
      <% if is_kiosk %>
        <%= link_to new_pair_path(kind: "kiosk"),
              class: "w-full py-3.5 px-6 rounded-2xl bg-primary-600 hover:bg-primary-500 text-white font-bold text-sm shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-2.5 cursor-pointer" do %>
          <%= icon_tag("tv", css_class: "w-4 h-4") %>
          <span>Sign In Again</span>
        <% end %>
        <p class="text-[11px] text-slate-400 dark:text-slate-500">
          Displays a new QR code to pair this screen with your phone
        </p>
      <% else %>
        <%= link_to new_session_path,
              class: "w-full py-3.5 px-6 rounded-2xl bg-primary-600 hover:bg-primary-500 text-white font-bold text-sm shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-2.5 cursor-pointer" do %>
          <span>Sign In Again</span>
        <% end %>

        <%= link_to new_pair_path(kind: "browser"),
              class: "w-full py-3 px-4 rounded-xl border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 font-bold text-xs transition-all flex items-center justify-center gap-2" do %>
          <span>📱</span>
          <span>Sign in with Pair Code</span>
        <% end %>
      <% end %>
    </div>

    <!-- Secondary Links -->
    <div class="mt-8 pt-6 border-t border-slate-100 dark:border-slate-800 space-y-2">
      <%= link_to "← Return to Profile Selection", select_profile_path,
            class: "text-xs font-medium text-slate-400 dark:text-slate-500 hover:text-slate-700 dark:hover:text-slate-300 transition-colors block" %>
    </div>
  </div>
</div>
