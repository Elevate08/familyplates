<div class="min-h-[75vh] flex flex-col items-center justify-center py-6 sm:py-12 px-4">
  <div class="max-w-md w-full bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-6 sm:p-8 shadow-xl">
    <div class="text-center mb-6">
      <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-primary-100 dark:bg-primary-950/80 text-primary-600 dark:text-primary-400 mb-3 shadow-sm">
        <%= icon_tag("lock", css_class: "w-7 h-7") %>
      </div>
      <h1 class="text-2xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        <%= FamilyPlates.config.hosted? ? "Sign in to FamilyPlates" : "Appliance Sign In" %>
      </h1>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
        <%= FamilyPlates.config.hosted? ? "Enter your email to receive a single-use sign-in code" : "Enter your email and password to access your household" %>
      </p>
    </div>

    <% if flash[:alert].present? %>
      <div class="mb-5 p-3 rounded-xl bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-900/60 text-red-600 dark:text-red-400 text-xs font-semibold text-center">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= form_with url: session_path, method: :post, local: true, class: "space-y-4" do |f| %>
      <div>
        <%= f.label :email, "Email Address", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5" %>
        <%= f.email_field :email, value: params[:email], required: true, autofocus: true, autocomplete: "email",
              placeholder: "you@example.com",
              class: "w-full px-3.5 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 transition-all" %>
      </div>

      <% unless FamilyPlates.config.hosted? %>
        <div>
          <%= f.label :password, "Password", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5" %>
          <%= f.password_field :password, required: true, autocomplete: "current-password",
                placeholder: "••••••••",
                class: "w-full px-3.5 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 transition-all" %>
        </div>
      <% end %>

      <div class="pt-2">
        <%= f.submit FamilyPlates.config.hosted? ? "Send Sign-in Code" : "Sign In",
              class: "w-full py-3 rounded-xl bg-primary-600 hover:bg-primary-500 text-white font-bold text-sm shadow-md transition-all cursor-pointer" %>
      </div>
    <% end %>

    <div class="mt-6 text-center">
      <%= link_to "← Back to Profile Selection", select_profile_path, class: "text-xs font-medium text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors" %>
    </div>
  </div>
</div>
