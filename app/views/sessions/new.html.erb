<div class="max-w-md mx-auto py-8">
  <div class="text-center mb-8">
    <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-gradient-to-tr from-amber-500 to-primary-500 text-white shadow-lg shadow-primary-500/30 mb-4">
      <%= icon_tag("chef-hat", css_class: "w-8 h-8") %>
    </div>
    <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Welcome Back</h1>
    <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">Sign in to your household kitchen.</p>
  </div>

  <div class="bg-white dark:bg-slate-900 p-8 rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-sm">
    <%= form_with url: session_path, class: "space-y-5" do |form| %>
      <div>
        <%= form.label :email_address, "Email Address", class: "block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-1" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "you@example.com", value: params[:email_address],
              class: "w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-slate-900 dark:text-white transition-colors" %>
      </div>

      <div>
        <div class="flex items-center justify-between mb-1">
          <%= form.label :password, "Password", class: "block text-sm font-semibold text-slate-700 dark:text-slate-300" %>
          <%= link_to "Forgot password?", new_password_path, class: "text-xs font-semibold text-primary-600 dark:text-primary-400 hover:text-primary-500" %>
        </div>
        <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "••••••••", maxlength: 72,
              class: "w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-slate-900 dark:text-white transition-colors" %>
      </div>

      <%= form.submit "Sign In", class: "w-full py-3.5 px-4 rounded-xl bg-primary-600 hover:bg-primary-500 text-white font-bold shadow-md shadow-primary-500/20 cursor-pointer transition-all hover:scale-[1.01]" %>
    <% end %>

    <div class="mt-6 text-center text-sm text-slate-500 dark:text-slate-400">
      New to FamilyPlates? 
      <%= link_to "Start your kitchen free", new_registration_path, class: "font-semibold text-primary-600 dark:text-primary-400 hover:text-primary-500 underline" %>
    </div>
  </div>
</div>
