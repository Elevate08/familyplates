<div class="min-h-[75vh] flex flex-col items-center justify-center py-6 sm:py-12 px-4">
  <div class="max-w-md w-full bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-6 sm:p-8 shadow-xl text-center">
    <div class="relative w-20 h-20 rounded-3xl flex items-center justify-center shadow-lg mx-auto mb-4"
         style="background-color: <%= @member.avatar_color %>;">
      <span class="text-white text-3xl font-extrabold"><%= @member.initial %></span>
    </div>

    <h1 class="text-2xl font-extrabold text-slate-900 dark:text-white tracking-tight">
      Claim Profile: <%= @member.name %>
    </h1>
    <p class="text-sm text-slate-500 dark:text-slate-400 mt-2 mb-6">
      You have been invited to take ownership of this family profile in <strong class="text-slate-700 dark:text-slate-300"><%= @member.household.name %></strong>.
    </p>

    <%= button_to "Claim This Profile", claim_transfer_path(token: params[:token]), method: :post,
          class: "w-full py-3 rounded-xl bg-primary-600 hover:bg-primary-500 text-white font-bold text-sm shadow-md transition-all cursor-pointer" %>

    <div class="mt-4">
      <%= link_to "Cancel", select_profile_path, class: "text-xs text-slate-400 hover:text-slate-600 dark:hover:text-slate-200" %>
    </div>
  </div>
</div>
