#!/usr/bin/env bash
# Runs the Playwright suite. Arguments go straight to `playwright test`:
#
#   bin/e2e                              # everything, all three projects
#   bin/e2e e2e/flows --project=desktop-light
#   E2E_BROWSER=local bin/e2e            # no Docker; screenshots will not match
#
# By default the browser runs in the pinned Playwright container (see
# bin/e2e-browser-server), because that is what CI runs and what the screenshot
# baselines are recorded in. Set PLAYWRIGHT_WS_ENDPOINT to reuse a browser
# server you started yourself, which saves the container start on every run.
set -euo pipefail

cd "$(dirname "$0")/.."

if [ -n "${PLAYWRIGHT_WS_ENDPOINT:-}" ] || [ "${E2E_BROWSER:-container}" = "local" ]; then
  exec npx playwright test "$@"
fi

# Where Docker needs sudo (see bin/e2e-docker), ask for the password once, up
# front and in the foreground: the browser server starts in the background,
# where a prompt could not be answered. The loop keeps the credentials fresh
# for the length of the run, so stopping the container at the end does not
# prompt again.
if command -v omarchy-sudo-docker >/dev/null 2>&1 && omarchy-sudo-docker; then
  echo "bin/e2e: Docker needs sudo on this machine; only docker commands are elevated."
  sudo -v
  while sleep 60; do sudo -n true 2>/dev/null || exit; done &
  sudo_keepalive_pid=$!
  trap 'kill "$sudo_keepalive_pid" 2>/dev/null || true' EXIT
fi

if ! bin/e2e-docker info >/dev/null 2>&1; then
  echo "bin/e2e: cannot reach Docker, which runs the pinned browser the baselines" >&2
  echo "are recorded in. Start Docker, or run E2E_BROWSER=local bin/e2e to use a" >&2
  echo "local Chromium (flows are checked; screenshot diffs are not meaningful)." >&2
  exit 1
fi

port="${PLAYWRIGHT_SERVER_PORT:-3300}"
container="familyplates-e2e-browser-${port}"
server_log="log/e2e-browser-server.log"

bin/e2e-browser-server >"$server_log" 2>&1 &
server_pid=$!
trap 'bin/e2e-docker stop "$container" >/dev/null 2>&1 || true; wait "$server_pid" 2>/dev/null || true; [ -n "${sudo_keepalive_pid:-}" ] && kill "$sudo_keepalive_pid" 2>/dev/null || true' EXIT

# The first run pulls the image, which can take a few minutes on a cold cache.
echo "bin/e2e: waiting for the browser server on 127.0.0.1:${port}..."
for _ in $(seq 1 600); do
  if (exec 3<>"/dev/tcp/127.0.0.1/${port}") 2>/dev/null; then
    break
  fi
  if ! kill -0 "$server_pid" 2>/dev/null; then
    echo "bin/e2e: the browser server exited before it was ready:" >&2
    cat "$server_log" >&2
    exit 1
  fi
  sleep 1
done

PLAYWRIGHT_WS_ENDPOINT="ws://127.0.0.1:${port}/" npx playwright test "$@"
