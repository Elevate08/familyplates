#!/usr/bin/env ruby
# Kamal deploys the hosted edition only, so it reads saas/config/deploy.yml
# unless told otherwise with -c.
ARGV.push("-c", File.expand_path("../saas/config/deploy.yml", __dir__)) unless ARGV.intersect?(%w[-c --config-file]) || ARGV.any? { |a| a.start_with?("--config-file=") }

ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../Gemfile", __dir__)

require "rubygems"
require "bundler/setup"

load Gem.bin_path("kamal", "kamal")
