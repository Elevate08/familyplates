# FamilyPlates Local Environment Configuration Template
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and will never be committed or tracked.

# ==========================================
# Server Mode & Database Configuration
# ==========================================
# Options: "appliance" (default) or "hosted"
FAMILYPLATES_MODE=appliance
# DATABASE_PATH=storage/development.sqlite3
# PORT=3000
# HTTPS (production). Hosted mode forces HTTPS by default; appliance does not.
# FORCE_SSL=true
# Set when a TLS-terminating proxy does not send X-Forwarded-Proto.
# ASSUME_SSL=true

# ==========================================
# Outbound Email (SMTP) Configuration
# Required for hosted multi-tenant mode signups
# ==========================================
# SMTP_ADDRESS=smtp.example.com
# SMTP_PORT=587
# SMTP_USER_NAME=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# SMTP_AUTHENTICATION=plain
# SMTP_ENABLE_STARTTLS_AUTO=true
# MAILER_DEFAULT_FROM=noreply@example.com

# ==========================================
# Subscriptions & Billing (Stripe)
# Required for hosted multi-tenant billing & checkout
# ==========================================
# Webhook endpoint and the events it must receive: docs/hosted/stripe-billing.md
# Stripe API credentials (from Stripe Dashboard > Developers > API keys)
# STRIPE_PRIVATE_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SIGNING_SECRET=whsec_...
#
# Recurring Subscription Price IDs (from Stripe Dashboard > Product catalog)
# Monthly Plan: $4/month recurring
# STRIPE_MONTHLY_PRICE_ID=price_...
# Annual Plan: $35/year recurring
# STRIPE_ANNUAL_PRICE_ID=price_...

# ==========================================
# Automated Testing & Stripe Sandbox E2E
# ==========================================
# Set to "true" in .env.test.local (or .env.local) to run live Stripe Checkout
# redirects and test transactions in Playwright E2E suite (Level 2 tests).
# When unset or false, E2E tests run simulated offline billing (Level 1 tests).
# ENABLE_REAL_STRIPE_TESTS=false

# ==========================================
# Google OAuth 2.0 (Optional)
# Set to "true" after adding credentials in Google Cloud Console
# ==========================================
# AUTH_GOOGLE_ENABLED=true
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# ==========================================
# Apple ID Authentication (Optional)
# Requires Apple Developer Account ($99/yr) and HTTPS / verified domain
# ==========================================
# AUTH_APPLE_ENABLED=true
# APPLE_CLIENT_ID=com.example.familyplates.client
# APPLE_TEAM_ID=XXXXXXXXXX
# APPLE_KEY_ID=XXXXXXXXXX
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ==========================================
# Generic OpenID Connect (OIDC) (Optional)
# For Authentik, Keycloak, Authelia, Okta, etc.
# ==========================================
# AUTH_OIDC_ENABLED=true
# OIDC_ISSUER=https://auth.example.com/application/o/familyplates/
# OIDC_CLIENT_ID=your-oidc-client-id
# OIDC_CLIENT_SECRET=your-oidc-client-secret
# OIDC_DISPLAY_NAME="Home SSO"
